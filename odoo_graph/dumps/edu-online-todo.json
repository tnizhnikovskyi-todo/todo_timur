  "automations": [
    {
      "id": 1,
      "name": "КП надіслано → перетелефонувати через 2 дні",
      "model": "crm.lead",
      "trigger": "on_stage_set",
      "active": true,
      "filter_domain": "[('stage_id', '=', 3)]"
    },
    {
      "id": 2,
      "name": "Знижка понад 10 % — віза керівника",
      "model": "sale.order",
      "trigger": "on_create_or_write",
      "active": true,
      "filter_domain": "[('order_line.discount','>',10),('order_line.discount','<=',25),('state','in',('draft','sent')),('x_discount_visa','=',False)]"
    },
    {
      "id": 3,
      "name": "Знижка понад 25 % — віза директора",
      "model": "sale.order",
      "trigger": "on_create_or_write",
      "active": true,
      "filter_domain": "[('order_line.discount','>',25),('state','in',('draft','sent')),('x_discount_visa','=',False)]"
    },
    {
      "id": 4,
      "name": "Віза керівника — знижка узгоджена",
      "model": "sale.order",
      "trigger": "on_create_or_write",
      "active": true,
      "filter_domain": "[('x_discount_visa','=',True)]"
    },
    {
      "id": 5,
      "name": "Закупка понад 20 000 — чекає керівника",
      "model": "purchase.order",
      "trigger": "on_create_or_write",
      "active": true,
      "filter_domain": "[('amount_total','>',20000),('amount_total','<=',100000),('state','in',('draft','sent')),('x_visa_head','=',False)]"
    },
    {
      "id": 6,
      "name": "Закупка: віза керівника — узгоджено",
      "model": "purchase.order",
      "trigger": "on_create_or_write",
      "active": true,
      "filter_domain": "[('x_visa_head','=',True)]"
    },
    {
      "id": 7,
      "name": "Витрата понад ліміт категорії «Пальне й проїзд» (800)",
      "model": "hr.expense",
      "trigger": "on_create_or_write",
      "active": true,
      "filter_domain": "[('product_id','=',32),('total_amount','>',800)]"
    },
    {
      "id": 8,
      "name": "Заявка понад 5 000 — потрібна віза директора",
      "model": "approval.request",
      "trigger": "on_create_or_write",
      "active": true,
      "filter_domain": "[('amount','>',5000)]"
    }
  ],
