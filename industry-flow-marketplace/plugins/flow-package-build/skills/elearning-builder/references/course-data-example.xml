<?xml version="1.0" encoding="utf-8"?>
<!-- ПРИКЛАД-ЧЕРНЕТКА. Імена моделей/полів (slide.channel, slide.slide, slide.question, slide.answer,
     channel_id, slide_id, question_id, is_correct, text_value) НЕ підтверджено: звірити у вихідниках 19.0
     (addons/website_slides/models/*.py, файл:рядок у README модуля) перед використанням. -->
<odoo>
  <data noupdate="1">
    <record id="param_pass_score" model="ir.config_parameter">
      <field name="key">td_mebli_elearning.pass_score</field>
      <field name="value">80</field>
    </record>
    <record id="param_mode" model="ir.config_parameter">
      <field name="key">td_mebli_elearning.mode</field>
      <field name="value">on</field>
    </record>

    <record id="course_komirnyk" model="slide.channel">
      <!-- role: komirnyk -->
      <field name="name">Курс: Комірник</field>
    </record>
    <record id="lesson_komirnyk_1" model="slide.slide">
      <!-- source: komirnyk.md#SC-01 -->
      <field name="name">Прийняти плиту на склад</field>
      <field name="channel_id" ref="course_komirnyk"/>
    </record>
    <record id="test_komirnyk" model="slide.slide">
      <field name="name">Тест: Комірник</field>
      <field name="channel_id" ref="course_komirnyk"/>
    </record>
    <record id="q_komirnyk_1" model="slide.question">
      <field name="question">Де підтвердити приймання плити?</field>
      <field name="slide_id" ref="test_komirnyk"/>
    </record>
    <record id="a_komirnyk_1_1" model="slide.answer">
      <field name="text_value">Кнопка «Підтвердити» на формі приймання</field>
      <field name="question_id" ref="q_komirnyk_1"/>
      <field name="is_correct" eval="True"/>
    </record>
    <record id="a_komirnyk_1_2" model="slide.answer">
      <field name="text_value">У списку замовлень</field>
      <field name="question_id" ref="q_komirnyk_1"/>
      <field name="is_correct" eval="False"/>
    </record>
    <!-- ... ще >=4 питання на курс; по одному правильному варіанту -->
  </data>
</odoo>
