{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "params http_push (SPEC A.2)",
  "type": "object",
  "propertyNames": {"pattern": "^[^_]"},
  "properties": {
    "routes": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$"}
    },
    "allow_ips": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "token_ref": {"type": "string", "pattern": "^F3D_[A-Z0-9_]{1,60}$"},
    "secret_ref": {"type": "string", "pattern": "^F3D_[A-Z0-9_]{1,60}$"},
    "max_body_kb": {"type": "integer", "minimum": 1, "maximum": 1024}
  },
  "required": ["routes"]
}
