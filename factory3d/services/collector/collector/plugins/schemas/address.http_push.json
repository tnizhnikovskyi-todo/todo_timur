{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "address http_push (SPEC A.1)",
  "type": "object",
  "propertyNames": {"pattern": "^[^_]"},
  "properties": {
    "route": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$"},
    "path": {"type": "string", "pattern": "^\\$(\\.[A-Za-z_][A-Za-z0-9_\\-]*|\\[[0-9]+\\])+$"},
    "match": {
      "type": "object",
      "additionalProperties": {"type": ["string", "number", "boolean"]}
    },
    "ts_path": {"type": "string", "pattern": "^\\$(\\.[A-Za-z_][A-Za-z0-9_\\-]*|\\[[0-9]+\\])+$"},
    "scale": {"type": "number", "not": {"const": 0}},
    "offset": {"type": "number"}
  },
  "required": ["route", "path"]
}
