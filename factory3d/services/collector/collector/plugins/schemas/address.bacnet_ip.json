               "positive-integer-value", "device",
               "AI", "AO", "AV", "BI", "BO", "BV", "MSI", "MSV", "LSZ", "LSP", "PIV"]
    },
    "instance": {"type": "integer", "minimum": 0, "maximum": 4194302},
