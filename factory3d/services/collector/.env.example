F3D_ODOO_URL=http://odoo:8069
F3D_COLLECTOR_CODE=COL-1
# токен показується один раз у Odoo: Телеметрія > Колектори > Згенерувати токен
F3D_COLLECTOR_TOKEN=
F3D_ALLOW_HOSTS=iot-sim,mosquitto
F3D_BUFFER_DIR=/app/state
F3D_BUFFER_MAX_MB=200
F3D_WRITE_ENABLED=0
F3D_HTTP_PUSH_PORT=8080
F3D_METRICS_PORT=9108
F3D_BACNET_BIND=0.0.0.0:47808
F3D_CLOCK_SKEW_WARN_S=5
# секрети плагінів (посилання password_ref у params джерела)
F3D_MQTT_PASSWORD=
# запасні значення; конфіг колектора в Odoo (push_interval_s, push_max) має пріоритет
F3D_PUSH_INTERVAL_S=5
F3D_PUSH_MAX=1000
# черга відправки старша за це (с) -> спершу найновіші показання
F3D_PUSH_STALE_S=600
