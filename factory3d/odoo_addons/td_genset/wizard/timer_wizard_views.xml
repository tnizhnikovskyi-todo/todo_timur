<?xml version="1.0" encoding="utf-8"?>
<!-- Власник: W2. Майстер «Робота поза графіком» (ТР 2.3.13, SPEC 5.14). XML id дії (зберегти!):
     action_td_genset_timer_wizard. -->
<odoo>
    <record id="view_td_genset_timer_wizard_form" model="ir.ui.view">
        <field name="name">td.genset.timer.wizard.form</field>
        <field name="model">td.genset.timer.wizard</field>
        <field name="arch" type="xml">
            <form string="Робота поза графіком">
                <group>
                    <field name="genset_id" readonly="1"/>
                    <label for="hours" string="Тривалість"/>
                    <div class="o_row">
                        <field name="hours" class="oe_inline" nolabel="1"/>
                        <span>год</span>
                        <field name="minutes" class="oe_inline" nolabel="1"/>
                        <span>хв</span>
                    </div>
                </group>
                <div class="alert alert-info" role="status">
                    <field name="confirm_text" nolabel="1"/>
                </div>
                <p class="text-muted">
                    Від 1 хв до 24 год. Таймер один на генератор: подовжити (+15 / +30 / +60 хв) або зупинити може будь-хто.
                </p>
                <footer>
                    <button name="action_confirm" type="object" string="Застосувати" class="btn-primary"
                            data-hotkey="q"/>
                    <button string="Скасувати" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_td_genset_timer_wizard" model="ir.actions.act_window">
        <field name="name">Робота поза графіком</field>
        <field name="res_model">td.genset.timer.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
