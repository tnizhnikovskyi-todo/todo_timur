<?xml version="1.0" encoding="utf-8"?>
<!-- Власник: W0. Групи доступу (ТР 2.2, А.10; SPEC 7). Record rules немає (рішення 1.3). -->
<odoo>
    <record id="module_category_td_genset" model="ir.module.category">
        <field name="name">Генератори</field>
        <field name="description">Моніторинг і керування генераторами SmartGen.</field>
        <field name="sequence">60</field>
    </record>

    <!-- Odoo 19 (MG-08): res.groups не має category_id — прив'язка до категорії через res.groups.privilege -->
    <record id="res_groups_privilege_td_genset" model="res.groups.privilege">
        <field name="name">Генератори</field>
        <field name="description">Моніторинг і керування генераторами SmartGen.</field>
        <field name="sequence">60</field>
        <field name="category_id" ref="module_category_td_genset"/>
    </record>

    <record id="group_user" model="res.groups">
        <field name="name">Генератори: Співробітник</field>
        <field name="privilege_id" ref="res_groups_privilege_td_genset"/>
        <!-- base.group_allow_export: експорт «Показань»/«Подій» для Співробітника (ФВ-41, AC-59; рішення менеджера) -->
        <field name="implied_ids" eval="[Command.link(ref('base.group_user')), Command.link(ref('base.group_allow_export'))]"/>
        <field name="comment">Бачить усе, запускає таймер «Робота поза графіком», приймає тривоги, якщо в ланцюжку.</field>
    </record>

    <record id="group_admin" model="res.groups">
        <field name="name">Генератори: Адміністратор</field>
        <field name="privilege_id" ref="res_groups_privilege_td_genset"/>
        <field name="implied_ids" eval="[Command.link(ref('group_user'))]"/>
        <field name="comment">Співробітник + розклад, дні-винятки, паливо.</field>
    </record>

    <record id="group_tech" model="res.groups">
        <field name="name">Генератори: Тех. адміністратор</field>
        <field name="privilege_id" ref="res_groups_privilege_td_genset"/>
        <field name="implied_ids" eval="[Command.link(ref('group_admin')), Command.link(ref('maintenance.group_equipment_manager'))]"/>
        <field name="user_ids" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
        <field name="comment">Адміністратор + пульт, автомати, ТО, налаштування модуля, генератори.</field>
    </record>
</odoo>
