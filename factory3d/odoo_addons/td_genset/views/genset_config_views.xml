<?xml version="1.0" encoding="utf-8"?>
<!-- Власник: W3. «Налаштування» модуля (ТР 2.3.8, 2.10; мокап «Налаштування»): секції Пульт, Зв'язок, Журнал,
     Сповіщення і ланцюжок, Паливо, ТО; не тех. адміністратор — лише перегляд з банером (AC-55). Ланцюжок ескалації,
     моделі контролерів. XML id дій (контракт): action_td_genset_config, action_td_genset_notify_level,
     action_td_genset_controller_model. -->
<odoo>
    <record id="view_td_genset_config_form" model="ir.ui.view">
        <field name="name">td.genset.config.form</field>
        <field name="model">td.genset.config</field>
        <field name="arch" type="xml">
            <form string="Налаштування генераторів" create="0" delete="0" duplicate="0" class="o_td_genset_config">
                <sheet>
                    <field name="is_tech" invisible="1"/>
                    <div class="alert alert-info" role="status" invisible="is_tech">
                        <i class="fa fa-eye me-1" title="Перегляд"/>
                        Лише перегляд: налаштування змінює тех. адміністратор.
                    </div>
                    <div class="oe_title">
                        <h1>Налаштування генераторів</h1>
                        <div class="text-muted">
                            Спільні для всіх генераторів. Адреса і токен ретранслятора — у стандартних
                            Налаштуваннях Odoo → «Генератори» (лише системний адміністратор).
                        </div>
                    </div>

                    <group string="Пульт" name="pult">
                        <group>
                            <label for="retry_every_min" string="Повтор непідтвердженої команди"/>
                            <div class="o_row">
                                <span>кожні</span>
                                <field name="retry_every_min" readonly="not is_tech" class="oe_inline"/>
                                <span>хв, протягом</span>
                                <field name="retry_window_min" readonly="not is_tech" class="oe_inline"/>
                                <span>хв</span>
                            </div>
                            <field name="test_minutes" readonly="not is_tech"/>
                        </group>
                        <group>
                            <field name="missed_transition_policy" readonly="not is_tech"/>
                            <field name="late_retry_every_min" readonly="not is_tech"
                                   invisible="missed_transition_policy != 'until_next'"/>
                        </group>
                    </group>

                    <group string="Зв'язок" name="link">
                        <group>
                            <field name="link_lost_min" readonly="not is_tech"/>
                            <field name="link_alarm_min" readonly="not is_tech"/>
                            <field name="relay_unavailable_alarm_min" readonly="not is_tech"/>
                        </group>
                        <group>
                            <field name="raw_regs_mode" readonly="not is_tech" widget="radio"/>
                            <div colspan="2" class="text-muted small">
                                Оми датчиків (рівень палива, температура, тиск) ретранслятор 1.1.1 віддає лише в
                                сирому образі регістрів (raw=1); з 1.1.3 — окремими ключами знімка.
                            </div>
                        </group>
                    </group>

                    <group string="Журнал показань" name="journal">
                        <group>
                            <field name="journal_interval_min" readonly="not is_tech"/>
                            <field name="reading_retention_days" readonly="not is_tech"/>
                        </group>
                        <group>
                            <field name="catchup_summary" readonly="not is_tech" widget="boolean_toggle"/>
                        </group>
                    </group>

                    <group string="Сповіщення" name="notify">
                        <group>
                            <field name="notify_crit" readonly="not is_tech"/>
                            <field name="notify_warn" readonly="not is_tech"/>
                            <field name="notify_info" readonly="not is_tech"/>
                        </group>
                        <group>
                            <label for="quiet_enabled"/>
                            <div class="o_row">
                                <field name="quiet_enabled" widget="boolean_toggle" readonly="not is_tech"
                                       class="oe_inline"/>
                                <field name="quiet_from" widget="float_time" readonly="not is_tech" class="oe_inline"
                                       invisible="not quiet_enabled"/>
                                <span invisible="not quiet_enabled">–</span>
                                <field name="quiet_to" widget="float_time" readonly="not is_tech" class="oe_inline"
                                       invisible="not quiet_enabled"/>
                            </div>
                            <field name="discuss_channel_id" readonly="not is_tech"/>
                            <button name="action_send_test_notification" type="object" icon="fa-paper-plane"
                                    string="Надіслати тестове сповіщення" class="btn-secondary" colspan="2"
                                    groups="td_genset.group_tech"/>
                        </group>
                    </group>
                    <div class="fw-bold mb-1">Ланцюжок ескалації</div>
                    <div class="text-muted small mb-1">
                        Хто і в якому порядку отримує тривоги; рівень 1 — одразу, далі — якщо тривогу досі не прийняли.
                    </div>
                    <field name="level_ids" readonly="not is_tech" nolabel="1">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="user_id" options="{'no_create': True}"/>
                            <field name="delay_min"/>
                        </list>
                    </field>

                    <group string="Паливо" name="fuel">
                        <group>
                            <field name="fuel_min_stock_l" readonly="not is_tech"/>
                            <field name="canister_volume_default_l" readonly="not is_tech"/>
                            <field name="fuel_price_default" readonly="not is_tech"/>
                            <field name="fuel_partner_id" readonly="not is_tech"/>
                        </group>
                        <group>
                            <field name="refuel_threshold_l" readonly="not is_tech"/>
                            <field name="drain_threshold_l" readonly="not is_tech"/>
                            <field name="drain_window_min" readonly="not is_tech"/>
                            <field name="low_fuel_pct" readonly="not is_tech"/>
                            <field name="crank_battery_warn_v" readonly="not is_tech"/>
                            <div colspan="2" class="text-muted small">
                                Місця зберігання каністр — меню «Налаштування → Місця зберігання».
                            </div>
                        </group>
                    </group>

                    <group string="ТО" name="maintenance">
                        <group>
                            <field name="maint_first_hours_default" readonly="not is_tech"/>
                            <field name="maint_interval_hours_default" readonly="not is_tech"/>
                            <field name="maint_interval_months_default" readonly="not is_tech"/>
                        </group>
                        <group>
                            <field name="maint_team_id" readonly="not is_tech"/>
                        </group>
                    </group>
                    <div class="fw-bold mb-1">Перелік робіт ТО</div>
                    <field name="maint_checklist" readonly="not is_tech" nolabel="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_td_genset_config" model="ir.actions.act_window">
        <field name="name">Налаштування</field>
        <field name="res_model">td.genset.config</field>
        <field name="view_mode">form</field>
        <field name="res_id" ref="config_main"/>
        <field name="view_id" ref="view_td_genset_config_form"/>
    </record>

    <record id="view_td_genset_notify_level_list" model="ir.ui.view">
        <field name="name">td.genset.notify.level.list</field>
        <field name="model">td.genset.notify.level</field>
        <field name="arch" type="xml">
            <list string="Ланцюжок ескалації" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name" string="Рівень"/>
                <field name="user_id" string="Хто" options="{'no_create': True}"/>
                <field name="delay_min" string="Коли, хв"/>
                <field name="config_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_td_genset_notify_level_form" model="ir.ui.view">
        <field name="name">td.genset.notify.level.form</field>
        <field name="model">td.genset.notify.level</field>
        <field name="arch" type="xml">
            <form string="Рівень ескалації">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="user_id" options="{'no_create': True}"/>
                        <field name="delay_min"/>
                        <field name="sequence"/>
                        <field name="config_id" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_td_genset_notify_level_search" model="ir.ui.view">
        <field name="name">td.genset.notify.level.search</field>
        <field name="model">td.genset.notify.level</field>
        <field name="arch" type="xml">
            <search string="Ланцюжок ескалації">
                <field name="name"/>
                <field name="user_id"/>
            </search>
        </field>
    </record>

    <record id="action_td_genset_notify_level" model="ir.actions.act_window">
        <field name="name">Ланцюжок ескалації</field>
        <field name="res_model">td.genset.notify.level</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Ланцюжок ескалації порожній</p>
            <p>Додайте рівні: «Черговий» (одразу), «Відповідальний за об'єкт», «Керівник» — тривоги йдуть за
                порядком, поки їх не приймуть.</p>
        </field>
    </record>

    <record id="view_td_genset_controller_model_list" model="ir.ui.view">
        <field name="name">td.genset.controller.model.list</field>
        <field name="model">td.genset.controller.model</field>
        <field name="arch" type="xml">
            <list string="Моделі контролерів">
                <field name="name"/>
                <field name="code"/>
                <field name="has_mains_breaker"/>
            </list>
        </field>
    </record>

    <record id="view_td_genset_controller_model_form" model="ir.ui.view">
        <field name="name">td.genset.controller.model.form</field>
        <field name="model">td.genset.controller.model</field>
        <field name="arch" type="xml">
            <form string="Модель контролера">
                <sheet>
                    <widget name="web_ribbon" title="Архів" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="has_mains_breaker"/>
                        <field name="active" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_td_genset_controller_model_search" model="ir.ui.view">
        <field name="name">td.genset.controller.model.search</field>
        <field name="model">td.genset.controller.model</field>
        <field name="arch" type="xml">
            <search string="Моделі контролерів">
                <field name="name"/>
                <field name="code"/>
                <filter name="archived" string="Архів" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_td_genset_controller_model" model="ir.actions.act_window">
        <field name="name">Моделі контролерів</field>
        <field name="res_model">td.genset.controller.model</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
