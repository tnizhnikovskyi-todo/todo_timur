<?xml version="1.0" encoding="utf-8"?>
<!-- Власник: W0. Меню застосунку «Генератори» (ТР 2.10; SPEC 10; мокап): Генератор · Показання · Аналітика ·
     Події · Заправка · Налаштування. Тривоги і журнал команд — smart-кнопки картки; адреса/токен — стандартні
     Налаштування → Генератори. Потоки додають пункти ЛИШЕ рядками в кінець файлу (перед </odoo>), наявні рядки
     не змінюють. Дії визначені у views/*.xml (їхні XML id — контракт). -->
<odoo>
    <!-- «Генератор»: за одного генератора відкривається його форма, інакше — список (td.genset.action_open_main) -->
    <record id="action_td_genset_main" model="ir.actions.server">
        <field name="name">Генератор</field>
        <field name="model_id" ref="model_td_genset"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_main()</field>
        <field name="groups_id" eval="[(4, ref('group_user'))]"/>
    </record>

    <menuitem id="menu_root" name="Генератори" sequence="45"
              web_icon="td_genset,static/description/icon.png" groups="group_user"/>

    <menuitem id="menu_genset" name="Генератор" parent="menu_root" sequence="10" action="action_td_genset_main"/>
    <menuitem id="menu_reading" name="Показання" parent="menu_root" sequence="20" action="action_td_genset_reading"/>
    <menuitem id="menu_analytics" name="Аналітика" parent="menu_root" sequence="30"/>
    <menuitem id="menu_analytics_run_outage" name="Робота і відключення по днях" parent="menu_analytics" sequence="10"
              action="action_td_genset_analytics_run_outage"/>
    <menuitem id="menu_event" name="Події" parent="menu_root" sequence="40" action="action_td_genset_event"/>
    <menuitem id="menu_fuel" name="Заправка" parent="menu_root" sequence="50"/>
    <menuitem id="menu_fuel_canister" name="Каністри" parent="menu_fuel" sequence="10" action="action_td_genset_canister"/>
    <menuitem id="menu_fuel_refuel" name="Заправки" parent="menu_fuel" sequence="20" action="action_td_genset_refuel"/>
    <menuitem id="menu_fuel_move" name="Рух запасу" parent="menu_fuel" sequence="30" action="action_td_genset_fuel_move"/>

    <menuitem id="menu_config" name="Налаштування" parent="menu_root" sequence="90"/>
    <menuitem id="menu_config_settings" name="Налаштування" parent="menu_config" sequence="10"
              action="action_td_genset_config"/>
    <menuitem id="menu_config_gensets" name="Генератори" parent="menu_config" sequence="20" action="action_td_genset"/>
    <menuitem id="menu_config_levels" name="Ланцюжок ескалації" parent="menu_config" sequence="30"
              action="action_td_genset_notify_level"/>
    <menuitem id="menu_config_locations" name="Місця зберігання" parent="menu_config" sequence="40"
              action="action_td_genset_storage_location"/>
    <menuitem id="menu_config_controllers" name="Моделі контролерів" parent="menu_config" sequence="50"
              action="action_td_genset_controller_model" groups="group_tech"/>
    <menuitem id="menu_config_users" name="Ролі доступу" parent="menu_config" sequence="70"
              action="base.action_res_users" groups="base.group_erp_manager"/>

    <!-- ↓ Рядки потоків W1–W5 — нижче цієї позначки -->
    <!-- W3: «Аналітика» (ТР 2.10) — дії з views/analytics_actions.xml -->
    <menuitem id="menu_analytics_energy" name="Вироблено по днях" parent="menu_analytics" sequence="20"
              action="action_td_genset_analytics_energy"/>
    <menuitem id="menu_analytics_cranks" name="Пуски і АКБ при прокрутці" parent="menu_analytics" sequence="30"
              action="action_td_genset_analytics_cranks"/>
    <menuitem id="menu_analytics_fuel_used" name="Витрата по днях" parent="menu_analytics" sequence="40"
              action="action_td_genset_analytics_fuel_used"/>
    <menuitem id="menu_analytics_fuel_level" name="Рівень палива" parent="menu_analytics" sequence="50"
              action="action_td_genset_analytics_fuel_level"/>
    <menuitem id="menu_analytics_battery" name="Напруга АКБ" parent="menu_analytics" sequence="60"
              action="action_td_genset_analytics_battery"/>
    <menuitem id="menu_analytics_load" name="Навантаження під час роботи" parent="menu_analytics" sequence="70"
              action="action_td_genset_analytics_last_run"/>
</odoo>
