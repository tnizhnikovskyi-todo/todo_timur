<?xml version="1.0" encoding="utf-8"?>
<!-- Власник: W0 (дані), логіка ТО — W4. Категорія обладнання і команда ТО (ТР 2.3.12, 2.9; SPEC 6).
     Без компанії (company_id = False) — спільні для всіх компаній бази (на проді їх 5; рішення 1.3 «усі бачать
     усе»): обладнання і заявки ТО створюються в компанії генератора, а команда «Генератори» сумісна з будь-якою
     (check_company maintenance.request.maintenance_team_id). -->
<odoo>
    <data noupdate="1">
        <record id="equipment_category_genset" model="maintenance.equipment.category">
            <field name="name">Генератори</field>
            <field name="technician_user_id" eval="False"/>
            <field name="company_id" eval="False"/>
        </record>
        <record id="maintenance_team_genset" model="maintenance.team">
            <field name="name">Генератори</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
