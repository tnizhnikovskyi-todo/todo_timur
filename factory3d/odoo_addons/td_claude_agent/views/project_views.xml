<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="edit_project_td_claude" model="ir.ui.view">
        <field name="name">project.project.form.td.claude</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="td_claude" string="Claude">
                    <div class="mb-2" invisible="not id">
                        <button name="action_td_claude_project_wizard" type="object" class="btn-secondary"
                                string="Інструкція для проєкту Claude" icon="fa-clipboard"/>
                    </div>
                    <group>
                        <group>
                            <field name="td_claude_repo" placeholder="owner/repo"/>
                            <field name="td_claude_branch" placeholder="main"/>
                        </group>
                        <group>
                            <field name="td_claude_project_url" widget="url" placeholder="https://claude.ai/project/..."/>
                            <field name="td_claude_skill_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <field name="td_claude_context" placeholder="Контекст проєкту для Claude: цілі, правила, терміни..."/>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_task_form2_td_claude" model="ir.ui.view">
        <field name="name">project.task.form.td.claude</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_td_open_claude_session" type="object" class="oe_stat_button"
                        icon="fa-external-link" invisible="not td_claude_session_url">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Claude-сесія</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="after">
                <div class="mb-2">
                    <field name="td_claude_paused"/>
                    <label for="td_claude_paused" string="Пауза Claude" class="me-3"/>
                    <label for="td_claude_hops_today" string="Запусків за добу:" class="me-1"/>
                    <field name="td_claude_hops_today" readonly="1" class="d-inline"/>
                </div>
                <div class="mb-2" invisible="not td_claude_session_url">
                    <label for="td_claude_session_url" string="Claude-сесія" class="me-2"/>
                    <field name="td_claude_session_url" widget="url" readonly="1" class="d-inline"/>
                </div>
            </xpath>
        </field>
    </record>

    <record id="task_type_edit_td_claude" model="ir.ui.view">
        <field name="name">project.task.type.form.td.claude</field>
        <field name="model">project.task.type</field>
        <field name="inherit_id" ref="project.task_type_edit"/>
        <field name="arch" type="xml">
            <field name="mail_template_id" position="after">
                <field name="td_claude_role_id" options="{'no_create': True}" invisible="user_id"/>
            </field>
        </field>
    </record>
</odoo>
