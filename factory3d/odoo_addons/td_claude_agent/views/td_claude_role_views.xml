<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_td_claude_role_list" model="ir.ui.view">
        <field name="name">td.claude.role.list</field>
        <field name="model">td.claude.role</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="model_hint"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_td_claude_role_form" model="ir.ui.view">
        <field name="name">td.claude.role.form</field>
        <field name="model">td.claude.role</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Архів" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="active" invisible="1"/>
                            <field name="name"/>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="model_hint"/>
                            <field name="group_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <separator string="Інструкція ролі (базовий промпт, Markdown)"/>
                    <field name="instructions" class="font-monospace" nolabel="1" widget="text"
                           placeholder="# Роль: ..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_td_claude_role" model="ir.actions.act_window">
        <field name="name">Ролі Claude</field>
        <field name="res_model">td.claude.role</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
