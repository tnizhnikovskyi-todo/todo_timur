<?xml version="1.0" encoding="utf-8"?>
<!-- SPEC §3 V-10 -->
<odoo>
    <record id="view_f3d_energy_pool_list" model="ir.ui.view">
        <field name="name">f3d.energy.pool.list</field>
        <field name="model">f3d.energy.pool</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="driver"/>
                <field name="kwh_today"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_f3d_energy_pool_form" model="ir.ui.view">
        <field name="name">f3d.energy.pool.form</field>
        <field name="model">f3d.energy.pool</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="driver"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="workcenter_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <field name="node_ids" readonly="1">
                        <list>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="p_now"/>
                        </list>
                    </field>
                    <field name="note" placeholder="Примітка"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_f3d_energy_pool" model="ir.actions.act_window">
        <field name="name">Пули спільних споживачів</field>
        <field name="res_model">f3d.energy.pool</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
