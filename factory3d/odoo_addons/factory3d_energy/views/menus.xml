<!-- SPEC §3 V-21. Пункти з діями додають воркери разом із видами (sequence — з таблиці SPEC §3):
     W1: menu_f3d_energy_scheme (20), menu_f3d_energy_meter (30), menu_f3d_energy_pool (20, під config);
     W2: menu_f3d_energy_profile (40), menu_f3d_energy_balance (60), menu_f3d_energy_event (80), menu_f3d_energy_tariff (10, під config);
     W3: menu_f3d_energy_alloc (50);
     W4: menu_f3d_energy_outage (70); W5: menu_f3d_energy_overview (10), menu_f3d_energy_recompute (30, під config),
     menu_f3d_energy_settings (50, під factory3d_base.menu_f3d_config, group_f3d_admin). -->
<odoo>
