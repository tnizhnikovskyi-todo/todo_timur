<?xml version="1.0" encoding="utf-8"?>
<!-- V-B1: вкладка «Енергетика» у формі агрегата КГУ -->
<odoo>
    <record id="view_td_chp_unit_form_bridge" model="ir.ui.view">
        <field name="name">td.chp.unit.form.bridge</field>
        <field name="model">td.chp.unit</field>
        <field name="inherit_id" ref="td_chp.view_td_chp_unit_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Енергетика" name="energy" groups="td_energy.group_td_energy_user">
                    <group>
                        <group string="Вузли однолінійної схеми">
                            <field name="energy_node_id"/>
                            <field name="energy_node_state"/>
                            <field name="energy_qf_node_id"/>
                            <field name="energy_qf_state"/>
                            <field name="energy_p_kw"/>
                        </group>
                    </group>
                    <button name="action_open_energy_node" type="object" class="btn-secondary"
                            string="Відкрити вузол в Енергетиці" invisible="not energy_node_id"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
