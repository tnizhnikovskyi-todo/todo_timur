<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- V-05 -->
    <record id="view_stock_location_form_td" model="ir.ui.view">
        <field name="name">stock.location.form.f3d</field>
        <field name="model">stock.location</field>
        <field name="inherit_id" ref="stock.view_location_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_f3d_show" type="object" class="oe_stat_button" icon="fa-cube"
                        string="Показати в 3D" invisible="not td_code"/>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <notebook>
                    <page name="f3d" string="3D Завод">
                        <field name="td_is_manager" invisible="1"/>
                        <field name="td_viewer_available" invisible="1"/>
                        <group>
                            <group name="f3d_scene" string="Код сцени">
                                <field name="td_code" readonly="not td_is_manager"/>
                                <field name="td_alias" readonly="not td_is_manager"/>
                                <field name="td_kind" readonly="not td_is_manager"/>
                                <field name="td_zone_id"/>
                                <field name="td_loc_kind"/>
                                <field name="td_capacity"/>
                            </group>
                            <group name="f3d_dock" string="Ворота" invisible="td_kind != 'dock'">
                                <field name="td_side"/>
                                <field name="td_dock_no"/>
                                <field name="td_accepts" widget="many2many_tags"/>
                                <field name="td_x"/>
                                <field name="td_y"/>
                                <field name="td_dock_width_m"/>
                                <field name="td_dock_height_m"/>
                                <field name="td_dock_picking_type_ids" widget="many2many_tags" readonly="1"/>
                                <button name="f3d_register_dock" type="object" class="btn-secondary"
                                        string="Зареєструвати як док"
                                        groups="td_factory3d.group_td_manager"/>
                            </group>
                        </group>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>

    <!-- V-06 -->
    <record id="view_stock_location_list_td" model="ir.ui.view">
        <field name="name">stock.location.list.f3d</field>
        <field name="model">stock.location</field>
        <field name="inherit_id" ref="stock.view_location_tree2"/>
        <field name="arch" type="xml">
            <field name="usage" position="after">
                <field name="td_code" optional="show"/>
                <field name="td_kind" optional="hide"/>
                <field name="td_loc_kind" optional="hide"/>
                <field name="td_capacity" optional="hide"/>
                <field name="td_zone_id" optional="hide"/>
            </field>
        </field>
    </record>

    <!-- V-07 -->
    <record id="view_stock_location_search_td" model="ir.ui.view">
        <field name="name">stock.location.search.f3d</field>
        <field name="model">stock.location</field>
        <field name="inherit_id" ref="stock.view_location_search"/>
        <field name="arch" type="xml">
            <field name="complete_name" position="after">
                <field name="td_code"/>
            </field>
            <filter name="inactive" position="before">
                <filter name="f3d_dock" string="Ворота" domain="[('td_kind', '=', 'dock')]"/>
                <filter name="f3d_with_code" string="З кодом сцени" domain="[('td_code', '!=', False)]"/>
                <filter name="f3d_no_code" string="Без коду" domain="[('td_code', '=', False)]"/>
                <separator/>
            </filter>
            <filter name="usage" position="after">
                <filter name="group_td_zone" string="Зона" domain="[]" context="{'group_by': 'td_zone_id'}"/>
            </filter>
        </field>
    </record>

    <!-- V-17: дія воріт (пункт меню — у td_menus.xml) -->
    <record id="action_td_dock" model="ir.actions.act_window">
        <field name="name">Ворота</field>
        <field name="res_model">stock.location</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('td_kind', '=', 'dock')]</field>
        <field name="context">{'default_td_kind': 'dock', 'default_usage': 'internal'}</field>
    </record>
</odoo>
