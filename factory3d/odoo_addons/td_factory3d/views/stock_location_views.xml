<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- V-05 -->
    <record id="view_stock_location_form_f3d" model="ir.ui.view">
        <field name="name">stock.location.form.f3d</field>
        <field name="model">stock.location</field>
        <field name="inherit_id" ref="stock.view_location_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_f3d_show" type="object" class="oe_stat_button" icon="fa-cube"
                        string="Показати в 3D" invisible="not f3d_code"/>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <notebook>
                    <page name="f3d" string="Завод 3D">
                        <field name="is_f3d_manager" invisible="1"/>
                        <field name="f3d_viewer_available" invisible="1"/>
                        <group>
                            <group name="f3d_scene" string="Код сцени">
                                <field name="f3d_code" readonly="not is_f3d_manager"/>
                                <field name="f3d_alias" readonly="not is_f3d_manager"/>
                                <field name="f3d_kind" readonly="not is_f3d_manager"/>
                                <field name="f3d_zone_id"/>
                                <field name="f3d_loc_kind"/>
                                <field name="f3d_capacity"/>
                            </group>
                            <group name="f3d_dock" string="Ворота" invisible="f3d_kind != 'dock'">
                                <field name="f3d_side"/>
                                <field name="f3d_dock_no"/>
                                <field name="f3d_accepts" widget="many2many_tags"/>
                                <field name="f3d_x"/>
                                <field name="f3d_y"/>
                                <field name="f3d_dock_width_m"/>
                                <field name="f3d_dock_height_m"/>
                                <field name="f3d_dock_picking_type_ids" widget="many2many_tags" readonly="1"/>
                                <button name="f3d_register_dock" type="object" class="btn-secondary"
                                        string="Зареєструвати як док"
                                        groups="factory3d_base.group_f3d_manager"/>
                            </group>
                        </group>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>

    <!-- V-06 -->
    <record id="view_stock_location_list_f3d" model="ir.ui.view">
        <field name="name">stock.location.list.f3d</field>
        <field name="model">stock.location</field>
        <field name="inherit_id" ref="stock.view_location_tree2"/>
        <field name="arch" type="xml">
            <field name="usage" position="after">
                <field name="f3d_code" optional="show"/>
                <field name="f3d_kind" optional="hide"/>
                <field name="f3d_loc_kind" optional="hide"/>
                <field name="f3d_capacity" optional="hide"/>
                <field name="f3d_zone_id" optional="hide"/>
            </field>
        </field>
    </record>

    <!-- V-07 -->
    <record id="view_stock_location_search_f3d" model="ir.ui.view">
        <field name="name">stock.location.search.f3d</field>
        <field name="model">stock.location</field>
        <field name="inherit_id" ref="stock.view_location_search"/>
        <field name="arch" type="xml">
            <field name="complete_name" position="after">
                <field name="f3d_code"/>
            </field>
            <filter name="inactive" position="before">
                <filter name="f3d_dock" string="Ворота" domain="[('f3d_kind', '=', 'dock')]"/>
                <filter name="f3d_with_code" string="З кодом сцени" domain="[('f3d_code', '!=', False)]"/>
                <filter name="f3d_no_code" string="Без коду" domain="[('f3d_code', '=', False)]"/>
                <separator/>
            </filter>
            <filter name="usage" position="after">
                <filter name="group_f3d_zone" string="Зона" domain="[]" context="{'group_by': 'f3d_zone_id'}"/>
            </filter>
        </field>
    </record>

    <!-- V-17: дія воріт (пункт меню — у f3d_menus.xml) -->
    <record id="action_f3d_dock" model="ir.actions.act_window">
        <field name="name">Ворота</field>
        <field name="res_model">stock.location</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('f3d_kind', '=', 'dock')]</field>
        <field name="context">{'default_f3d_kind': 'dock', 'default_usage': 'internal'}</field>
    </record>
</odoo>
