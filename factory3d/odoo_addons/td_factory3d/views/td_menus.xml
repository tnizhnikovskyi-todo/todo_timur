<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Пункти з діями (zone, dock, equipment, passport, spec, source, migration) додаються разом із моделями. -->
    <record id="action_td_config_parameter" model="ir.actions.act_window">
        <field name="name">Параметри системи</field>
        <field name="res_model">ir.config_parameter</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('key', '=like', 'td.%')]</field>
    </record>

    <menuitem id="menu_td_root" name="3D Завод" sequence="75"
              web_icon="td_factory3d,static/src/img/app_icon.png"
              groups="td_factory3d.group_td_user"/>
    <!-- Верхній рядок: 8 пунктів. Групи без дії й без groups: Odoo показує їх, лише якщо видно хоч одного нащадка
         (_visible_menu_ids), тож без встановлених модулів порожньої групи немає. Рівні: пункт рядка → розділ → пункт. -->
    <menuitem id="menu_td_safety" name="Будівля і безпека" parent="menu_td_root" sequence="55"/>
    <menuitem id="menu_td_data" name="Дані" parent="menu_td_root" sequence="80"/>
    <menuitem id="menu_td_plant" name="Завод" parent="menu_td_data" sequence="10"
              groups="td_factory3d.group_td_user"/>
    <menuitem id="menu_td_zone" name="Зони" parent="menu_td_plant" sequence="10"
              action="action_td_zone" groups="group_td_user"/>
    <menuitem id="menu_td_dock" name="Ворота" parent="menu_td_plant" sequence="20"
              action="action_td_dock" groups="group_td_user"/>
    <menuitem id="menu_td_equipment" name="Обладнання зі сцени" parent="menu_td_plant" sequence="30"
              action="action_td_equipment" groups="group_td_user"/>
    <menuitem id="menu_td_passport" name="Паспорти обладнання" parent="menu_td_plant" sequence="40"
              action="action_td_equipment_passport" groups="group_td_user"/>
    <menuitem id="menu_td_config" name="Налаштування" parent="menu_td_root" sequence="99"
              groups="td_factory3d.group_td_manager"/>
    <menuitem id="menu_td_config_params" name="Параметри системи" parent="menu_td_config" sequence="95"
              action="action_td_config_parameter" groups="td_factory3d.group_td_admin"/>
    <menuitem id="menu_td_config_spec" name="Параметри паспортів" parent="menu_td_config" sequence="20"
              action="action_td_equipment_spec" groups="group_td_manager"/>
    <menuitem id="menu_td_config_source" name="Джерела паспортів" parent="menu_td_config" sequence="21"
              action="action_td_equipment_source" groups="group_td_manager"/>
    <menuitem id="menu_td_config_migration" name="Повторити міграцію демо-даних" parent="menu_td_config"
              sequence="96" action="action_td_run_migration" groups="td_factory3d.group_td_admin"/>
</odoo>
