<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- V-12 -->
    <record id="view_maintenance_equipment_form_td" model="ir.ui.view">
        <field name="name">maintenance.equipment.form.f3d</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_f3d_show" string="Показати в 3D" type="object"
                            class="btn-primary" invisible="not td_code or not td_viewer_available"/>
                </header>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page name="f3d" string="3D Завод">
                    <group name="f3d_scene" string="Код сцени">
                        <field name="td_is_manager" invisible="1"/>
                        <field name="td_viewer_available" invisible="1"/>
                        <field name="td_code" readonly="not td_is_manager"/>
                        <field name="td_alias" readonly="not td_is_manager"/>
                        <field name="td_kind" readonly="not td_is_manager"/>
                        <field name="td_zone_id"/>
                    </group>
                    <button name="action_f3d_show" string="Показати в 3D" type="object"
                            icon="fa-cube" class="btn-secondary" invisible="not td_code"/>
                </page>
                <page name="f3d_passport" string="Паспорт">
                    <group>
                        <group>
                            <field name="td_passport_id"/>
                            <field name="td_units"/>
                        </group>
                        <group>
                            <field name="td_manufacturer"/>
                            <field name="td_model"/>
                            <field name="td_role"/>
                            <field name="td_dimensions"/>
                            <field name="td_power_kw"/>
                            <field name="td_connected_kw"/>
                        </group>
                    </group>
                    <group>
                        <field name="td_reason" colspan="2"/>
                    </group>
                    <separator string="Параметри"/>
                    <field name="td_spec_ids" readonly="1">
                        <list>
                            <field name="name"/>
                            <field name="value_text"/>
                            <field name="value_num"/>
                            <field name="uom"/>
                            <field name="kind"/>
                        </list>
                    </field>
                    <separator string="Джерела"/>
                    <field name="td_source_ids" readonly="1">
                        <list>
                            <field name="kind"/>
                            <field name="name"/>
                            <field name="url" widget="url"/>
                        </list>
                    </field>
                    <separator string="У складі"/>
                    <field name="td_component_passport_ids" readonly="not td_is_manager">
                        <list>
                            <field name="name"/>
                            <field name="manufacturer"/>
                            <field name="model"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- V-13 -->
    <record id="view_maintenance_equipment_list_td" model="ir.ui.view">
        <field name="name">maintenance.equipment.list.f3d</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_tree"/>
        <field name="arch" type="xml">
            <field name="serial_no" position="after">
                <field name="td_code" optional="show"/>
                <field name="td_passport_id" optional="hide"/>
                <field name="td_zone_id" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="view_maintenance_equipment_search_td" model="ir.ui.view">
        <field name="name">maintenance.equipment.search.f3d</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_search"/>
        <field name="arch" type="xml">
            <field name="category_id" position="after">
                <field name="td_code"/>
            </field>
            <filter name="my" position="before">
                <filter string="З кодом сцени" name="f3d_with_code" domain="[('td_code', '!=', False)]"/>
                <filter string="Без паспорта" name="f3d_no_passport" domain="[('td_passport_id', '=', False)]"/>
                <separator/>
            </filter>
            <xpath expr="//search" position="inside">
                <group>
                    <filter string="Зона" name="group_td_zone" context="{'group_by': 'td_zone_id'}"/>
                    <filter string="Паспорт" name="group_td_passport" context="{'group_by': 'td_passport_id'}"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- V-17: дія (пункт меню — у td_menus.xml) -->
    <record id="action_td_equipment" model="ir.actions.act_window">
        <field name="name">Обладнання зі сцени</field>
        <field name="res_model">maintenance.equipment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('td_code', '!=', False)]</field>
        <field name="context">{'search_default_group_td_zone': 1}</field>
    </record>
</odoo>
