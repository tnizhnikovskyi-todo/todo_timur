<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- V-08 -->
    <record id="view_stock_picking_batch_form_td" model="ir.ui.view">
        <field name="name">stock.picking.batch.form.f3d</field>
        <field name="model">stock.picking.batch</field>
        <field name="inherit_id" ref="stock_fleet.stock_picking_batch_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='dock_id']" position="after">
                <field name="td_truck"/>
                <field name="td_vehicle_id"/>
            </xpath>
            <xpath expr="//sheet/*[1]" position="before">
                <div class="alert alert-warning" role="alert" invisible="not td_dock_warning">
                    <field name="td_dock_warning" readonly="1" nolabel="1"/>
                </div>
            </xpath>
            <xpath expr="//page[@name='page_transfers']" position="after">
                <page name="f3d" string="Завод 3D">
                    <field name="td_is_manager" invisible="1"/>
                    <field name="td_viewer_available" invisible="1"/>
                    <group name="f3d_scene" string="Код сцени">
                        <field name="td_code" string="Код фури в 3D" readonly="not td_is_manager"/>
                        <field name="td_alias" readonly="not td_is_manager"/>
                        <field name="td_kind" readonly="not td_is_manager"/>
                        <field name="td_dock_code"/>
                    </group>
                    <button name="action_f3d_show" string="Показати в 3D" type="object"
                            icon="fa-cube" class="btn-secondary" invisible="not td_code"/>
                </page>
            </xpath>
        </field>
    </record>

    <!-- V-09 -->
    <record id="view_stock_picking_batch_list_td" model="ir.ui.view">
        <field name="name">stock.picking.batch.list.f3d</field>
        <field name="model">stock.picking.batch</field>
        <field name="inherit_id" ref="stock_fleet.stock_picking_batch_tree"/>
        <field name="arch" type="xml">
            <field name="dock_id" position="after">
                <field name="td_truck" optional="show"/>
                <field name="td_vehicle_id" optional="hide"/>
                <field name="td_code" optional="hide"/>
            </field>
        </field>
    </record>
</odoo>
