<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- V-23 -->
    <record id="view_td_zone_form_fire" model="ir.ui.view">
        <field name="name">td.zone.form.fire</field>
        <field name="model">td.zone</field>
        <field name="inherit_id" ref="td_factory3d.view_td_zone_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_fire_zones" type="object" class="oe_stat_button" icon="fa-fire">
                    <field name="td_fire_zone_count" widget="statinfo" string="Сигналізація"/>
                </button>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page name="f3d_fire" string="Пожежна безпека">
                    <group>
                        <field name="td_fire_kind"/>
                        <field name="td_fire_state" widget="badge"
                               decoration-danger="td_fire_state in ('alarm','prealarm')"
                               decoration-warning="td_fire_state in ('fault','disabled')"
                               decoration-info="td_fire_state == 'test'"
                               decoration-success="td_fire_state == 'normal'"
                               decoration-muted="td_fire_state == 'unknown'"/>
                        <field name="td_evac_route_id"/>
                        <field name="td_evac_exit_code"/>
                        <field name="td_evac_length_m"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
