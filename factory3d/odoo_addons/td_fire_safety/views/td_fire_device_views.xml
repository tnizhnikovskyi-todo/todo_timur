<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- V-06 -->
    <record id="view_f3d_fire_device_list" model="ir.ui.view">
        <field name="name">f3d.fire.device.list</field>
        <field name="model">f3d.fire.device</field>
        <field name="arch" type="xml">
            <list create="false">
                <field name="address"/>
                <field name="name"/>
                <field name="type"/>
                <field name="loop_id"/>
                <field name="zone_id"/>
                <field name="plant_zone_id" optional="show"/>
                <field name="system_id" optional="hide"/>
                <field name="lsp_instance" optional="hide"/>
                <field name="x"/>
                <field name="y"/>
                <field name="z" optional="hide"/>
                <field name="state" widget="badge" decoration-danger="state in ('alarm','prealarm')"
                       decoration-warning="state in ('fault','disabled')" decoration-info="state == 'test'"
                       decoration-success="state == 'normal'" decoration-muted="state == 'unknown'"/>
                <field name="reliability" optional="hide"/>
                <field name="dust_pct"/>
                <field name="dust_state" widget="badge" decoration-danger="dust_state == 'alarm'"
                       decoration-warning="dust_state == 'warn'" decoration-success="dust_state == 'ok'"/>
                <field name="monitor" optional="show" groups="factory3d_base.group_f3d_manager"/>
                <field name="maintenance_request_id" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_f3d_fire_device_search" model="ir.ui.view">
        <field name="name">f3d.fire.device.search</field>
        <field name="model">f3d.fire.device</field>
        <field name="arch" type="xml">
            <search>
                <field name="address"/>
                <field name="name"/>
                <field name="zone_id"/>
                <field name="plant_zone_id"/>
                <filter name="filter_detectors" string="Сповіщувачі" domain="[('is_detector', '=', True)]"/>
                <filter name="filter_mcp" string="Ручні" domain="[('type', '=', 'mcp')]"/>
                <filter name="filter_sounder" string="Оповіщувачі" domain="[('type', '=', 'sounder')]"/>
                <filter name="filter_flame" string="Полум'я" domain="[('type', '=', 'flame')]"/>
                <filter name="filter_spark" string="Іскрогасіння"
                        domain="[('type', 'in', ('spark_detector', 'spark_nozzle'))]"/>
                <filter name="filter_vent" string="Люки" domain="[('type', '=', 'smoke_vent')]"/>
                <filter name="filter_dust" string="Запиленість" domain="[('dust_state', 'in', ('warn', 'alarm'))]"/>
                <filter name="filter_faulty" string="Несправні" domain="[('state', 'in', ('fault', 'disabled'))]"/>
                <filter name="filter_monitor" string="Окремі сигнали" domain="[('monitor', '=', True)]"/>
                <group>
                    <filter name="group_type" string="Тип" context="{'group_by': 'type'}"/>
                    <filter name="group_loop" string="Шлейф" context="{'group_by': 'loop_id'}"/>
                    <filter name="group_zone" string="Зона" context="{'group_by': 'zone_id'}"/>
                    <filter name="group_system" string="Система" context="{'group_by': 'system_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- V-07 -->
    <record id="view_f3d_fire_device_form" model="ir.ui.view">
        <field name="name">f3d.fire.device.form</field>
        <field name="model">f3d.fire.device</field>
        <field name="arch" type="xml">
            <form string="Пристрій">
                <header>
                    <button name="action_create_signals" type="object" string="Окремі сигнали"
                            groups="factory3d_base.group_f3d_manager" invisible="monitor or not panel_id"/>
                    <button name="action_remove_signals" type="object" string="Вимкнути окремі сигнали"
                            groups="factory3d_base.group_f3d_manager" invisible="not monitor"/>
                    <button name="action_f3d_show" type="object" string="Показати в 3D" icon="fa-cube"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group string="Пристрій">
                            <field name="address"/>
                            <field name="type"/>
                            <field name="panel_id"/>
                            <field name="loop_id"/>
                            <field name="zone_id"/>
                            <field name="plant_zone_id"/>
                            <field name="system_id"/>
                            <field name="smoke_zone_id"/>
                            <field name="equipment_id"/>
                            <field name="model"/>
                            <field name="lsp_instance"/>
                            <field name="seq"/>
                            <field name="active"/>
                        </group>
                        <group string="Розміщення">
                            <field name="x"/>
                            <field name="y"/>
                            <field name="z"/>
                            <field name="side"/>
                            <field name="heading_deg"/>
                            <field name="note"/>
                        </group>
                        <group string="Стан">
                            <field name="state" widget="badge" decoration-danger="state in ('alarm','prealarm')"
                                   decoration-warning="state in ('fault','disabled')" decoration-info="state == 'test'"
                                   decoration-success="state == 'normal'" decoration-muted="state == 'unknown'"/>
                            <field name="raw_state"/>
                            <field name="reliability"/>
                            <field name="state_ts"/>
                            <field name="dust_pct"/>
                            <field name="dust_ts"/>
                            <field name="dust_state"/>
                            <field name="maintenance_request_id"/>
                        </group>
                        <group string="Сигнали" groups="factory3d_base.group_f3d_manager">
                            <field name="monitor"/>
                            <field name="state_signal_id"/>
                            <field name="dust_signal_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_f3d_fire_device" model="ir.actions.act_window">
        <field name="name">Пристрої</field>
        <field name="res_model">f3d.fire.device</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_type': 1}</field>
    </record>
</odoo>
