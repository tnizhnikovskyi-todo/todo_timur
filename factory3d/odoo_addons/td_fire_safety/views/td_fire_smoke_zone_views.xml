<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_td_fire_smoke_zone_list" model="ir.ui.view">
        <field name="name">td.fire.smoke.zone.list</field>
        <field name="model">td.fire.smoke.zone</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="area_m2"/>
                <field name="max_area_m2"/>
                <field name="vent_count"/>
                <field name="need_vents"/>
                <field name="vent_area_m2"/>
                <field name="compliance" widget="badge" decoration-success="compliance == 'ok'"
                       decoration-warning="compliance == 'warn'" decoration-danger="compliance == 'fail'"/>
            </list>
        </field>
    </record>

    <record id="view_td_fire_smoke_zone_form" model="ir.ui.view">
        <field name="name">td.fire.smoke.zone.form</field>
        <field name="model">td.fire.smoke.zone</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Зона">
                            <field name="code"/>
                            <field name="name"/>
                            <field name="system_id"/>
                            <field name="x0"/>
                            <field name="y0"/>
                            <field name="x1"/>
                            <field name="y1"/>
                            <field name="area_m2"/>
                            <field name="active"/>
                        </group>
                        <group string="Перевірка R-09">
                            <field name="max_area_m2"/>
                            <field name="area_ok"/>
                            <field name="need_vents"/>
                            <field name="vent_count"/>
                            <field name="vent_area_m2"/>
                            <field name="vents_ok"/>
                            <field name="compliance" widget="badge" decoration-success="compliance == 'ok'"
                                   decoration-warning="compliance == 'warn'" decoration-danger="compliance == 'fail'"/>
                            <field name="compliance_note"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Люки" name="vents">
                            <field name="vent_ids" readonly="1">
                                <list>
                                    <field name="address"/>
                                    <field name="x"/>
                                    <field name="y"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_td_fire_smoke_zone" model="ir.actions.act_window">
        <field name="name">Димові зони</field>
        <field name="res_model">td.fire.smoke.zone</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
