<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- V-03 -->
    <record id="view_td_fire_zone_kanban" model="ir.ui.view">
        <field name="name">td.fire.zone.kanban</field>
        <field name="model">td.fire.zone</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" records_draggable="false" group_create="false"
                    quick_create="false" create="false">
                <field name="color"/>
                <field name="state"/>
                <field name="warn"/>
                <templates>
                    <t t-name="card" t-attf-class="oe_kanban_color_#{record.color.raw_value}">
                        <div><strong><field name="code"/></strong> <field name="name"/></div>
                        <div class="text-muted"><field name="kind_name"/></div>
                        <div><field name="detector_count"/> шт. · шлейф <field name="loop_id"/></div>
                        <div>
                            <field name="state" widget="badge" decoration-danger="state in ('alarm','prealarm')"
                                   decoration-warning="state in ('fault','disabled')" decoration-info="state == 'test'"
                                   decoration-success="state == 'normal'" decoration-muted="state == 'unknown'"/>
                            <field name="compliance" widget="badge" decoration-success="compliance == 'ok'"
                                   decoration-warning="compliance == 'warn'" decoration-danger="compliance == 'fail'"/>
                        </div>
                        <div t-if="record.warn.raw_value" class="text-warning">
                            <t t-out="(record.warning.value || '').substring(0, 120)"/>
                        </div>
                        <div t-if="record.dust_max_pct.raw_value"><field name="dust_max_pct"/> %</div>
                        <div class="text-danger"><field name="maintenance_request_name"/></div>
                        <button name="action_f3d_show" type="object" class="btn btn-sm btn-secondary">3D</button>
                        <field name="warning" invisible="1"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- V-04 -->
    <record id="view_td_fire_zone_list" model="ir.ui.view">
        <field name="name">td.fire.zone.list</field>
        <field name="model">td.fire.zone</field>
        <field name="arch" type="xml">
            <list create="false" decoration-danger="state in ('alarm','prealarm')"
                  decoration-warning="warn or state in ('fault','disabled')" decoration-muted="state == 'unknown'">
                <field name="lsz_instance"/>
                <field name="code"/>
                <field name="name"/>
                <field name="zone_id"/>
                <field name="kind"/>
                <field name="loop_id"/>
                <field name="detector_count"/>
                <field name="n_required"/>
                <field name="state" widget="badge" decoration-danger="state in ('alarm','prealarm')"
                       decoration-warning="state in ('fault','disabled')" decoration-info="state == 'test'"
                       decoration-success="state == 'normal'" decoration-muted="state == 'unknown'"/>
                <field name="warn"/>
                <field name="dust_max_pct" optional="show"/>
                <field name="compliance" widget="badge" decoration-success="compliance == 'ok'"
                       decoration-warning="compliance == 'warn'" decoration-danger="compliance == 'fail'"/>
                <field name="maintenance_request_name" optional="show"/>
                <field name="stale" optional="hide"/>
                <field name="area_m2" optional="hide"/>
                <field name="spacing_m" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_td_fire_zone_search" model="ir.ui.view">
        <field name="name">td.fire.zone.search</field>
        <field name="model">td.fire.zone</field>
        <field name="arch" type="xml">
            <search>
                <field name="code"/>
                <field name="name"/>
                <field name="zone_id"/>
                <filter name="filter_alarm" string="Тривога" domain="[('state', 'in', ('alarm', 'prealarm'))]"/>
                <filter name="filter_fault" string="Несправність" domain="[('state', '=', 'fault')]"/>
                <filter name="filter_warn" string="Попередження" domain="[('warn', '=', True)]"/>
                <filter name="filter_disabled" string="Вимкнено" domain="[('state', '=', 'disabled')]"/>
                <filter name="filter_test" string="Тест" domain="[('state', '=', 'test')]"/>
                <filter name="filter_unknown" string="Немає даних"
                        domain="['|', ('state', '=', 'unknown'), ('stale', '=', True)]"/>
                <filter name="filter_noncompliant" string="Не відповідає нормам"
                        domain="[('compliance', 'in', ('warn', 'fail'))]"/>
                <filter name="filter_archived" string="Архівні" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_state" string="Стан" context="{'group_by': 'state'}"/>
                    <filter name="group_kind" string="Тип" context="{'group_by': 'kind'}"/>
                    <filter name="group_loop" string="Шлейф" context="{'group_by': 'loop_id'}"/>
                    <filter name="group_compliance" string="Відповідність" context="{'group_by': 'compliance'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- V-05 -->
    <record id="view_td_fire_zone_form" model="ir.ui.view">
        <field name="name">td.fire.zone.form</field>
        <field name="model">td.fire.zone</field>
        <field name="arch" type="xml">
            <form string="Зона виявлення">
                <header>
                    <button name="action_recompute" type="object" string="Перерахувати"
                            groups="td_factory3d.group_td_manager"/>
                    <button name="action_create_device_signals" type="object" string="Окремі сигнали пристроїв"
                            groups="td_factory3d.group_td_manager"
                            confirm="Створити сигнали стану й запиленості для всіх сповіщувачів зони?"/>
                    <button name="action_f3d_show" type="object" string="Показати в 3D" icon="fa-cube"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_devices" type="object" class="oe_stat_button" icon="fa-microchip">
                            <field name="detector_count" widget="statinfo" string="Сповіщувачі"/>
                        </button>
                        <button name="action_view_events" type="object" class="oe_stat_button" icon="fa-list">
                            <field name="event_count" widget="statinfo" string="Події 30 діб"/>
                        </button>
                        <button name="action_view_requests" type="object" class="oe_stat_button" icon="fa-wrench"
                                string="Заявка" invisible="not maintenance_request_id"/>
                    </div>
                    <div class="oe_title"><h1><field name="display"/></h1></div>
                    <group>
                        <group string="Зона">
                            <field name="code"/>
                            <field name="name"/>
                            <field name="zone_id"/>
                            <field name="equipment_id"/>
                            <field name="panel_id"/>
                            <field name="loop_id"/>
                            <field name="lsz_instance"/>
                            <field name="kind"/>
                            <field name="active"/>
                        </group>
                        <group string="Стан">
                            <field name="state" widget="badge" decoration-danger="state in ('alarm','prealarm')"
                                   decoration-warning="state in ('fault','disabled')" decoration-info="state == 'test'"
                                   decoration-success="state == 'normal'" decoration-muted="state == 'unknown'"/>
                            <field name="raw_state"/>
                            <field name="state_ts"/>
                            <field name="stale"/>
                            <field name="warn"/>
                            <field name="dust_max_pct"/>
                            <field name="maintenance_request_id"/>
                        </group>
                    </group>
                    <field name="warning" class="alert alert-warning" invisible="not warning" readonly="1"/>
                    <group string="Розстановка за ДБН">
                        <group>
                            <field name="spacing_m"/>
                            <field name="wall_m"/>
                            <label for="x0" string="Контур, м"/>
                            <div class="d-flex gap-1">
                                <field name="x0"/><field name="y0"/><field name="x1"/><field name="y1"/>
                            </div>
                            <field name="area_m2"/>
                            <field name="z_m"/>
                        </group>
                        <group>
                            <field name="detector_count"/>
                            <field name="n_required"/>
                            <field name="n_ok"/>
                            <field name="cover_max_gap_m"/>
                            <field name="cover_point"/>
                            <field name="cover_ok"/>
                            <field name="compliance" widget="badge" decoration-success="compliance == 'ok'"
                                   decoration-warning="compliance == 'warn'" decoration-danger="compliance == 'fail'"/>
                        </group>
                    </group>
                    <field name="compliance_note"/>
                    <div class="text-muted">
                        Цех понад 8 м: ДБН п. 7.2.10 рекомендує аспіраційні сповіщувачі; точкові під покрівлею — за
                        табл. 7.2 до 12 м. Покриття — похідна перевірка A-06, не текст норми.
                    </div>
                    <notebook>
                        <page string="Пристрої" name="devices">
                            <field name="device_ids" readonly="1">
                                <list>
                                    <field name="address"/>
                                    <field name="type"/>
                                    <field name="state"/>
                                    <field name="dust_pct"/>
                                    <field name="dust_state"/>
                                    <field name="monitor" groups="td_factory3d.group_td_manager"/>
                                </list>
                            </field>
                        </page>
                        <page string="Сигнали" name="signals" groups="td_factory3d.group_td_manager">
                            <group>
                                <field name="signal_id"/>
                                <field name="dust_signal_id"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_td_fire_zone" model="ir.actions.act_window">
        <field name="name">Зони сигналізації</field>
        <field name="res_model">td.fire.zone</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_group_state': 1}</field>
    </record>
</odoo>
