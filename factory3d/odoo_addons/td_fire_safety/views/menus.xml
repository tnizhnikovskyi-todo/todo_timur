<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- SPEC §3 (V-00). W0: корінь і контейнери; пункти з діями — нижче в коментарі, розкоментувати, коли з'являться
         відповідні ir.actions (action_f3d_fire_*) у views/*.xml. У фінальному манифесті menus.xml — останній. -->
