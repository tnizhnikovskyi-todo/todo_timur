<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="privilege_td_access" model="res.groups.privilege">
        <field name="name">Доступ (СКУД)</field>
        <field name="category_id" ref="td_factory3d.module_category_factory3d"/>
        <field name="sequence">70</field>
    </record>
    <record id="group_td_access_security" model="res.groups">
        <field name="name">Охорона</field>
        <field name="privilege_id" ref="privilege_td_access"/>
        <field name="sequence">10</field>
        <field name="implied_ids" eval="[Command.link(ref('td_factory3d.group_td_user'))]"/>
    </record>
    <record id="group_td_access_admin" model="res.groups">
        <field name="name">Адміністратор СКУД</field>
        <field name="privilege_id" ref="privilege_td_access"/>
        <field name="sequence">20</field>
        <field name="implied_ids" eval="[Command.link(ref('group_td_access_security')), Command.link(ref('td_factory3d.group_td_manager'))]"/>
    </record>
    <record id="td_factory3d.group_td_admin" model="res.groups">
        <field name="implied_ids" eval="[Command.link(ref('group_td_access_admin'))]"/>
    </record>
    <record id="rule_td_access_server_company" model="ir.rule">
        <field name="name">СКУД server: компанія</field>
        <field name="model_id" ref="model_td_access_server"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_td_access_device_company" model="ir.rule">
        <field name="name">СКУД device: компанія</field>
        <field name="model_id" ref="model_td_access_device"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_td_access_door_company" model="ir.rule">
        <field name="name">СКУД door: компанія</field>
        <field name="model_id" ref="model_td_access_door"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_td_access_user_link_company" model="ir.rule">
        <field name="name">СКУД user.link: компанія</field>
        <field name="model_id" ref="model_td_access_user_link"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_td_access_event_company" model="ir.rule">
        <field name="name">СКУД event: компанія</field>
        <field name="model_id" ref="model_td_access_event"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_td_access_presence_company" model="ir.rule">
        <field name="name">СКУД presence: компанія</field>
        <field name="model_id" ref="model_td_access_presence"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_td_access_card_company" model="ir.rule">
        <field name="name">СКУД card: компанія</field>
        <field name="model_id" ref="model_td_access_card"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_td_access_visitor_company" model="ir.rule">
        <field name="name">СКУД visitor: компанія</field>
        <field name="model_id" ref="model_td_access_visitor"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_td_access_card_security_visitors" model="ir.rule">
        <field name="name">СКУД card: охорона змінює картки відвідувачів і пулу</field>
        <field name="model_id" ref="model_td_access_card"/>
        <field name="domain_force">[('holder_type', 'in', ('visitor', 'pool'))]</field>
        <field name="groups" eval="[Command.link(ref('group_td_access_security'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_td_access_card_admin_all" model="ir.rule">
        <field name="name">СКУД card: адміністратор змінює всі картки</field>
        <field name="model_id" ref="model_td_access_card"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('group_td_access_admin'))]"/>
        <field name="perm_read" eval="False"/>
    </record>
</odoo>
