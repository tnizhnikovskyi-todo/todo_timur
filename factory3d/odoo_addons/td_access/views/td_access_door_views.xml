<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_td_access_door_list" model="ir.ui.view">
        <field name="name">td.access.door.list</field>
        <field name="model">td.access.door</field>
        <field name="arch" type="xml">
            <list string="Двері СКУД" decoration-danger="alarm">
                <field name="code"/>
                <field name="name"/>
                <field name="kind"/>
                <field name="zone_from_id"/>
                <field name="zone_to_id"/>
                <field name="is_perimeter"/>
                <field name="dwell_min"/>
                <field name="state" widget="badge" decoration-danger="alarm"/>
                <field name="state_ts"/>
                <field name="passes_today"/>
                <field name="alarm" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_td_access_door_kanban" model="ir.ui.view">
        <field name="name">td.access.door.kanban</field>
        <field name="model">td.access.door</field>
        <field name="arch" type="xml">
            <kanban string="Двері СКУД">
                <field name="state"/>
                <field name="alarm"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="border-start border-4 ps-2 #{['forced', 'held'].includes(record.state.raw_value) || record.alarm.raw_value ? 'border-danger' : ['open', 'unlocked'].includes(record.state.raw_value) ? 'border-warning' : 'border-secondary'}">
                            <field name="code" class="fw-bold fs-5"/>
                            <div><field name="name"/></div>
                            <div><field name="state" widget="badge"/></div>
                            <div class="text-muted">Проходів сьогодні: <field name="passes_today"/></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_td_access_door_form" model="ir.ui.view">
        <field name="name">td.access.door.form</field>
        <field name="model">td.access.door</field>
        <field name="arch" type="xml">
            <form string="Двері СКУД">
                <header>
                    <button name="action_ack_alarm" type="object" string="Зняти тривогу" class="btn-danger"
                            invisible="not alarm" groups="td_access.group_td_access_security"/>
                </header>
                <sheet>
                    <field name="is_access_admin" invisible="1"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_f3d_show" type="object" string="Показати в 3D" icon="fa-cube"
                                class="btn-secondary"/>
                        <button name="action_open_events" type="object" string="Події" icon="fa-list"
                                class="oe_stat_button"/>
                    </div>
                    <group>
                        <group string="Двері">
                            <field name="code" readonly="not is_access_admin"/>
                            <field name="name" readonly="not is_access_admin"/>
                            <field name="kind" readonly="not is_access_admin"/>
                            <field name="biostar_id" readonly="not is_access_admin"/>
                            <field name="server_id" readonly="not is_access_admin"/>
                            <field name="open_duration_s"/>
                        </group>
                        <group string="Граф зон">
                            <field name="zone_from_id" readonly="not is_access_admin"/>
                            <field name="zone_to_id" readonly="not is_access_admin"/>
                            <field name="is_perimeter" readonly="not is_access_admin"/>
                            <field name="dwell_min" readonly="not is_access_admin"/>
                        </group>
                        <group string="Зчитувачі">
                            <field name="entry_device_id" readonly="not is_access_admin"/>
                            <field name="exit_device_id" readonly="not is_access_admin"/>
                        </group>
                        <group string="Стан">
                            <field name="state"/>
                            <field name="state_ts"/>
                            <field name="alarm"/>
                            <field name="alarm_reason"/>
                            <field name="active" readonly="not is_access_admin"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_td_access_door_search" model="ir.ui.view">
        <field name="name">td.access.door.search</field>
        <field name="model">td.access.door</field>
        <field name="arch" type="xml">
            <search string="Двері СКУД">
                <field name="code"/>
                <field name="name"/>
                <field name="biostar_id"/>
                <filter name="alarm" string="Тривога" domain="[('alarm', '=', True)]"/>
                <filter name="perimeter" string="Периметр" domain="[('is_perimeter', '=', True)]"/>
                <filter name="no_zone" string="Без зон" domain="[('zone_to_id', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_td_access_door" model="ir.actions.act_window">
        <field name="name">Двері</field>
        <field name="res_model">td.access.door</field>
        <field name="view_mode">kanban,list,form</field>
    </record>
</odoo>
