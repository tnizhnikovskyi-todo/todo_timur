<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_td_access_event_list" model="ir.ui.view">
        <field name="name">td.access.event.list</field>
        <field name="model">td.access.event</field>
        <field name="arch" type="xml">
            <list string="Журнал подій" create="0" edit="0" delete="0"
                  decoration-danger="event_type in ('denied', 'fail') or process_state == 'error'"
                  decoration-warning="apb_suspect or zone_violation">
                <field name="ts"/>
                <field name="door_id"/>
                <field name="device_id"/>
                <field name="direction"/>
                <field name="event_type" widget="badge" decoration-success="event_type == 'pass'"
                       decoration-danger="event_type in ('denied', 'fail')"
                       decoration-muted="event_type == 'door'" decoration-warning="event_type == 'alarm'"/>
                <field name="code"/>
                <field name="code_name" optional="show"/>
                <field name="credential" optional="hide"/>
                <field name="employee_id"/>
                <field name="raw_user_id" optional="hide"/>
                <field name="deny_reason" optional="show"/>
                <field name="attendance_action" optional="show"/>
                <field name="apb_suspect" widget="boolean" optional="show"/>
                <field name="zone_violation" column_invisible="1"/>
                <field name="process_state" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_td_access_event_form" model="ir.ui.view">
        <field name="name">td.access.event.form</field>
        <field name="model">td.access.event</field>
        <field name="arch" type="xml">
            <form string="Подія СКУД" create="0" edit="0" delete="0">
                <header>
                    <button name="action_reprocess" type="object" string="Обробити повторно"
                            groups="td_access.group_td_access_admin"/>
                </header>
                <sheet>
                    <group>
                        <group string="Подія">
                            <field name="ts"/>
                            <field name="server_ts"/>
                            <field name="received_at"/>
                            <field name="biostar_id"/>
                            <field name="code"/>
                            <field name="code_name"/>
                            <field name="event_type"/>
                            <field name="credential"/>
                            <field name="deny_reason"/>
                            <field name="tna_key"/>
                            <field name="direction"/>
                        </group>
                        <group string="Де">
                            <field name="device_id"/>
                            <field name="door_id"/>
                            <field name="is_perimeter"/>
                            <field name="zone_from_id"/>
                            <field name="zone_to_id"/>
                        </group>
                        <group string="Хто">
                            <field name="raw_user_id"/>
                            <field name="link_id"/>
                            <field name="employee_id"/>
                            <field name="unknown_user"/>
                        </group>
                        <group string="Результат">
                            <field name="process_state"/>
                            <field name="attendance_action"/>
                            <field name="attendance_id"/>
                            <field name="presence_changed"/>
                            <field name="apb_suspect"/>
                            <field name="zone_violation"/>
                            <field name="error_message"/>
                        </group>
                    </group>
                    <field name="raw" groups="td_factory3d.group_td_admin" invisible="not raw"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_td_access_event_search" model="ir.ui.view">
        <field name="name">td.access.event.search</field>
        <field name="model">td.access.event</field>
        <field name="arch" type="xml">
            <search string="Події СКУД">
                <field name="employee_id"/>
                <field name="raw_user_id"/>
                <field name="door_id"/>
                <field name="device_id"/>
                <field name="code"/>
                <filter name="filter_denied" string="Відмови"
                        domain="[('event_type', 'in', ('denied', 'fail'))]"/>
                <filter name="filter_apb" string="Антипрохід"
                        domain="['|', ('deny_reason', 'in', ('apb', 'timed_apb')), ('apb_suspect', '=', True)]"/>
                <filter name="filter_unknown" string="Нерозпізнані користувачі"
                        domain="[('unknown_user', '=', True)]"/>
                <filter name="filter_zone_violation" string="Порушення зон"
                        domain="[('zone_violation', '=', True)]"/>
                <filter name="filter_errors" string="Помилки обробки"
                        domain="[('process_state', '=', 'error')]"/>
                <filter name="filter_perimeter" string="Периметр" domain="[('is_perimeter', '=', True)]"/>
                <separator/>
                <filter name="filter_pass" string="Проходи" domain="[('event_type', '=', 'pass')]"/>
                <filter name="filter_in" string="Вхід" domain="[('direction', '=', 'in')]"/>
                <filter name="filter_out" string="Вихід" domain="[('direction', '=', 'out')]"/>
                <separator/>
                <filter name="today" string="Сьогодні"
                        domain="[('ts', '&gt;=', datetime.datetime.combine(context_today(), datetime.time(0, 0, 0)))]"/>
                <group>
                    <filter name="group_door" string="Двері" context="{'group_by': 'door_id'}"/>
                    <filter name="group_type" string="Тип" context="{'group_by': 'event_type'}"/>
                    <filter name="group_employee" string="Працівник" context="{'group_by': 'employee_id'}"/>
                    <filter name="group_day" string="День" context="{'group_by': 'ts:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_td_access_event_pivot" model="ir.ui.view">
        <field name="name">td.access.event.pivot</field>
        <field name="model">td.access.event</field>
        <field name="arch" type="xml">
            <pivot string="Події СКУД">
                <field name="employee_id" type="row"/>
                <field name="ts" interval="day" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="view_td_access_event_graph" model="ir.ui.view">
        <field name="name">td.access.event.graph</field>
        <field name="model">td.access.event</field>
        <field name="arch" type="xml">
            <graph string="Події СКУД" type="bar">
                <field name="ts" interval="hour"/>
                <field name="event_type"/>
            </graph>
        </field>
    </record>

    <record id="action_td_access_event" model="ir.actions.act_window">
        <field name="name">Журнал подій</field>
        <field name="res_model">td.access.event</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="context">{'search_default_today': 1}</field>
    </record>

    <record id="action_td_access_event_report" model="ir.actions.act_window">
        <field name="name">Проходи СКУД</field>
        <field name="res_model">td.access.event</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="domain">[('event_type', '=', 'pass'), ('is_perimeter', '=', True)]</field>
        <field name="context">{'search_default_today': 1, 'search_default_group_employee': 1}</field>
    </record>
</odoo>
