<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Record rules (rule_f3d_viewer_snapshot_company, rule_f3d_viewer_event_read_all) додаються разом з моделями. -->
    <record id="privilege_f3d_viewer" model="res.groups.privilege">
        <field name="name">Завод 3D: переглядач</field>
        <field name="category_id" ref="factory3d_base.module_category_factory3d"/>
        <field name="sequence">10</field>
    </record>
    <record id="group_f3d_kiosk" model="res.groups">
        <field name="name">Завод 3D: кіоск</field>
        <field name="privilege_id" ref="privilege_f3d_viewer"/>
        <field name="sequence">10</field>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user')),
                                         Command.link(ref('factory3d_base.group_f3d_user')),
                                         Command.link(ref('stock.group_stock_user')),
                                         Command.link(ref('mrp.group_mrp_user'))]"/>
    </record>
</odoo>
