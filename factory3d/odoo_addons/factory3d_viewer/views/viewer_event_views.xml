<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_f3d_viewer_event_list" model="ir.ui.view">
        <field name="name">f3d.viewer.event.list</field>
        <field name="model">f3d.viewer.event</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" default_order="ts desc, id desc">
                <field name="ts"/>
                <field name="model"/>
                <field name="kind" widget="badge"/>
                <field name="n"/>
                <field name="codes_text" widget="char"/>
                <field name="user_id"/>
            </list>
        </field>
    </record>

    <record id="view_f3d_viewer_event_search" model="ir.ui.view">
        <field name="name">f3d.viewer.event.search</field>
        <field name="model">f3d.viewer.event</field>
        <field name="arch" type="xml">
            <search>
                <field name="model"/>
                <field name="kind"/>
                <field name="ts"/>
                <group>
                    <filter name="group_model" string="Модель" context="{'group_by': 'model'}"/>
                    <filter name="group_kind" string="Тип" context="{'group_by': 'kind'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_f3d_viewer_event" model="ir.actions.act_window">
        <field name="name">Події стану</field>
        <field name="res_model">f3d.viewer.event</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
