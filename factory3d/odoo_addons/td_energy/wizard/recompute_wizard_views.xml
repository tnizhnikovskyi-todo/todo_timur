<?xml version="1.0" encoding="utf-8"?>
<!-- W3: V-19 і дія майстра перерахунку; пункт меню `menu_td_energy_recompute` додає W5 (views/menus.xml). -->
<odoo>
    <record id="view_td_energy_recompute_wizard_form" model="ir.ui.view">
        <field name="name">td.energy.recompute.wizard.form</field>
        <field name="model">td.energy.recompute.wizard</field>
        <field name="arch" type="xml">
            <form string="Перерахунок енергії">
                <group>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="what"/>
                    <field name="meter_ids" widget="many2many_tags"/>
                    <field name="result" readonly="1" invisible="not result"/>
                </group>
                <footer>
                    <button name="action_run" type="object" string="Перерахувати" class="btn-primary"/>
                    <button string="Закрити" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_td_energy_recompute_wizard" model="ir.actions.act_window">
        <field name="name">Перерахувати енергію</field>
        <field name="res_model">td.energy.recompute.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
