<?xml version="1.0" encoding="utf-8"?>
<!-- W1_SPEC V-30: рекомендації (M-26). Меню — лише «Енергетик» у «Налаштування». -->
<odoo>
    <record id="view_td_energy_advice_list" model="ir.ui.view">
        <field name="name">td.energy.advice.list</field>
        <field name="model">td.energy.advice</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="title"/>
                <field name="level" widget="badge" decoration-warning="level == 'warn'" decoration-muted="level == 'info'"/>
                <field name="node_id"/>
                <field name="state" widget="badge" decoration-success="state == 'open'"
                       decoration-warning="state == 'snoozed'" decoration-muted="state in ('done', 'dismissed', 'expired')"/>
                <field name="snooze_until"/>
                <field name="expires_at"/>
            </list>
        </field>
    </record>

    <record id="view_td_energy_advice_form" model="ir.ui.view">
        <field name="name">td.energy.advice.form</field>
        <field name="model">td.energy.advice</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_snooze" type="object" string="Відкласти" invisible="state != 'open'"/>
                    <button name="action_dismiss" type="object" string="Відхилити"
                            invisible="state not in ('open', 'snoozed')"/>
                    <field name="state" widget="statusbar" statusbar_visible="open,snoozed,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="title" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" readonly="1"/>
                            <field name="dedup_key" readonly="1"/>
                            <field name="kind" readonly="1"/>
                            <field name="level" readonly="1"/>
                            <field name="node_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="snooze_until" readonly="1"/>
                            <field name="expires_at" readonly="1"/>
                            <field name="result_note" readonly="1"/>
                            <field name="resolved_at"/>
                            <field name="resolved_by"/>
                        </group>
                    </group>
                    <field name="text" readonly="1"/>
                    <group string="Дії (JSON)">
                        <field name="actions" widget="json" readonly="1" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_td_energy_advice" model="ir.actions.act_window">
        <field name="name">Рекомендації</field>
        <field name="res_model">td.energy.advice</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
