<?xml version="1.0" encoding="utf-8"?>
<!-- SPEC §3 V-21. Пункти з діями додають воркери разом із видами (sequence — з таблиці SPEC §3):
     W1: menu_td_energy_scheme (20), menu_td_energy_meter (30), menu_td_energy_pool (20, під config);
     W2: menu_td_energy_profile (40), menu_td_energy_balance (60), menu_td_energy_event (80), menu_td_energy_tariff (10, під config);
     W3: menu_td_energy_alloc (50);
     W4: menu_td_energy_outage (70); W5: menu_td_energy_overview (10), menu_td_energy_recompute (30, під config),
     menu_td_energy_settings (50, під td_factory3d.menu_td_config, group_td_admin). -->
<odoo>
    <menuitem id="menu_td_energy" name="Енергетика" parent="td_factory3d.menu_td_root" sequence="50"
              groups="td_energy.group_td_energy_user"/>
    <menuitem id="menu_td_energy_config" name="Налаштування" parent="menu_td_energy" sequence="90"
              groups="td_energy.group_td_energy_cost"/>
    <menuitem id="menu_td_energy_scheme" name="Схема мережі" parent="menu_td_energy" sequence="20"
              action="action_td_energy_node_tree" groups="td_energy.group_td_energy_user"/>
    <menuitem id="menu_td_energy_meter" name="Лічильники" parent="menu_td_energy" sequence="30"
              action="action_td_energy_meter" groups="td_energy.group_td_energy_user"/>
    <menuitem id="menu_td_energy_profile" name="Профіль" parent="menu_td_energy" sequence="40"
              action="action_td_energy_interval" groups="td_energy.group_td_energy_user"/>
    <menuitem id="menu_td_energy_balance" name="Баланс обліку" parent="menu_td_energy" sequence="60"
              action="action_td_energy_balance" groups="td_energy.group_td_energy_user"/>
    <menuitem id="menu_td_energy_outage" name="Відключення" parent="menu_td_energy" sequence="70"
              action="action_td_energy_outage" groups="td_energy.group_td_energy_user"/>
    <menuitem id="menu_td_energy_event" name="Журнал подій" parent="menu_td_energy" sequence="80"
              action="action_td_energy_event" groups="td_energy.group_td_energy_user"/>
    <menuitem id="menu_td_energy_alloc" name="Енергія на виробництво" parent="menu_td_energy" sequence="50"
              action="action_td_energy_alloc_pivot" groups="td_energy.group_td_energy_user"/>
    <menuitem id="menu_td_energy_tariff" name="Тарифи й договір" parent="menu_td_energy_config" sequence="10"
              action="action_td_energy_tariff" groups="td_energy.group_td_energy_cost"/>
    <menuitem id="menu_td_energy_pool" name="Пули спільних споживачів" parent="menu_td_energy_config" sequence="20"
              action="action_td_energy_pool" groups="td_energy.group_td_energy_manager"/>
    <!-- W5 -->
    <menuitem id="menu_td_energy_overview" name="Огляд" parent="menu_td_energy" sequence="10"
              action="action_td_energy_overview" groups="td_energy.group_td_energy_user"/>
    <menuitem id="menu_td_energy_peak" name="Пік і вартість" parent="menu_td_energy" sequence="45"
              action="action_td_energy_peak" groups="td_energy.group_td_energy_cost"/>
    <menuitem id="menu_td_energy_recompute" name="Перерахувати" parent="menu_td_energy_config" sequence="30"
              action="action_td_energy_recompute_wizard" groups="td_energy.group_td_energy_manager"/>
    <menuitem id="menu_td_energy_settings" name="Енергетика" parent="td_factory3d.menu_td_config" sequence="50"
              action="action_td_energy_settings" groups="td_factory3d.group_td_admin"/>
</odoo>
