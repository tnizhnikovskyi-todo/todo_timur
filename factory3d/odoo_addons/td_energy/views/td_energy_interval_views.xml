<?xml version="1.0" encoding="utf-8"?>
<!-- SPEC §3 V-07, V-08 -->
<odoo>
    <record id="view_f3d_energy_interval_graph" model="ir.ui.view">
        <field name="name">f3d.energy.interval.graph</field>
        <field name="model">f3d.energy.interval</field>
        <field name="arch" type="xml">
            <graph type="bar" stacked="1">
                <field name="ts_start" interval="hour"/>
                <field name="role"/>
                <field name="kwh" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_f3d_energy_interval_pivot" model="ir.ui.view">
        <field name="name">f3d.energy.interval.pivot</field>
        <field name="model">f3d.energy.interval</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="node_id" type="row"/>
                <field name="day" type="col"/>
                <field name="kwh" type="measure"/>
                <field name="cost" type="measure" groups="factory3d_energy.group_f3d_energy_cost"/>
                <field name="kw_avg" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_f3d_energy_interval_list" model="ir.ui.view">
        <field name="name">f3d.energy.interval.list</field>
        <field name="model">f3d.energy.interval</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false">
                <field name="ts_start"/>
                <field name="meter_id"/>
                <field name="node_id"/>
                <field name="kwh" sum="Разом"/>
                <field name="kwh_export" optional="hide"/>
                <field name="kw_avg"/>
                <field name="zone_id"/>
                <field name="price" groups="factory3d_energy.group_f3d_energy_cost"/>
                <field name="cost" sum="Разом" groups="factory3d_energy.group_f3d_energy_cost"/>
                <field name="quality" widget="badge" decoration-success="quality == 'measured'"
                       decoration-warning="quality in ('interpolated', 'reset')" decoration-danger="quality == 'missing'"/>
            </list>
        </field>
    </record>

    <record id="view_f3d_energy_interval_search" model="ir.ui.view">
        <field name="name">f3d.energy.interval.search</field>
        <field name="model">f3d.energy.interval</field>
        <field name="arch" type="xml">
            <search>
                <field name="meter_id"/>
                <field name="node_id"/>
                <filter name="today" string="Сьогодні" domain="[('is_today', '=', True)]"/>
                <filter name="yesterday" string="Вчора" domain="[('is_yesterday', '=', True)]"/>
                <filter name="week" string="7 днів" domain="[('is_last_7d', '=', True)]"/>
                <separator/>
                <filter name="not_measured" string="Не виміряно" domain="[('quality', '!=', 'measured')]"/>
                <separator/>
                <filter name="role_incomer" string="Вводи" domain="[('role', '=', 'incomer')]"/>
                <filter name="role_feeder" string="Фідери" domain="[('role', '=', 'feeder')]"/>
                <filter name="role_consumer" string="Споживачі" domain="[('role', '=', 'consumer')]"/>
                <filter name="role_generation" string="Генерація" domain="[('role', '=', 'generation')]"/>
                <group>
                    <filter name="group_day" string="Дата" context="{'group_by': 'day'}"/>
                    <filter name="group_hour" string="Година" context="{'group_by': 'hour_local'}"/>
                    <filter name="group_node" string="Вузол" context="{'group_by': 'node_id'}"/>
                    <filter name="group_zone" string="Зона тарифу" context="{'group_by': 'zone_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_f3d_energy_interval" model="ir.actions.act_window">
        <field name="name">Профіль</field>
        <field name="res_model">f3d.energy.interval</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="context">{'search_default_today': 1, 'search_default_role_feeder': 1}</field>
    </record>
</odoo>
