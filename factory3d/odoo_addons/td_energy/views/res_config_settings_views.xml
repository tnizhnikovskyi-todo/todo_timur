<?xml version="1.0" encoding="utf-8"?>
<!-- SPEC §3 V-18, V-21: налаштування енергетики (лише group_td_admin) -->
<odoo>
    <record id="res_config_settings_view_form_td_energy" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.td.energy</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="46"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Енергетика" string="Енергетика" name="td_energy"
                     groups="td_factory3d.group_td_admin">
                    <block title="Стоп-крани" name="td_energy_switches">
                        <setting string="Читати лічильники" help="Стоп-кран читання: вимикає джерела й крони енергетики">
                            <field name="td_energy_read_enabled"/>
                        </setting>
                        <setting string="Писати уставки в пристрої" help="Заборонено у v1">
                            <field name="td_energy_write_enabled" readonly="1"/>
                        </setting>
                        <setting string="Енергія в собівартості МО">
                            <field name="td_energy_costing_enabled"/>
                        </setting>
                        <setting string="Аналітичні рядки енергії">
                            <field name="td_energy_analytic_enabled"/>
                        </setting>
                    </block>
                    <block title="Профіль і баланс" name="td_energy_balance">
                        <setting string="Допуски й очікування">
                            <div class="content-group">
                                <div class="row mt8"><label class="col-lg-5" for="td_energy_balance_tol_pct"/>
                                    <field name="td_energy_balance_tol_pct"/></div>
                                <div class="row mt8"><label class="col-lg-5" for="td_energy_balance_tol_kwh"/>
                                    <field name="td_energy_balance_tol_kwh"/></div>
                                <div class="row mt8"><label class="col-lg-5" for="td_energy_gap_alarm_min"/>
                                    <field name="td_energy_gap_alarm_min"/></div>
                                <div class="row mt8"><label class="col-lg-5" for="td_energy_max_wait_h"/>
                                    <field name="td_energy_max_wait_h"/></div>
                                <div class="row mt8"><label class="col-lg-5" for="td_energy_typical_days"/>
                                    <field name="td_energy_typical_days"/></div>
                                <div class="row mt8"><label class="col-lg-5" for="td_energy_shift_calendar_id"/>
                                    <field name="td_energy_shift_calendar_id"/></div>
                            </div>
                        </setting>
                    </block>
                    <block title="Зберігання" name="td_energy_storage">
                        <setting string="Терміни зберігання">
                            <div class="content-group">
                                <div class="row mt8"><label class="col-lg-5" for="td_energy_keep_interval_days"/>
                                    <field name="td_energy_keep_interval_days"/></div>
                                <div class="row mt8"><label class="col-lg-5" for="td_energy_keep_event_days"/>
                                    <field name="td_energy_keep_event_days"/></div>
                            </div>
                        </setting>
                    </block>
                    <block title="cos φ" name="td_energy_cos_phi">
                        <setting string="Пороги cos φ"
                                 help="Пороги застосовуються до сигналів energy/totals/cos_phi і energy/sections/S1|S2/cos_phi">
                            <div class="content-group">
                                <div class="row mt8"><label class="col-lg-5" for="td_energy_cos_phi_target"/>
                                    <field name="td_energy_cos_phi_target"/></div>
                                <div class="row mt8"><label class="col-lg-5" for="td_energy_cos_phi_warn"/>
                                    <field name="td_energy_cos_phi_warn"/></div>
                                <div class="row mt8"><label class="col-lg-5" for="td_energy_cos_phi_alarm"/>
                                    <field name="td_energy_cos_phi_alarm"/></div>
                            </div>
                        </setting>
                    </block>
                    <block title="Пульт" name="td_energy_pult">
                        <setting string="Оновлення й пороги схеми">
                            <div class="content-group">
                                <div class="row mt8"><label class="col-lg-5" for="td_energy_pult_refresh_s"/>
                                    <field name="td_energy_pult_refresh_s"/></div>
                                <div class="row mt8"><label class="col-lg-5" for="td_energy_alarm_list_limit"/>
                                    <field name="td_energy_alarm_list_limit"/></div>
                                <div class="row mt8"><label class="col-lg-5" for="td_energy_load_warn_pct"/>
                                    <field name="td_energy_load_warn_pct"/></div>
                                <div class="row mt8"><label class="col-lg-5" for="td_energy_load_alarm_pct"/>
                                    <field name="td_energy_load_alarm_pct"/></div>
                            </div>
                        </setting>
                    </block>
                    <block title="Прогноз" name="td_energy_forecast">
                        <setting string="Типовий день для прогнозу">
                            <div class="content-group">
                                <div class="row mt8"><label class="col-lg-5" for="td_energy_forecast_weeks"/>
                                    <field name="td_energy_forecast_weeks"/></div>
                                <div class="row mt8"><label class="col-lg-5" for="td_energy_forecast_min_days"/>
                                    <field name="td_energy_forecast_min_days"/></div>
                            </div>
                        </setting>
                    </block>
                    <block title="Накопичувач і генерація" name="td_energy_bess">
                        <setting string="Резерв накопичувача (лише показ) і потужність СЕС">
                            <div class="content-group">
                                <div class="row mt8"><label class="col-lg-5" for="td_energy_bess_reserve_pct"/>
                                    <field name="td_energy_bess_reserve_pct"/></div>
                                <div class="row mt8"><label class="col-lg-5" for="td_energy_pv_kwp"/>
                                    <field name="td_energy_pv_kwp"/></div>
                            </div>
                        </setting>
                    </block>
                    <block title="Повірка" name="td_energy_verify">
                        <setting string="Нагадування про повірку лічильників">
                            <div class="content-group">
                                <div class="row mt8"><label class="col-lg-5" for="td_energy_verify_warn_days"/>
                                    <field name="td_energy_verify_warn_days"/></div>
                            </div>
                        </setting>
                    </block>
                    <block title="АВР і накопичувач" name="td_energy_ats">
                        <setting string="Пуск генератора й зрізання піків">
                            <div class="content-group">
                                <div class="row mt8"><label class="col-lg-5" for="td_energy_ats_fail_start_s"/>
                                    <field name="td_energy_ats_fail_start_s"/></div>
                                <div class="row mt8"><label class="col-lg-5" for="td_energy_peak_shave_kw"/>
                                    <field name="td_energy_peak_shave_kw"/></div>
                            </div>
                        </setting>
                    </block>
                    <block title="Встановлення" name="td_energy_install">
                        <setting string="Стан встановлення">
                            <div class="content-group">
                                <div class="mt8"><field name="td_energy_install_state"/></div>
                                <button name="%(td_energy.action_td_energy_rebind)d" type="action"
                                        string="Повторити прив'язку даних" class="btn-link"
                                        groups="td_factory3d.group_td_admin"/>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_td_energy_settings" model="ir.actions.act_window">
        <field name="name">Налаштування енергетики</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'td_energy'}</field>
    </record>
</odoo>
