<?xml version="1.0" encoding="utf-8"?>
<!-- SPEC §3 V-13; W1_SPEC V-26: стан, заголовок/деталі, виконавець, дії підтвердження -->
<odoo>
    <record id="view_td_energy_event_list" model="ir.ui.view">
        <field name="name">td.energy.event.list</field>
        <field name="model">td.energy.event</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false">
                <header>
                    <button name="action_ack" type="object" string="Підтвердити"/>
                    <button name="action_take" type="object" string="Взяти в роботу"/>
                    <button name="action_resolve" type="object" string="Закрити"/>
                </header>
                <field name="ts"/>
                <field name="level" widget="badge" decoration-muted="level == 'info'"
                       decoration-warning="level == 'warn'" decoration-danger="level == 'bad'"/>
                <field name="state" widget="badge" decoration-danger="state == 'active'"
                       decoration-warning="state == 'acked'" decoration-success="state == 'resolved'"
                       decoration-muted="state == 'na'"/>
                <field name="kind"/>
                <field name="code"/>
                <field name="title"/>
                <field name="detail"/>
                <field name="assigned_user_id" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_td_energy_event_form" model="ir.ui.view">
        <field name="name">td.energy.event.form</field>
        <field name="model">td.energy.event</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <header>
                    <button name="action_ack" type="object" string="Підтвердити" class="btn-primary"
                            invisible="state != 'active'"/>
                    <button name="action_take" type="object" string="Взяти в роботу"
                            invisible="state not in ('active', 'acked')"/>
                    <button name="action_release" type="object" string="Скинути виконавця"
                            invisible="not assigned_user_id or state == 'resolved'"/>
                    <button name="action_resolve" type="object" string="Закрити"
                            invisible="state not in ('active', 'acked')"/>
                    <field name="state" widget="statusbar" statusbar_visible="active,acked,resolved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="title" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="ts"/>
                            <field name="level" widget="badge" decoration-muted="level == 'info'"
                                   decoration-warning="level == 'warn'" decoration-danger="level == 'bad'"/>
                            <field name="kind"/>
                            <field name="code"/>
                            <field name="node_id"/>
                            <field name="signal_id"/>
                            <field name="outage_id"/>
                        </group>
                        <group>
                            <field name="acked_by"/>
                            <field name="acked_at"/>
                            <field name="assigned_user_id"/>
                            <field name="taken_at"/>
                            <field name="resolved_at"/>
                            <field name="request_id"/>
                            <field name="is_backfill"/>
                        </group>
                    </group>
                    <group>
                        <field name="detail"/>
                        <field name="text"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_td_energy_event_search" model="ir.ui.view">
        <field name="name">td.energy.event.search</field>
        <field name="model">td.energy.event</field>
        <field name="arch" type="xml">
            <search>
                <field name="title"/>
                <field name="text"/>
                <field name="code"/>
                <filter name="state_open" string="Активні" domain="[('state', 'in', ('active', 'acked'))]"/>
                <filter name="state_unacked" string="Непідтверджені" domain="[('state', '=', 'active')]"/>
                <filter name="mine" string="Мої" domain="[('assigned_user_id', '=', uid)]"/>
                <separator/>
                <filter name="level_info" string="Інформація" domain="[('level', '=', 'info')]"/>
                <filter name="level_warn" string="Увага" domain="[('level', '=', 'warn')]"/>
                <filter name="level_bad" string="Аварія" domain="[('level', '=', 'bad')]"/>
                <separator/>
                <filter name="kind_threshold" string="Пороги" domain="[('kind', '=', 'threshold')]"/>
                <filter name="kind_balance" string="Баланс" domain="[('kind', '=', 'balance')]"/>
                <filter name="kind_meter" string="Лічильники" domain="[('kind', '=', 'meter')]"/>
                <filter name="kind_trip" string="Спрацювання захисту" domain="[('kind', '=', 'trip')]"/>
                <group>
                    <filter name="group_state" string="Стан" context="{'group_by': 'state'}"/>
                    <filter name="group_kind" string="Вид" context="{'group_by': 'kind'}"/>
                    <filter name="group_node" string="Вузол" context="{'group_by': 'node_id'}"/>
                    <filter name="group_code" string="Код" context="{'group_by': 'code'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_td_energy_event" model="ir.actions.act_window">
        <field name="name">Події</field>
        <field name="res_model">td.energy.event</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_state_open': 1}</field>
    </record>
</odoo>
