<?xml version="1.0" encoding="utf-8"?>
<!-- SPEC §3 V-13 -->
<odoo>
    <record id="view_f3d_energy_event_list" model="ir.ui.view">
        <field name="name">f3d.energy.event.list</field>
        <field name="model">f3d.energy.event</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false">
                <field name="ts"/>
                <field name="level" widget="badge" decoration-muted="level == 'info'"
                       decoration-warning="level == 'warn'" decoration-danger="level == 'bad'"/>
                <field name="kind"/>
                <field name="code"/>
                <field name="text"/>
            </list>
        </field>
    </record>

    <record id="view_f3d_energy_event_search" model="ir.ui.view">
        <field name="name">f3d.energy.event.search</field>
        <field name="model">f3d.energy.event</field>
        <field name="arch" type="xml">
            <search>
                <field name="text"/>
                <field name="code"/>
                <filter name="level_info" string="Інформація" domain="[('level', '=', 'info')]"/>
                <filter name="level_warn" string="Увага" domain="[('level', '=', 'warn')]"/>
                <filter name="level_bad" string="Аварія" domain="[('level', '=', 'bad')]"/>
                <separator/>
                <filter name="kind_threshold" string="Пороги" domain="[('kind', '=', 'threshold')]"/>
                <filter name="kind_balance" string="Баланс" domain="[('kind', '=', 'balance')]"/>
                <filter name="kind_meter" string="Лічильники" domain="[('kind', '=', 'meter')]"/>
                <group>
                    <filter name="group_kind" string="Вид" context="{'group_by': 'kind'}"/>
                    <filter name="group_code" string="Код" context="{'group_by': 'code'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_f3d_energy_event" model="ir.actions.act_window">
        <field name="name">Журнал подій</field>
        <field name="res_model">f3d.energy.event</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
