<?xml version="1.0" encoding="utf-8"?>
<!-- SPEC §4.2 (групи), §4.3 (record rules — W1 додає разом із моделями) -->
<odoo>
    <record id="privilege_td_energy" model="res.groups.privilege">
        <field name="name">Енергетика</field>
        <field name="category_id" ref="td_factory3d.module_category_factory3d"/>
        <field name="sequence">50</field>
    </record>
    <record id="group_td_energy_user" model="res.groups">
        <field name="name">Енергетика: перегляд</field>
        <field name="privilege_id" ref="privilege_td_energy"/>
        <field name="sequence">10</field>
        <field name="implied_ids" eval="[Command.link(ref('td_factory3d.group_td_user'))]"/>
    </record>
    <record id="group_td_energy_cost" model="res.groups">
        <field name="name">Енергетика: вартість</field>
        <field name="privilege_id" ref="privilege_td_energy"/>
        <field name="sequence">20</field>
        <field name="implied_ids" eval="[Command.link(ref('group_td_energy_user'))]"/>
    </record>
    <record id="group_td_energy_manager" model="res.groups">
        <field name="name">Енергетика: енергетик</field>
        <field name="privilege_id" ref="privilege_td_energy"/>
        <field name="sequence">30</field>
        <field name="implied_ids"
               eval="[Command.link(ref('group_td_energy_cost')), Command.link(ref('td_factory3d.group_td_manager'))]"/>
    </record>
    <record id="mrp.group_mrp_user" model="res.groups">
        <field name="implied_ids" eval="[Command.link(ref('group_td_energy_user'))]"/>
    </record>
    <record id="mrp.group_mrp_manager" model="res.groups">
        <field name="implied_ids" eval="[Command.link(ref('group_td_energy_cost'))]"/>
    </record>
    <record id="account.group_account_readonly" model="res.groups">
        <field name="implied_ids" eval="[Command.link(ref('group_td_energy_cost'))]"/>
    </record>
    <record id="account.group_account_invoice" model="res.groups">
        <field name="implied_ids" eval="[Command.link(ref('group_td_energy_cost'))]"/>
    </record>
    <record id="td_factory3d.group_td_admin" model="res.groups">
        <field name="implied_ids" eval="[Command.link(ref('group_td_energy_manager'))]"/>
    </record>

    <!-- §4.3: глобальні правила мультикомпанії. W3 додає td_energy_alloc_rule_company (td.energy.alloc). -->
    <record id="td_energy_node_rule_company" model="ir.rule">
        <field name="name">Енергетика: вузли — компанія</field>
        <field name="model_id" ref="model_td_energy_node"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="td_energy_meter_rule_company" model="ir.rule">
        <field name="name">Енергетика: лічильники — компанія</field>
        <field name="model_id" ref="model_td_energy_meter"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="td_energy_alloc_rule_company" model="ir.rule">
        <field name="name">Енергетика: розподіл — компанія</field>
        <field name="model_id" ref="model_td_energy_alloc"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="td_energy_tariff_rule_company" model="ir.rule">
        <field name="name">Енергетика: тарифи — компанія</field>
        <field name="model_id" ref="model_td_energy_tariff"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
