<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_td_yard_weighing_form" model="ir.ui.view">
        <field name="name">td.yard.weighing.form</field>
        <field name="model">td.yard.weighing</field>
        <field name="arch" type="xml">
            <form string="Зважування">
                <header>
                    <button name="action_assign_selected" type="object" string="Призначити рейсу" class="btn-primary" invisible="state != 'unassigned'" groups="td_yard.group_td_yard_security"/>
                    <button name="action_void" type="object" string="Анулювати" invisible="state == 'void' or not id" confirm="Анулювати зважування?" groups="td_yard.group_td_yard_security"/>
                    <field name="state" widget="statusbar" statusbar_visible="unassigned,assigned,void"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="scale_id" readonly="id" options="{'no_create': True}"/>
                            <field name="ts" readonly="id"/>
                            <field name="kind" readonly="id and state != 'unassigned'"/>
                            <field name="weight_kg" readonly="id"/>
                            <field name="stable" readonly="id"/>
                            <field name="source" readonly="id"/>
                        </group>
                        <group>
                            <field name="visit_id" readonly="id and state != 'unassigned'" options="{'no_create': True}"/>
                            <field name="role"/>
                            <field name="plate"/>
                            <field name="picking_id"/>
                            <field name="user_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Примітка"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_td_yard_weighing_list" model="ir.ui.view">
        <field name="name">td.yard.weighing.list</field>
        <field name="model">td.yard.weighing</field>
        <field name="arch" type="xml">
            <list string="Зважування" decoration-muted="state == 'void'" decoration-danger="state == 'unassigned'">
                <field name="name"/>
                <field name="ts"/>
                <field name="scale_id"/>
                <field name="visit_id"/>
                <field name="plate"/>
                <field name="kind"/>
                <field name="role" optional="show"/>
                <field name="weight_kg" sum="Σ"/>
                <field name="source" optional="show"/>
                <field name="state" widget="badge" decoration-success="state == 'assigned'" decoration-danger="state == 'unassigned'" decoration-muted="state == 'void'"/>
            </list>
        </field>
    </record>

    <record id="view_td_yard_weighing_search" model="ir.ui.view">
        <field name="name">td.yard.weighing.search</field>
        <field name="model">td.yard.weighing</field>
        <field name="arch" type="xml">
            <search string="Зважування">
                <field name="name"/>
                <field name="plate"/>
                <field name="visit_id"/>
                <filter name="unassigned" string="Непризначені" domain="[('state','=','unassigned')]"/>
                <filter name="assigned" string="Призначені" domain="[('state','=','assigned')]"/>
                <filter name="not_void" string="Без анульованих" domain="[('state','!=','void')]"/>
                <separator/>
                <filter name="auto" string="Автоматичні" domain="[('source','=','auto')]"/>
                <filter name="manual" string="Ручні" domain="[('source','=','manual')]"/>
                <group>
                    <filter name="group_scale" string="Ваги" context="{'group_by': 'scale_id'}"/>
                    <filter name="group_state" string="Стан" context="{'group_by': 'state'}"/>
                    <filter name="group_day" string="День" context="{'group_by': 'ts:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_td_yard_weighing" model="ir.actions.act_window">
        <field name="name">Зважування</field>
        <field name="res_model">td.yard.weighing</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_not_void': 1}</field>
    </record>

    <menuitem id="menu_td_yard_weighing" action="action_td_yard_weighing" name="Зважування" parent="menu_td_yard_journals" sequence="20" groups="td_factory3d.group_td_user"/>

    <!-- журнал зважувань на вкладці рейсу -->
    <record id="view_td_yard_visit_form_weighing" model="ir.ui.view">
        <field name="name">td.yard.visit.form.weighing</field>
        <field name="model">td.yard.visit</field>
        <field name="inherit_id" ref="view_td_yard_visit_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='weighing']/group" position="after">
                <field name="weighing_ids" readonly="1">
                    <list>
                        <field name="name"/>
                        <field name="ts"/>
                        <field name="kind"/>
                        <field name="role"/>
                        <field name="weight_kg"/>
                        <field name="source"/>
                        <field name="state" widget="badge" decoration-success="state == 'assigned'" decoration-muted="state == 'void'"/>
                    </list>
                </field>
            </xpath>
        </field>
    </record>
</odoo>
