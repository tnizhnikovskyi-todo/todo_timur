<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_td_yard_booking_form" model="ir.ui.view">
        <field name="name">td.yard.booking.form</field>
        <field name="model">td.yard.booking</field>
        <field name="arch" type="xml">
            <form string="Бронювання воріт">
                <header>
                    <button name="action_confirm" type="object" string="Підтвердити" class="btn-primary" invisible="state != 'requested'" groups="td_yard.group_td_yard_dispatcher"/>
                    <button name="action_cancel" type="object" string="Скасувати" invisible="state == 'cancelled'" groups="td_yard.group_td_yard_dispatcher"/>
                    <button name="action_reset" type="object" string="Повернути в запит" invisible="state != 'cancelled'" groups="td_yard.group_td_yard_dispatcher"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert" invisible="not warning">
                        <field name="warning" nolabel="1"/>
                    </div>
                    <group>
                        <group>
                            <field name="visit_id" context="{'default_visit_type': 'incoming'}"/>
                            <field name="side_hint" invisible="1"/>
                            <field name="dock_id" domain="[('td_kind','=','dock')] + ([('td_side','=', side_hint)] if side_hint else [])"/>
                            <field name="slot_start"/>
                            <field name="slot_end"/>
                            <field name="duration_min"/>
                            <field name="source"/>
                            <field name="day"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Рейс">
                            <field name="partner_id"/>
                            <field name="plate"/>
                            <field name="batch_id"/>
                            <field name="visit_state"/>
                        </group>
                    </group>
                    <field name="note"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_td_yard_booking_list" model="ir.ui.view">
        <field name="name">td.yard.booking.list</field>
        <field name="model">td.yard.booking</field>
        <field name="arch" type="xml">
            <list string="Бронювання воріт" decoration-muted="state == 'cancelled'" decoration-warning="state == 'requested'">
                <field name="name"/>
                <field name="day"/>
                <field name="dock_id"/>
                <field name="slot_start"/>
                <field name="slot_end"/>
                <field name="visit_id"/>
                <field name="partner_id"/>
                <field name="plate"/>
                <field name="source"/>
                <field name="state" widget="badge" decoration-success="state == 'confirmed'" decoration-warning="state == 'requested'" decoration-muted="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="view_td_yard_booking_calendar" model="ir.ui.view">
        <field name="name">td.yard.booking.calendar</field>
        <field name="model">td.yard.booking</field>
        <field name="arch" type="xml">
            <calendar string="Бронювання воріт" date_start="slot_start" date_stop="slot_end" color="dock_id" mode="day" quick_create="0" event_open_popup="1">
                <field name="visit_id"/>
                <field name="plate"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <record id="view_td_yard_booking_search" model="ir.ui.view">
        <field name="name">td.yard.booking.search</field>
        <field name="model">td.yard.booking</field>
        <field name="arch" type="xml">
            <search string="Бронювання воріт">
                <field name="dock_id"/>
                <field name="visit_id"/>
                <field name="partner_id"/>
                <filter name="confirmed" string="Підтверджені" domain="[('state','=','confirmed')]"/>
                <filter name="requested" string="Запити" domain="[('state','=','requested')]"/>
                <filter name="today" string="Сьогодні" domain="[('is_today','=',True)]"/>
                <filter name="west" string="Захід" domain="[('side','=','west')]"/>
                <filter name="east" string="Схід" domain="[('side','=','east')]"/>
                <group>
                    <filter name="group_dock" string="Ворота" context="{'group_by': 'dock_id'}"/>
                    <filter name="group_side" string="Сторона" context="{'group_by': 'side'}"/>
                    <filter name="group_source" string="Джерело" context="{'group_by': 'source'}"/>
                    <filter name="group_state" string="Стан" context="{'group_by': 'state'}"/>
                    <filter name="group_day" string="День" context="{'group_by': 'day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- DEC-1: gantt-представлення додає міст td_yard_gantt -->
    <record id="action_td_yard_booking" model="ir.actions.act_window">
        <field name="name">Бронювання воріт</field>
        <field name="res_model">td.yard.booking</field>
        <field name="view_mode">calendar,list,form</field>
        <field name="context">{'search_default_confirmed': 1, 'search_default_requested': 1}</field>
    </record>
</odoo>
