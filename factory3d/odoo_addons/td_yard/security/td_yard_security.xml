<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="privilege_td_yard" model="res.groups.privilege">
        <field name="name">Двір</field>
        <field name="category_id" ref="td_factory3d.module_category_factory3d"/>
        <field name="sequence">60</field>
    </record>
    <record id="group_td_yard_security" model="res.groups">
        <field name="name">Охорона КПП</field>
        <field name="privilege_id" ref="privilege_td_yard"/>
        <field name="sequence">10</field>
        <field name="implied_ids" eval="[Command.link(ref('td_factory3d.group_td_user'))]"/>
    </record>
    <record id="group_td_yard_dispatcher" model="res.groups">
        <field name="name">Диспетчер двору</field>
        <field name="privilege_id" ref="privilege_td_yard"/>
        <field name="sequence">20</field>
        <field name="implied_ids" eval="[Command.link(ref('group_td_yard_security')), Command.link(ref('stock.group_stock_user'))]"/>
    </record>
    <record id="group_td_yard_manager" model="res.groups">
        <field name="name">Менеджер двору</field>
        <field name="privilege_id" ref="privilege_td_yard"/>
        <field name="sequence">30</field>
        <field name="implied_ids" eval="[Command.link(ref('group_td_yard_dispatcher')), Command.link(ref('td_factory3d.group_td_manager'))]"/>
    </record>
    <record id="td_factory3d.group_td_admin" model="res.groups">
        <field name="implied_ids" eval="[Command.link(ref('group_td_yard_manager'))]"/>
    </record>
    <record id="td_yard_visit_rule_company" model="ir.rule">
        <field name="name">Двір: visit — компанія</field>
        <field name="model_id" ref="model_td_yard_visit"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="td_yard_booking_rule_company" model="ir.rule">
        <field name="name">Двір: booking — компанія</field>
        <field name="model_id" ref="model_td_yard_booking"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="td_yard_gate_rule_company" model="ir.rule">
        <field name="name">Двір: gate — компанія</field>
        <field name="model_id" ref="model_td_yard_gate"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="td_yard_scale_rule_company" model="ir.rule">
        <field name="name">Двір: scale — компанія</field>
        <field name="model_id" ref="model_td_yard_scale"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="td_yard_weighing_rule_company" model="ir.rule">
        <field name="name">Двір: weighing — компанія</field>
        <field name="model_id" ref="model_td_yard_weighing"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="td_yard_lpr_event_rule_company" model="ir.rule">
        <field name="name">Двір: lpr_event — компанія</field>
        <field name="model_id" ref="model_td_yard_lpr_event"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
