<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_td_yard_reject_wizard_form" model="ir.ui.view">
        <field name="name">td.yard.reject.wizard.form</field>
        <field name="model">td.yard.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Відхилити рейс">
                <group>
                    <field name="visit_id" invisible="not visit_id"/>
                    <field name="reason_code" widget="radio"/>
                    <field name="reason"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Відхилити" class="btn-danger"/>
                    <button string="Скасувати" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
