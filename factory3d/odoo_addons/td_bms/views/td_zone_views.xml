<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_td_zone_form_bms" model="ir.ui.view">
        <field name="name">td.zone.form.bms</field>
        <field name="model">td.zone</field>
        <field name="inherit_id" ref="td_factory3d.view_td_zone_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="f3d_bms" string="Будівля"
                      invisible="not td_light_group_ids and not td_hvac_unit_ids">
                    <field name="td_light_group_ids" readonly="1">
                        <list>
                            <field name="code"/>
                            <field name="e_norm"/>
                            <field name="e_calc"/>
                            <field name="level_pct"/>
                            <field name="e_now"/>
                            <field name="deviation"/>
                        </list>
                    </field>
                    <field name="td_hvac_unit_ids" readonly="1">
                        <list>
                            <field name="code"/>
                            <field name="mode_label"/>
                            <field name="airflow_m3h"/>
                            <field name="filter_dp_pa"/>
                            <field name="deviation"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
