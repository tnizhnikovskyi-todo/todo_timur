<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_td_bms_light_scene_list" model="ir.ui.view">
        <field name="name">td.bms.light.scene.list</field>
        <field name="model">td.bms.light.scene</field>
        <field name="arch" type="xml">
            <list string="Сцени DALI" editable="bottom">
                <field name="block"/>
                <field name="number"/>
                <field name="name"/>
                <field name="level_pct"/>
                <field name="note"/>
            </list>
        </field>
    </record>

    <record id="action_td_bms_light_scene" model="ir.actions.act_window">
        <field name="name">Сцени DALI</field>
        <field name="res_model">td.bms.light.scene</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
