<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_f3d_bms_light_scene_list" model="ir.ui.view">
        <field name="name">f3d.bms.light.scene.list</field>
        <field name="model">f3d.bms.light.scene</field>
        <field name="arch" type="xml">
            <list string="Сцени DALI" editable="bottom">
                <field name="block"/>
                <field name="number"/>
                <field name="name"/>
                <field name="level_pct"/>
                <field name="note"/>
            </list>
        </field>
    </record>

    <record id="action_f3d_bms_light_scene" model="ir.actions.act_window">
        <field name="name">Сцени DALI</field>
        <field name="res_model">f3d.bms.light.scene</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
