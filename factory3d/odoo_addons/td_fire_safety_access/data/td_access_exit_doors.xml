<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Двері аварійних виходів EX-* у СКУД: код дверей = код виходу td.fire.exit, biostar_id 11…21 (як catalog/evac_routes.json
         емулятора, doors). Вхід персоналу EX-IN — турнікет TURN-1 (td.fire.exit.point_code). Напрямок проходу — `tna_key=2` на
         ACR-IN (вихід). Периметр: проходи створюють і закривають відмітки, а під час навчання не закривають (R-05). -->
    <record id="door_ex_s1" model="td.access.door">
        <field name="code">EX-S1</field>
        <field name="name">Аварійний вихід EX-S1 (СКУД)</field>
        <field name="kind">door</field>
        <field name="server_id" ref="td_access.server_biostar_sim"/>
        <field name="biostar_id">11</field>
        <field name="zone_from_id" ref="td_factory3d.zone_z_kpp"/>
        <field name="zone_to_id" ref="td_factory3d.zone_z_asm"/>
        <field name="is_perimeter" eval="True"/>
        <field name="dwell_min">0</field>
    </record>
