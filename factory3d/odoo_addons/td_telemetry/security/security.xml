<?xml version="1.0" encoding="utf-8"?>
<!-- SPEC §4.3 -->
<odoo>
    <record id="f3d_reading_rule_all" model="ir.rule">
        <field name="name">f3d.reading: усі (без компанії)</field>
        <field name="model_id" ref="model_f3d_reading"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="global" eval="True"/>
    </record>
    <record id="f3d_command_rule_own_or_manager" model="ir.rule">
        <field name="name">f3d.command: власні або модульні</field>
        <field name="model_id" ref="model_f3d_command"/>
        <field name="domain_force">['|', ('requested_by', '=', user.id), ('signal_id.module', '!=', False)]</field>
        <field name="groups" eval="[(4, ref('factory3d_base.group_f3d_user'))]"/>
    </record>
</odoo>
