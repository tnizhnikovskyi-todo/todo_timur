<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_td_source_list" model="ir.ui.view">
        <field name="name">td.source.list</field>
        <field name="model">td.source</field>
        <field name="arch" type="xml">
            <list string="Джерела" decoration-success="state == 'online'" decoration-danger="state == 'error'"
                  decoration-warning="state == 'offline'" decoration-muted="state in ('disabled', 'unknown')">
                <field name="code"/>
                <field name="name"/>
                <field name="type"/>
                <field name="collector_id"/>
                <field name="state" widget="badge"/>
                <field name="read_enabled" widget="boolean_toggle" groups="td_factory3d.group_td_manager"/>
                <field name="write_enabled" widget="boolean_toggle" groups="td_factory3d.group_td_manager"/>
                <field name="signal_count"/>
                <field name="alarm_count"/>
                <field name="stale_count"/>
                <field name="last_ok"/>
                <field name="last_error" optional="hide"/>
                <field name="module" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_td_source_form" model="ir.ui.view">
        <field name="name">td.source.form</field>
        <field name="model">td.source</field>
        <field name="arch" type="xml">
            <form string="Джерело даних">
                <header>
                    <button name="action_test_params" type="object" string="Перевірити параметри"/>
                    <button name="action_view_signals" type="object" string="Сигнали"/>
                    <field name="state" widget="statusbar" statusbar_visible="unknown,online,offline,error,disabled"/>
                </header>
                <sheet>
                    <field name="is_local" invisible="1"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_signals" type="object" class="oe_stat_button" icon="fa-rss">
                            <field name="signal_count" widget="statinfo" string="Сигнали"/>
                        </button>
                        <button name="action_view_signals" type="object" class="oe_stat_button text-danger"
                                icon="fa-bell">
                            <field name="alarm_count" widget="statinfo" string="Тривог"/>
                        </button>
                        <button name="action_view_signals" type="object" class="oe_stat_button" icon="fa-clock-o">
                            <field name="stale_count" widget="statinfo" string="Без даних"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Назва джерела"/></h1>
                    </div>
                    <group>
                        <group string="Джерело">
                            <field name="code"/>
                            <field name="type"/>
                            <field name="collector_id" required="not is_local"/>
                            <field name="equipment_id"/>
                            <field name="module"/>
                            <field name="active"/>
                        </group>
                        <group string="Прапори">
                            <field name="read_enabled"/>
                            <field name="write_enabled" invisible="type == 'http_push'"/>
                            <field name="period_s_default"/>
                        </group>
                        <group string="Стан">
                            <field name="last_ok" readonly="1"/>
                            <field name="last_error" readonly="1"/>
                            <field name="error_count" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Параметри" name="params">
                            <field name="params_text" widget="ace" options="{'mode': 'javascript'}"/>
                            <div class="text-muted" invisible="type != 'modbus_tcp'">
                                Приклад: {"host": "iot-sim", "port": 502, "unit": 70, "timeout_s": 3, "retries": 2}
                            </div>
                            <div class="text-muted" invisible="type != 'mqtt'">
                                Приклад: {"host": "mosquitto", "port": 1883, "username": "collector",
                                "password_ref": "F3D_MQTT_PASSWORD", "client_id": "f3d-collector",
                                "topics": ["f3d/mobile/+/telemetry"]}
                            </div>
                            <div class="text-muted" invisible="type != 'http_push'">
                                Приклад: {"routes": ["lpr"], "allow_ips": ["iot-sim"]}
                            </div>
                            <div class="text-muted" invisible="type != 'bacnet_ip'">
                                Приклад: {"host": "iot-sim", "port": 47808, "device": 140, "timeout_s": 5}
                            </div>
                            <div class="text-muted" invisible="type != 'opcua'">
                                Приклад: {"endpoint": "opc.tcp://iot-sim:4840/f3d/", "security_mode": "None"}
                            </div>
                            <div class="text-muted" invisible="type != 'helvarnet'">
                                Приклад: {"host": "iot-sim", "port": 50000, "protocol": "tcp"}
                            </div>
                            <div class="text-muted" invisible="type != 'sics'">
                                Приклад: {"host": "iot-sim", "port": 4001}
                            </div>
                            <div class="text-muted" invisible="type != 'rest_vendor'">
                                Приклад: {"base_url": "http://iot-sim:8082", "auth": "api_key", "key_ref": "F3D_WOODSTORE_KEY"}
                            </div>
                            <div class="text-muted">Секрети в Odoo не зберігаються: використовуйте ключі *_ref (ім'я змінної середовища колектора).</div>
                        </page>
                        <page string="Сигнали" name="signals">
                            <field name="signal_ids">
                                <list editable="bottom">
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="kind"/>
                                    <field name="unit"/>
                                    <field name="period_s"/>
                                    <field name="status" widget="badge"/>
                                    <field name="last_value"/>
                                    <field name="last_ts"/>
                                </list>
                            </field>
                        </page>
                        <page string="Статистика" name="stats">
                            <field name="stats" widget="json" readonly="1"/>
                        </page>
                        <page string="Примітка" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_td_source_kanban" model="ir.ui.view">
        <field name="name">td.source.kanban</field>
        <field name="model">td.source</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" quick_create="false" class="o_kanban_small_column">
                <field name="alarm_count"/>
                <field name="stale_count"/>
                <templates>
                    <t t-name="card">
                        <div class="fw-bold"><field name="name"/></div>
                        <div class="text-muted"><field name="code"/> · <field name="type"/></div>
                        <div><field name="collector_id"/></div>
                        <div>
                            <span class="badge text-bg-secondary me-1"><field name="signal_count"/> сигн.</span>
                            <span t-if="record.alarm_count.raw_value > 0" class="badge text-bg-danger me-1">
                                <field name="alarm_count"/> трив.</span>
                            <span t-if="record.stale_count.raw_value > 0" class="badge text-bg-secondary">
                                <field name="stale_count"/> без даних</span>
                        </div>
                        <div class="text-muted"><field name="last_ok"/></div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_td_source_search" model="ir.ui.view">
        <field name="name">td.source.search</field>
        <field name="model">td.source</field>
        <field name="arch" type="xml">
            <search string="Джерела">
                <field name="name" string="Джерело" filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]"/>
                <field name="code"/>
                <field name="collector_id"/>
                <field name="equipment_id"/>
                <filter name="online" string="Онлайн" domain="[('state', '=', 'online')]"/>
                <filter name="offline_error" string="Офлайн/помилка" domain="[('state', 'in', ('offline', 'error'))]"/>
                <filter name="with_alarms" string="З тривогами" domain="[('signal_ids.status', '=', 'alarm')]"/>
                <filter name="disabled" string="Вимкнені" domain="[('read_enabled', '=', False)]"/>
                <filter name="inactive" string="Архівні" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_type" string="Тип" context="{'group_by': 'type'}"/>
                    <filter name="group_collector" string="Колектор" context="{'group_by': 'collector_id'}"/>
                    <filter name="group_module" string="Модуль" context="{'group_by': 'module'}"/>
                    <filter name="group_state" string="Стан" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_td_source_overview" model="ir.actions.act_window">
        <field name="name">Огляд</field>
        <field name="res_model">td.source</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_group_state': 1}</field>
    </record>

    <record id="action_td_source" model="ir.actions.act_window">
        <field name="name">Джерела</field>
        <field name="res_model">td.source</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
</odoo>
