<?xml version="1.0" encoding="utf-8"?>
<!-- SPEC §5.3: дія «Повторити міграцію рівня 0» (права адміністратора перевіряє f3d_run_migration). -->
<odoo>
    <record id="action_f3d_run_migration" model="ir.actions.server">
        <field name="name">Повторити міграцію рівня 0</field>
        <field name="model_id" ref="model_f3d_signal"/>
        <field name="state">code</field>
        <field name="code">action = env['f3d.signal'].f3d_run_migration()</field>
        <field name="group_ids" eval="[(4, ref('factory3d_base.group_f3d_admin'))]"/>
    </record>
</odoo>
