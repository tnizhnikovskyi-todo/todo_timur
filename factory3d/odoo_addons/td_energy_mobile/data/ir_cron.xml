<?xml version="1.0" encoding="utf-8"?>
<!-- 3 крони обходів (SPEC H.6): user_id = OdooBot, збій не зупиняє крон (try/except у методах), без read_enabled не діють. -->
<odoo noupdate="1">
    <record id="cron_td_energy_round_open" model="ir.cron">
        <field name="name">Енергетика: відкриття обходів</field>
        <field name="model_id" ref="model_td_energy_round"/>
        <field name="state">code</field>
        <field name="code">model._cron_open()</field>
        <field name="interval_number">10</field>
        <field name="interval_type">minutes</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="active" eval="True"/>
    </record>
    <record id="cron_td_energy_round_close" model="ir.cron">
        <field name="name">Енергетика: закриття обходів</field>
        <field name="model_id" ref="model_td_energy_round"/>
        <field name="state">code</field>
        <field name="code">model._cron_close()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="active" eval="True"/>
    </record>
    <record id="cron_td_energy_round_rotate" model="ir.cron">
        <field name="name">Енергетика: ротація обходів</field>
        <field name="model_id" ref="model_td_energy_round"/>
        <field name="state">code</field>
        <field name="code">model._cron_rotate()</field>
        <field name="interval_number">7</field>
        <field name="interval_type">days</field>
        <!-- неділя 03:40 за Києвом ≈ 00:40 UTC (літній час 00:40, зимовий 01:40): найближча неділя -->
        <field name="nextcall"
               eval="(datetime.now() + relativedelta(weekday=6, hour=0, minute=40, second=0, microsecond=0)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="user_id" ref="base.user_root"/>
        <field name="active" eval="True"/>
    </record>
</odoo>
