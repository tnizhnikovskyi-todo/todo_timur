<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_f3d_sim_fault_wizard_form" model="ir.ui.view">
    <field name="name">f3d.sim.fault.wizard.form</field>
    <field name="model">f3d.sim.fault.wizard</field>
    <field name="arch" type="xml">
      <form string="Поставити збій">
        <group>
          <field name="device_id" readonly="1"/>
          <field name="reason"/>
          <field name="note"/>
        </group>
        <footer>
          <button name="action_confirm" type="object" string="Поставити збій" class="btn-primary"/>
          <button string="Скасувати" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="view_f3d_sim_run_wizard_form" model="ir.ui.view">
    <field name="name">f3d.sim.run.wizard.form</field>
    <field name="model">f3d.sim.run.wizard</field>
    <field name="arch" type="xml">
      <form string="Запуск сценарію">
        <field name="has_device" invisible="1"/>
        <field name="has_zone" invisible="1"/>
        <group>
          <field name="scenario_id" readonly="1"/>
          <field name="device_id" invisible="not has_device"/>
          <field name="zone_id" invisible="not has_zone"/>
          <field name="params_text" widget="ace" options="{'mode': 'json'}"/>
        </group>
        <footer>
          <button name="action_confirm" type="object" string="Запустити" class="btn-primary"/>
          <button string="Скасувати" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>
</odoo>
