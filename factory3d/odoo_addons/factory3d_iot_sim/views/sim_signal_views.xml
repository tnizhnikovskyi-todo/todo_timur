<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_f3d_sim_signal_list" model="ir.ui.view">
    <field name="name">f3d.sim.signal.list</field>
    <field name="model">f3d.sim.signal</field>
    <field name="arch" type="xml">
      <list string="Каталог сигналів" create="false"
            decoration-danger="last_status == 'alarm'" decoration-warning="last_status == 'warn'"
            decoration-muted="last_status == 'stale'">
        <field name="code"/>
        <field name="device_id"/>
        <field name="protocol"/>
        <field name="address"/>
        <field name="dtype"/>
        <field name="unit"/>
        <field name="scale" optional="hide"/>
        <field name="nominal" optional="hide"/>
        <field name="thresholds" optional="hide"/>
        <field name="model_rule" optional="hide"/>
        <field name="origin"/>
        <field name="last_value"/>
        <field name="last_status"/>
        <field name="last_ts"/>
      </list>
    </field>
  </record>

  <record id="view_f3d_sim_signal_form" model="ir.ui.view">
    <field name="name">f3d.sim.signal.form</field>
    <field name="model">f3d.sim.signal</field>
    <field name="arch" type="xml">
      <form string="Сигнал" create="false" edit="false">
        <header>
          <button name="action_read_now" type="object" string="Прочитати зараз"
                  invisible="protocol == 'none'"/>
        </header>
        <sheet>
          <group>
            <group>
              <field name="code"/>
              <field name="name"/>
              <field name="device_id"/>
              <field name="protocol"/>
              <field name="address"/>
              <field name="dtype"/>
              <field name="unit"/>
              <field name="kind"/>
            </group>
            <group>
              <field name="scale"/>
              <field name="nominal"/>
              <field name="thresholds"/>
              <field name="model_rule"/>
              <field name="origin"/>
              <field name="level0_code"/>
              <field name="level0_value"/>
              <field name="last_value"/>
              <field name="last_status"/>
              <field name="last_ts"/>
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_f3d_sim_signal_search" model="ir.ui.view">
    <field name="name">f3d.sim.signal.search</field>
    <field name="model">f3d.sim.signal</field>
    <field name="arch" type="xml">
      <search string="Сигнали">
        <field name="code"/>
        <field name="device_id"/>
        <field name="address"/>
        <filter name="filter_mock" string="Макет" domain="[('origin', '=', 'mock')]"/>
        <filter name="filter_new" string="Нові" domain="[('origin', '=', 'new')]"/>
        <filter name="filter_alarm" string="Тривога" domain="[('last_status', '=', 'alarm')]"/>
        <group>
          <filter name="group_device" string="Пристрій" context="{'group_by': 'device_id'}"/>
          <filter name="group_protocol" string="Протокол" context="{'group_by': 'protocol'}"/>
          <filter name="group_origin" string="Походження" context="{'group_by': 'origin'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="action_f3d_sim_signal" model="ir.actions.act_window">
    <field name="name">Каталог сигналів</field>
    <field name="res_model">f3d.sim.signal</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>
