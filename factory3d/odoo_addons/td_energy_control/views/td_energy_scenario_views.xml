<?xml version="1.0" encoding="utf-8"?>
<!-- V-37 сценарії автоматики (M-29). Включення/вимкнення — екран «Керування» (клас B), тут лише перегляд. Власник: B -->
<odoo>
    <record id="view_td_energy_scenario_list" model="ir.ui.view">
        <field name="name">td.energy.scenario.list</field>
        <field name="model">td.energy.scenario</field>
        <field name="arch" type="xml">
            <list create="0" delete="0">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="enabled" widget="boolean"/>
                <field name="engine_state" widget="badge" decoration-success="engine_state == 'active'"
                       decoration-info="engine_state == 'armed'" decoration-warning="engine_state == 'warn'"
                       decoration-muted="engine_state in ('off', 'unknown')"/>
                <field name="applied" widget="boolean"/>
                <field name="engine_ts"/>
            </list>
        </field>
    </record>

    <record id="view_td_energy_scenario_form" model="ir.ui.view">
        <field name="name">td.energy.scenario.form</field>
        <field name="model">td.energy.scenario</field>
        <field name="arch" type="xml">
            <form create="0" delete="0" duplicate="0">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" readonly="1"/>
                            <field name="enabled" readonly="1"/>
                            <field name="engine_state" readonly="1"/>
                            <field name="applied" readonly="1"/>
                            <field name="state_signal_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="config_version" readonly="1"/>
                            <field name="engine_ts" readonly="1"/>
                            <field name="changed_by" readonly="1"/>
                            <field name="changed_at" readonly="1"/>
                        </group>
                    </group>
                    <group string="Опис">
                        <field name="description" readonly="1" nolabel="1" colspan="2"/>
                    </group>
                    <group string="Параметри (JSON)">
                        <field name="params_text" nolabel="1" colspan="2" groups="td_factory3d.group_td_admin"/>
                        <field name="params_text" nolabel="1" colspan="2" readonly="1" groups="!td_factory3d.group_td_admin"/>
                    </group>
                    <group string="Факти рушія (JSON)">
                        <field name="engine_facts" widget="json" readonly="1" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_td_energy_scenario" model="ir.actions.act_window">
        <field name="name">Сценарії автоматики</field>
        <field name="res_model">td.energy.scenario</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
