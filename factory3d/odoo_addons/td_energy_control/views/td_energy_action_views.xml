<?xml version="1.0" encoding="utf-8"?>
<!-- V-41 журнал команд і дій (M-33): лише читання; дії створює модуль (prepare/confirm). Власник: B.
     Кнопки форми «Підтвердити (2/2)», «Скасувати», «Скасувати дію» потребують публічних методів моделі
     `action_confirm_second`, `action_cancel`, `action_undo` (їх немає в M-33 — див. звіт W2-B). -->
<odoo>
    <record id="view_td_energy_action_list" model="ir.ui.view">
        <field name="name">td.energy.action.list</field>
        <field name="model">td.energy.action</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="create_date"/>
                <field name="name"/>
                <field name="summary"/>
                <field name="kind_code" optional="hide"/>
                <field name="origin"/>
                <field name="cls" widget="badge" decoration-info="cls == 'A'" decoration-warning="cls == 'B'"/>
                <field name="state" widget="badge" decoration-success="state == 'done'"
                       decoration-info="state in ('executing', 'sent', 'queued')" decoration-warning="state == 'awaiting_second'"
                       decoration-danger="state in ('failed', 'blocked')" decoration-muted="state in ('expired', 'cancelled')"/>
                <field name="prepared_by"/>
                <field name="confirmed_by"/>
                <field name="second_by"/>
                <field name="result_text"/>
            </list>
        </field>
    </record>

    <record id="view_td_energy_action_form" model="ir.ui.view">
        <field name="name">td.energy.action.form</field>
        <field name="model">td.energy.action</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0" duplicate="0">
                <header>
                    <field name="undo_available" invisible="1"/>
                    <button name="action_confirm_second" type="object" string="Підтвердити (2/2)" class="btn-primary"
                            invisible="state != 'awaiting_second'" groups="td_energy.group_td_energy_manager"/>
                    <button name="action_cancel" type="object" string="Скасувати"
                            invisible="state not in ('prepared', 'awaiting_second', 'queued')"
                            groups="td_energy.group_td_energy_manager"/>
                    <button name="action_undo" type="object" string="Скасувати дію"
                            invisible="state != 'done' or not undo_available"
                            confirm="Виконати зворотну дію?" groups="td_energy.group_td_energy_manager"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="prepared,awaiting_second,queued,executing,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                        <h2><field name="summary"/></h2>
                    </div>
                    <group string="Дія">
                        <group>
                            <field name="kind_id"/>
                            <field name="kind_code"/>
                            <field name="origin"/>
                            <field name="cls"/>
                            <field name="node_id"/>
                            <field name="scenario_id" invisible="not scenario_id"/>
                            <field name="advice_id" invisible="not advice_id"/>
                        </group>
                        <group>
                            <field name="detail"/>
                            <field name="needs_second"/>
                            <field name="undo_available"/>
                            <field name="undo_of_id" invisible="not undo_of_id"/>
                            <field name="undone_by_id" invisible="not undone_by_id"/>
                            <field name="command_id" invisible="not command_id"/>
                        </group>
                    </group>
                    <group string="Параметри (JSON)">
                        <field name="params" widget="json" nolabel="1" colspan="2"/>
                    </group>
                    <group string="Перевірки Odoo (JSON)">
                        <field name="checks" widget="json" nolabel="1" colspan="2"/>
                    </group>
                    <group string="Перевірки збирача (JSON)">
                        <field name="collector_checks" widget="json" nolabel="1" colspan="2"/>
                    </group>
                    <group string="Підтвердження">
                        <group>
                            <field name="prepared_by"/>
                            <field name="prepared_at"/>
                            <field name="confirmed_by"/>
                            <field name="confirmed_at"/>
                        </group>
                        <group>
                            <field name="second_by"/>
                            <field name="second_at"/>
                            <field name="second_expires_at"/>
                            <field name="token_expires_at"/>
                        </group>
                    </group>
                    <group string="Результат">
                        <group>
                            <field name="result_text"/>
                            <field name="error"/>
                            <field name="actor_text"/>
                        </group>
                        <group>
                            <field name="started_at"/>
                            <field name="finished_at"/>
                            <field name="step"/>
                            <field name="steps_total"/>
                            <field name="config_version"/>
                            <field name="applied"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_td_energy_action_search" model="ir.ui.view">
        <field name="name">td.energy.action.search</field>
        <field name="model">td.energy.action</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="summary"/>
                <field name="kind_code"/>
                <field name="node_id"/>
                <field name="prepared_by"/>
                <filter name="mine" string="Мої" domain="[('prepared_by', '=', uid)]"/>
                <filter name="awaiting_second" string="Очікують підтвердження" domain="[('state', '=', 'awaiting_second')]"/>
                <filter name="errors" string="Помилки" domain="[('state', 'in', ('failed', 'blocked', 'expired'))]"/>
                <filter name="auto" string="Автоматика" domain="[('origin', '=', 'auto')]"/>
                <filter name="today" string="Сьогодні"
                        domain="[('create_date', '>=', datetime.datetime.combine(context_today(), datetime.time(0, 0, 0)))]"/>
                <group>
                    <filter name="group_origin" string="Джерело" context="{'group_by': 'origin'}"/>
                    <filter name="group_state" string="Стан" context="{'group_by': 'state'}"/>
                    <filter name="group_kind" string="Вид команди" context="{'group_by': 'kind_code'}"/>
                    <filter name="group_node" string="Вузол" context="{'group_by': 'node_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_td_energy_action_pivot" model="ir.ui.view">
        <field name="name">td.energy.action.pivot</field>
        <field name="model">td.energy.action</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="kind_code" type="row"/>
                <field name="state" type="col"/>
                <field name="id" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_td_energy_action" model="ir.actions.act_window">
        <field name="name">Журнал команд</field>
        <field name="res_model">td.energy.action</field>
        <field name="view_mode">list,form,pivot</field>
        <field name="search_view_id" ref="view_td_energy_action_search"/>
    </record>
</odoo>
