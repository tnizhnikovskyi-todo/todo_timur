<?xml version="1.0" encoding="utf-8"?>
<!-- V-40 реєстр блокувань (M-32): редагування — адміністратор (ACL). Власник: B -->
<odoo>
    <record id="view_td_energy_interlock_list" model="ir.ui.view">
        <field name="name">td.energy.interlock.list</field>
        <field name="model">td.energy.interlock</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="hard"/>
                <field name="fail_closed"/>
                <field name="where"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_td_energy_interlock_form" model="ir.ui.view">
        <field name="name">td.energy.interlock.form</field>
        <field name="model">td.energy.interlock</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="hard"/>
                            <field name="fail_closed"/>
                            <field name="where"/>
                        </group>
                    </group>
                    <group string="Пороги (JSON)">
                        <field name="params" widget="json" nolabel="1" colspan="2"/>
                    </group>
                    <group string="Входи (JSON)">
                        <field name="inputs" widget="json" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_td_energy_interlock" model="ir.actions.act_window">
        <field name="name">Блокування</field>
        <field name="res_model">td.energy.interlock</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
