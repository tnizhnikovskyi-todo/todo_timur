<?xml version="1.0" encoding="utf-8"?>
<!-- V-42 слоти розкладу (M-34): ручні слоти редагує «Головний енергетик» (ACL); план (`plan`) будує система. Власник: B -->
<odoo>
    <record id="view_td_energy_schedule_slot_list" model="ir.ui.view">
        <field name="name">td.energy.schedule.slot.list</field>
        <field name="model">td.energy.schedule.slot</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <header>
                    <button name="action_rebuild_plan" type="object" string="Перебудувати план" display="always"
                            groups="td_energy.group_td_energy_chief"/>
                </header>
                <field name="resource"/>
                <field name="date"/>
                <field name="weekdays"/>
                <field name="time_from" widget="float_time"/>
                <field name="time_to" widget="float_time"/>
                <field name="mode"/>
                <field name="label"/>
                <field name="setpoint_kw"/>
                <field name="source" widget="badge" decoration-info="source == 'plan'" decoration-success="source == 'manual'"
                       decoration-warning="source == 'genset'"/>
                <field name="executes" readonly="1"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_td_energy_schedule_slot_form" model="ir.ui.view">
        <field name="name">td.energy.schedule.slot.form</field>
        <field name="model">td.energy.schedule.slot</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="resource"/>
                            <field name="mode"/>
                            <field name="label"/>
                            <field name="setpoint_kw"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="weekdays" invisible="date"/>
                            <field name="time_from" widget="float_time"/>
                            <field name="time_to" widget="float_time"/>
                            <field name="source" readonly="1"/>
                            <field name="executes" readonly="1"/>
                            <field name="scenario_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_td_energy_schedule_slot_search" model="ir.ui.view">
        <field name="name">td.energy.schedule.slot.search</field>
        <field name="model">td.energy.schedule.slot</field>
        <field name="arch" type="xml">
            <search>
                <field name="resource"/>
                <field name="label"/>
                <filter name="plan" string="План" domain="[('source', '=', 'plan')]"/>
                <filter name="manual" string="Вручну" domain="[('source', '=', 'manual')]"/>
                <group>
                    <filter name="group_resource" string="Ресурс" context="{'group_by': 'resource'}"/>
                    <filter name="group_source" string="Джерело" context="{'group_by': 'source'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_td_energy_schedule_slot" model="ir.actions.act_window">
        <field name="name">Розклад (слоти)</field>
        <field name="res_model">td.energy.schedule.slot</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_td_energy_schedule_slot_search"/>
    </record>
</odoo>
