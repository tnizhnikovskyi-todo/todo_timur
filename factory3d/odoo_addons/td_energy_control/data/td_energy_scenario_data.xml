<?xml version="1.0" encoding="utf-8"?>
<!-- SPEC 5.2: 6 сценаріїв (noupdate; тексти й параметри макета Control.dc.html) -->
<odoo noupdate="1">
    <record id="scenario_peak" model="td.energy.scenario">
        <field name="code">peak</field>
        <field name="name">Зрізання піку</field>
        <field name="description">Тримати імпорт нижче уставки: спершу розряд BESS, потім пуск КГУ, далі відключення за пріоритетами.</field>
        <field name="sequence">10</field>
        <field name="enabled" eval="True"/>
        <field name="params" eval="{'limit_kw': 760, 'activate_margin_kw': 30, 'margin_kw': 20, 'release_margin_kw': 40, 'release_hold_s': 180, 'stage_delay_s': 60, 'bess_max_kw': 100, 'bess_min_soc_pct': 30, 'chp_allowed': True, 'shed_allowed': True}"/>
    </record>
    <record id="scenario_self" model="td.energy.scenario">
        <field name="code">self</field>
        <field name="name">Самоспоживання СЕС</field>
        <field name="description">Надлишок СЕС заряджає BESS. Експорт у мережу не більше 20 кВт, далі обмеження інверторів.</field>
        <field name="sequence">20</field>
        <field name="enabled" eval="False"/>
        <field name="params" eval="{'export_max_kw': 20, 'export_deadband_kw': 5, 'bess_target_soc_pct': 95, 'bess_max_kw': 100, 'curtail_pv': True, 'curtail_delay_s': 60, 'restore_hold_s': 120}"/>
    </record>
    <record id="scenario_pfc" model="td.energy.scenario">
        <field name="code">pfc</field>
        <field name="name">Компенсація реактивної потужності</field>
        <field name="description">Автоматичні ступені PFC-1 і PFC-2 тримають цільовий cos φ на кожній секції.</field>
        <field name="sequence">30</field>
        <field name="enabled" eval="True"/>
        <field name="params" eval="{}"/>
    </record>
    <record id="scenario_night" model="td.energy.scenario">
        <field name="code">night</field>
        <field name="name">Нічний режим (BMS)</field>
        <field name="description">Поза змінами: вентиляція RoofVent на 30 %, у цеху — черговий сценарій освітлення, опалення на 16 °C.</field>
        <field name="sequence">40</field>
        <field name="enabled" eval="True"/>
        <field name="params" eval="{'from': '23:00', 'to': '06:30', 'days': [1, 2, 3, 4, 5, 6, 7], 'vent_mode': 'VEL', 'day_vent_mode': 'VE', 'vent_pct': 30, 'light_scene_number': 1, 'light_scene_day_number': 2, 'heat_setpoint_c': 16.0}"/>
    </record>
    <record id="scenario_backup" model="td.energy.scenario">
        <field name="code">backup</field>
        <field name="name">Резервне живлення</field>
        <field name="description">Зникла мережа: АВР переводить на ДГУ, неважливі навантаження вимикаються, критичні лишаються.</field>
        <field name="sequence">50</field>
        <field name="enabled" eval="True"/>
        <field name="params" eval="{'genset_capacity_kw': 507, 'critical_kw': 180, 'restore_delay_s': 120}"/>
    </record>
    <record id="scenario_chp" model="td.energy.scenario">
        <field name="code">chp</field>
        <field name="name">КГУ за графіком і ціною</field>
        <field name="description">Пуск КГУ, коли газ дешевший за мережу або коли BESS не вистачає для зрізання піку.</field>
        <field name="sequence">60</field>
        <field name="enabled" eval="False"/>
        <field name="params" eval="{'min_run_h': 2.0, 'min_off_min': 30, 'gas_price_uah_m3': 25.0, 'gas_m3_per_kwh': 0.25, 'price_margin_uah_kwh': 0.5, 'use_slots': True, 'ramp_min': 6}"/>
    </record>
</odoo>
