        <field name="key">td.energy_control.exec_timeout_s</field>
        <field name="value">60</field>
    </record>
    <record id="param_step_timeout_s" model="ir.config_parameter">
        <field name="key">td.energy_control.step_timeout_s</field>
        <field name="value">8</field>
