    <record id="param_apply_timeout_s" model="ir.config_parameter">
        <field name="key">td.energy_control.apply_timeout_s</field>
        <field name="value">60</field>
    </record>
    <record id="param_undo_window_min" model="ir.config_parameter">
        <field name="key">td.energy_control.undo_window_min</field>
        <field name="value">15</field>
