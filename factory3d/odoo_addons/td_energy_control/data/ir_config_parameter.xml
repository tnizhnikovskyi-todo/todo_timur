    <record id="param_journal_limit" model="ir.config_parameter">
        <field name="key">td.energy_control.journal_limit</field>
        <field name="value">50</field>
    </record>
    <record id="seq_action" model="ir.sequence">
        <field name="name">Керування: дії</field>
        <field name="code">td.energy.action</field>
        <field name="prefix">ACT/%(y)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
