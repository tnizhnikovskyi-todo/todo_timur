<?xml version="1.0" encoding="utf-8"?>
<!-- SPEC 5.1: параметри td.energy_control.* (noupdate); D-46: remote_switching_enabled — False -->
<odoo noupdate="1">
    <record id="param_write_enabled" model="ir.config_parameter">
        <field name="key">td.energy_control.write_enabled</field>
        <field name="value">False</field>
    </record>
    <record id="param_automation_enabled" model="ir.config_parameter">
        <field name="key">td.energy_control.automation_enabled</field>
        <field name="value">False</field>
    </record>
    <record id="param_remote_switching_enabled" model="ir.config_parameter">
        <field name="key">td.energy_control.remote_switching_enabled</field>
        <field name="value">False</field>
    </record>
    <record id="param_confirm_ttl_s" model="ir.config_parameter">
        <field name="key">td.energy_control.confirm_ttl_s</field>
        <field name="value">60</field>
    </record>
    <record id="param_second_ttl_s" model="ir.config_parameter">
        <field name="key">td.energy_control.second_ttl_s</field>
        <field name="value">600</field>
    </record>
    <record id="param_command_ttl_s" model="ir.config_parameter">
        <field name="key">td.energy_control.command_ttl_s</field>
