    <record id="param_shed_restore_step_s" model="ir.config_parameter">
        <field name="key">td.energy_control.shed_restore_step_s</field>
        <field name="value">20</field>
    </record>
    <record id="param_plan_horizon_days" model="ir.config_parameter">
        <field name="key">td.energy_control.plan_horizon_days</field>
        <field name="value">2</field>
