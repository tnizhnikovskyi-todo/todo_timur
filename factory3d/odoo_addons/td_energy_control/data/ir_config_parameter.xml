        <field name="key">td.energy_control.engine_tick_s</field>
        <field name="value">2</field>
    </record>
    <record id="param_config_poll_s" model="ir.config_parameter">
        <field name="key">td.energy_control.config_poll_s</field>
        <field name="value">10</field>
    </record>
    <record id="param_stale_hold_s" model="ir.config_parameter">
        <field name="key">td.energy_control.stale_hold_s</field>
        <field name="value">30</field>
    </record>
    <record id="param_min_write_interval_s" model="ir.config_parameter">
        <field name="key">td.energy_control.min_write_interval_s</field>
        <field name="value">10</field>
    </record>
    <record id="param_max_writes_per_min" model="ir.config_parameter">
        <field name="key">td.energy_control.max_writes_per_min</field>
        <field name="value">30</field>
