<?xml version="1.0" encoding="utf-8"?>
<!-- V-01…V-04: td.machine (SPEC §3) -->
<odoo>
    <record id="view_td_machine_kanban" model="ir.ui.view">
        <field name="name">td.machine.kanban</field>
        <field name="model">td.machine</field>
        <field name="arch" type="xml">
            <kanban default_group_by="zone_id" class="o_kanban_small_column" records_draggable="0" quick_create="0"
                    highlight_color="color" group_create="0" create="0">
                <field name="color"/>
                <field name="protocol"/>
                <field name="current_downtime_id"/>
                <field name="oee_today"/>
                <field name="active_workorder_id"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between">
                            <div class="fw-bold"><field name="code"/> · <field name="name"/></div>
                            <div>
                                <i t-if="record.protocol.raw_value == 'opcua'" class="fa fa-plug" title="OPC UA"/>
                                <i t-elif="record.protocol.raw_value == 'io'" class="fa fa-microchip" title="I/O"/>
                            </div>
                        </div>
                        <div>
                            <field name="state" widget="badge"
                                   decoration-success="state == 'working'" decoration-info="state == 'setup'"
                                   decoration-warning="state == 'idle'" decoration-danger="state == 'fault'"
                                   decoration-muted="state in ('off', 'nodata')"/>
                            <span class="text-muted ms-1">з <field name="state_since" widget="datetime"/></span>
                        </div>
                        <div t-if="record.active_workorder_id.raw_value">
                            Завдання: <field name="active_workorder_id"/>
                        </div>
                        <div t-if="record.current_downtime_id.raw_value"
                             t-att-class="record.state.raw_value == 'fault' ? 'text-danger' : ''">
                            Простій: <field name="current_downtime_id"/> · <field name="downtime_open_min" widget="float_time"/> хв
                        </div>
                        <div t-if="record.oee_today.raw_value"
                             t-att-class="record.oee_today.raw_value >= 0.75 ? 'text-success' : (record.oee_today.raw_value >= 0.5 ? 'text-warning' : 'text-danger')">
                            OEE <field name="oee_today" widget="percentage"/>
                        </div>
                        <div class="mt-2">
                            <button type="object" name="action_open_reason_wizard" class="btn btn-sm btn-secondary me-1"
                                    invisible="not current_downtime_id" groups="td_factory3d.group_td_user">Причина</button>
                            <button type="object" name="action_f3d_show" class="btn btn-sm btn-link"
                                    groups="td_factory3d.group_td_user">3D</button>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_td_machine_list" model="ir.ui.view">
        <field name="name">td.machine.list</field>
        <field name="model">td.machine</field>
        <field name="arch" type="xml">
            <list string="Верстати">
                <field name="code"/>
                <field name="name"/>
                <field name="zone_id"/>
                <field name="protocol"/>
                <field name="source_id"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'working'" decoration-info="state == 'setup'"
                       decoration-warning="state == 'idle'" decoration-danger="state == 'fault'"
                       decoration-muted="state in ('off', 'nodata')"/>
                <field name="state_since"/>
                <field name="active_workorder_id"/>
                <field name="oee_today" widget="percentage"/>
                <field name="auto_start_mode"/>
                <field name="read_enabled" widget="boolean_toggle"/>
                <field name="micro_stop_s" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_td_machine_form" model="ir.ui.view">
        <field name="name">td.machine.form</field>
        <field name="model">td.machine</field>
        <field name="arch" type="xml">
            <form string="Верстат">
                <header>
                    <button name="action_test_connection" type="object" string="Перевірити підключення"/>
                    <button name="action_f3d_show" type="object" string="Показати в 3D"/>
                    <button name="action_reset_state" type="object" string="Скинути стан"
                            groups="td_factory3d.group_td_admin"
                            confirm="Закрити поточний інтервал і простій?"/>
                    <field name="state" widget="statusbar" readonly="1"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_logs" type="object" class="oe_stat_button" icon="fa-clock-o">
                            <div class="o_stat_info"><span class="o_stat_text">Журнал станів</span></div>
                        </button>
                        <button name="action_view_downtimes" type="object" class="oe_stat_button" icon="fa-pause-circle">
                            <div class="o_stat_info"><span class="o_stat_text">Простої</span></div>
                        </button>
                        <button name="action_view_oee" type="object" class="oe_stat_button" icon="fa-line-chart">
                            <div class="o_stat_info"><span class="o_stat_text">OEE</span></div>
                        </button>
                        <button name="action_open_workcenter" type="object" class="oe_stat_button" icon="fa-cogs">
                            <div class="o_stat_info"><span class="o_stat_text">Робочий центр</span></div>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Архів" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group string="Підключення">
                        <group>
                            <field name="workcenter_id"/>
                            <field name="equipment_id"/>
                            <field name="protocol"/>
                        </group>
                        <group>
                            <field name="source_id"/>
                            <field name="io_slot" invisible="protocol != 'io'"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Сигнали" name="signals">
                            <group>
                                <group>
                                    <field name="sig_state_id"/>
                                    <field name="sig_mode_id" invisible="protocol != 'opcua'"/>
                                    <field name="sig_job_id" invisible="protocol != 'opcua'"/>
                                    <field name="sig_event_id" invisible="protocol != 'opcua'"/>
                                    <field name="sig_job_cmd_id" invisible="protocol != 'opcua'"/>
                                </group>
                                <group>
                                    <field name="sig_alarm_id"/>
                                    <field name="sig_pieces_id"/>
                                    <field name="sig_machine_state_id"/>
                                </group>
                            </group>
                        </page>
                        <page string="Автоматика" name="automation">
                            <group>
                                <group>
                                    <field name="read_enabled"/>
                                    <field name="auto_start_mode"/>
                                    <field name="auto_finish"/>
                                    <field name="auto_pause"/>
                                </group>
                                <group>
                                    <field name="micro_stop_s"/>
                                    <field name="pause_after_min"/>
                                    <field name="finish_idle_s"/>
                                    <field name="employee_id"/>
                                </group>
                            </group>
                        </page>
                        <page string="Живий стан" name="live">
                            <group>
                                <group>
                                    <field name="state" readonly="1"/>
                                    <field name="state_since" readonly="1"/>
                                    <field name="raw_state" readonly="1"/>
                                    <field name="raw_mode" readonly="1"/>
                                    <field name="raw_alarm" readonly="1"/>
                                    <field name="raw_job" readonly="1"/>
                                    <field name="raw_ts" readonly="1"/>
                                    <field name="pieces_last" readonly="1"/>
                                </group>
                                <group>
                                    <field name="active_workorder_id" readonly="1"/>
                                    <field name="current_log_id" readonly="1"/>
                                    <field name="current_downtime_id" readonly="1"/>
                                    <field name="oee_today" widget="percentage" readonly="1"/>
                                    <field name="availability_today" widget="percentage" readonly="1"/>
                                    <field name="performance_today" widget="percentage" readonly="1"/>
                                    <field name="quality_today" widget="percentage" readonly="1"/>
                                </group>
                            </group>
                        </page>
                        <page string="Примітка" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_td_machine_search" model="ir.ui.view">
        <field name="name">td.machine.search</field>
        <field name="model">td.machine</field>
        <field name="arch" type="xml">
            <search string="Верстати">
                <field name="code"/>
                <field name="name"/>
                <field name="workcenter_id"/>
                <filter name="working" string="В роботі" domain="[('state', '=', 'working')]"/>
                <filter name="setup" string="Налагодження" domain="[('state', '=', 'setup')]"/>
                <filter name="idle" string="Очікування" domain="[('state', '=', 'idle')]"/>
                <filter name="fault" string="Аварія" domain="[('state', '=', 'fault')]"/>
                <filter name="off" string="Вимкнено" domain="[('state', '=', 'off')]"/>
                <filter name="nodata" string="Немає даних" domain="[('state', '=', 'nodata')]"/>
                <separator/>
                <filter name="opcua" string="OPC UA" domain="[('protocol', '=', 'opcua')]"/>
                <filter name="io" string="I/O" domain="[('protocol', '=', 'io')]"/>
                <separator/>
                <filter name="autostart" string="Автостарт увімкнено" domain="[('auto_start_mode', '!=', 'off')]"/>
                <filter name="has_downtime" string="Є простій" domain="[('current_downtime_id', '!=', False)]"/>
                <group>
                    <filter name="group_zone" string="Зона" context="{'group_by': 'zone_id'}"/>
                    <filter name="group_protocol" string="Підключення" context="{'group_by': 'protocol'}"/>
                    <filter name="group_state" string="Стан" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
