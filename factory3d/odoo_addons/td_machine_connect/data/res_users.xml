<?xml version="1.0" encoding="utf-8"?>
<!-- SPEC §4.2: технічний користувач автоматичних змін (вхід неможливий: немає пароля, active=False). -->
<odoo noupdate="1">
    <record id="user_f3d_machine" model="res.users" context="{'no_reset_password': True}">
        <field name="login">f3d_machine_bot</field>
        <field name="name">Верстати (автоматично)</field>
        <field name="active" eval="False"/>
        <field name="share" eval="False"/>
        <field name="tz">Europe/Kyiv</field>
        <field name="company_id" ref="base.main_company"/>
        <field name="company_ids" eval="[(6, 0, [ref('base.main_company')])]"/>
        <field name="group_ids" eval="[(6, 0, [
            ref('base.group_user'),
            ref('mrp.group_mrp_user'),
            ref('stock.group_stock_user'),
            ref('maintenance.group_equipment_manager'),
            ref('factory3d_base.group_f3d_user'),
        ])]"/>
    </record>
</odoo>
