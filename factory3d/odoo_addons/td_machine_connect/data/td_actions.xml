<?xml version="1.0" encoding="utf-8"?>
<!-- SPEC §5.2: серверні дії модуля. -->
<odoo>
    <record id="action_td_mc_run_migration" model="ir.actions.server">
        <field name="name">Повторити міграцію (верстати)</field>
        <field name="model_id" ref="model_td_machine"/>
        <field name="state">code</field>
        <field name="code">action = env['td.machine']._f3d_run_migration()</field>
        <field name="group_ids" eval="[(4, ref('td_factory3d.group_td_admin'))]"/>
    </record>
    <record id="action_td_downtime_confirm" model="ir.actions.server">
        <field name="name">Підтвердити простої</field>
        <field name="model_id" ref="model_td_downtime"/>
        <field name="binding_model_id" ref="model_td_downtime"/>
        <field name="binding_view_types">list,kanban</field>
        <field name="state">code</field>
        <field name="code">records.action_confirm()</field>
        <field name="group_ids" eval="[(4, ref('mrp.group_mrp_manager'))]"/>
    </record>
    <record id="action_td_oee_period" model="ir.actions.server">
        <field name="name">Перерахувати OEE</field>
        <field name="model_id" ref="model_td_oee_shift"/>
        <field name="binding_model_id" ref="model_td_oee_shift"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">records.action_recompute()</field>
        <field name="group_ids" eval="[(4, ref('td_factory3d.group_td_manager'))]"/>
    </record>
</odoo>
