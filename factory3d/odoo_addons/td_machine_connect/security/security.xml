<?xml version="1.0" encoding="utf-8"?>
<!-- SPEC §4.3: record rules (мультикомпанія). Власних груп немає (CB-10). -->
<odoo>
    <record id="rule_td_machine_company" model="ir.rule">
        <field name="name">Верстати: підключення — компанія</field>
        <field name="model_id" ref="model_td_machine"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_td_downtime_company" model="ir.rule">
        <field name="name">Верстати: простої — компанія</field>
        <field name="model_id" ref="model_td_downtime"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_td_oee_shift_company" model="ir.rule">
        <field name="name">Верстати: OEE — компанія</field>
        <field name="model_id" ref="model_td_oee_shift"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_td_gantry_job_company" model="ir.rule">
        <field name="name">Портал: завдання — компанія</field>
        <field name="model_id" ref="model_td_gantry_job"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_td_cut_map_company" model="ir.rule">
        <field name="name">Розкрій: карти — компанія</field>
        <field name="model_id" ref="model_td_cut_map"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
