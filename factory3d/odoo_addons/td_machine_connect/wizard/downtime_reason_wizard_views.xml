<?xml version="1.0" encoding="utf-8"?>
<!-- V-09: майстер причини простою (M-24) -->
<odoo>
    <record id="view_td_downtime_reason_wizard_form" model="ir.ui.view">
        <field name="name">td.downtime.reason.wizard.form</field>
        <field name="model">td.downtime.reason.wizard</field>
        <field name="arch" type="xml">
            <form string="Причина простою">
                <group>
                    <field name="downtime_id" readonly="1"/>
                    <field name="hint_text" readonly="1" invisible="not hint_text"/>
                    <field name="loss_id" widget="radio" options="{'no_create': True}"/>
                    <field name="employee_id"/>
                    <field name="note"/>
                </group>
                <footer>
                    <button name="action_apply" type="object" string="Зберегти" class="btn-primary"/>
                    <button string="Скасувати" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
