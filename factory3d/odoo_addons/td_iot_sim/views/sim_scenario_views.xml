<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_td_sim_scenario_list" model="ir.ui.view">
    <field name="name">td.sim.scenario.list</field>
    <field name="model">td.sim.scenario</field>
    <field name="arch" type="xml">
      <list string="Сценарії">
        <field name="write_enabled" column_invisible="1"/>
        <field name="sequence" widget="handle"/>
        <field name="code"/>
        <field name="name"/>
        <field name="group"/>
        <field name="duration_s"/>
        <field name="last_run_id"/>
        <button name="action_start" type="object" string="Запустити" icon="fa-play"
                invisible="not write_enabled"/>
      </list>
    </field>
  </record>

  <record id="view_td_sim_scenario_form" model="ir.ui.view">
    <field name="name">td.sim.scenario.form</field>
    <field name="model">td.sim.scenario</field>
    <field name="arch" type="xml">
      <form string="Сценарій">
        <header>
          <field name="write_enabled" invisible="1"/>
          <button name="action_start" type="object" string="Запустити" class="btn-primary"
                  invisible="not write_enabled"/>
        </header>
        <sheet>
          <group>
            <group>
              <field name="code" readonly="id"/>
              <field name="name"/>
              <field name="group"/>
            </group>
            <group>
              <field name="duration_s"/>
              <field name="sequence"/>
              <field name="active"/>
            </group>
          </group>
          <group string="Опис"><field name="description" nolabel="1"/></group>
          <group>
            <field name="params_schema" widget="json"/>
            <field name="params_default" widget="json"/>
          </group>
          <notebook>
            <page string="Запуски" name="runs">
              <field name="run_ids" readonly="1">
                <list>
                  <field name="name"/>
                  <field name="state"/>
                  <field name="user_id"/>
                  <field name="start_ts"/>
                  <field name="stop_ts"/>
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_td_sim_scenario_kanban" model="ir.ui.view">
    <field name="name">td.sim.scenario.kanban</field>
    <field name="model">td.sim.scenario</field>
    <field name="arch" type="xml">
      <kanban default_group_by="group" group_create="false" records_draggable="false">
        <field name="write_enabled"/>
        <templates>
          <t t-name="card">
            <field name="name" class="fw-bold fs-5"/>
            <div class="text-muted"><field name="code"/></div>
            <div t-if="record.write_enabled.raw_value" class="mt-2">
              <button name="action_start" type="object" class="btn btn-sm btn-primary">Запустити</button>
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>

  <record id="action_td_sim_scenario" model="ir.actions.act_window">
    <field name="name">Сценарії емулятора</field>
    <field name="res_model">td.sim.scenario</field>
    <field name="view_mode">kanban,list,form</field>
  </record>
</odoo>
