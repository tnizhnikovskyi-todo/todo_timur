<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="0">
  <!-- 16 сценаріїв: S-01…S-15 (SPEC §9.3) і S-16 pfc_step_fault (W1 «Енергетика», §8.1); схеми можуть оновлюватись. -->
  <record id="scenario_shift" model="td.sim.scenario">
    <field name="code">shift</field>
    <field name="name">Робоча зміна</field>
    <field name="group">production</field>
    <field name="sequence">10</field>
    <field name="duration_s">0</field>
    <field name="description"><![CDATA[<p>Планувальник дня: завдання на РЦ, фури за розкладом, відмітки людей. Лише в режимі «Сценарій».</p>]]></field>
    <field name="params_schema" eval="{'type': 'object', 'properties': {'date': {'type': 'string'}, 'lines': {'type': 'array', 'items': {'type': 'string', 'enum': ['A', 'B', 'C', 'D', 'F']}}, 'speed': {'type': 'number', 'minimum': 0.5, 'maximum': 3}, 'trucks': {'type': 'boolean'}, 'people': {'type': 'boolean'}, 'note': {'type': 'string'}}, 'additionalProperties': True}"/>
    <field name="params_default" eval="{'speed': 1, 'trucks': True, 'people': True}"/>
  </record>
  <record id="scenario_machine_fault" model="td.sim.scenario">
    <field name="code">machine_fault</field>
    <field name="name">Збій верстата</field>
    <field name="group">production</field>
    <field name="sequence">20</field>
    <field name="duration_s">0</field>
    <field name="description"><![CDATA[<p>Збій на РЦ: OPC UA ERROR, DI fault, p_now=0, червоне кільце в 3D.</p>]]></field>
    <field name="params_schema" eval="{'type': 'object', 'properties': {'device': {'type': 'string'}, 'reason': {'type': 'string', 'enum': ['generic', 'spindle', 'emergency', 'power', 'comm', 'sensor']}, 'auto_clear_s': {'type': 'integer', 'minimum': 0}, 'note': {'type': 'string'}}, 'additionalProperties': True, 'required': ['device']}"/>
    <field name="params_default" eval="{'reason': 'generic', 'auto_clear_s': 0}"/>
  </record>
  <record id="scenario_blackout" model="td.sim.scenario">
    <field name="code">blackout</field>
    <field name="name">Блекаут</field>
    <field name="group">energy</field>
    <field name="sequence">30</field>
    <field name="duration_s">600</field>
    <field name="description"><![CDATA[<p>Втрата мережі: ATyS, генератор, вводи PM5560, аварійне освітлення.</p>]]></field>
    <field name="params_schema" eval="{'type': 'object', 'properties': {'genset': {'type': 'boolean'}, 'restore_delay_s': {'type': 'integer', 'minimum': 0}, 'amf_master': {'type': 'string', 'enum': ['hgm', 'ats']}, 'genset_load_kw': {'type': 'number', 'minimum': 0, 'maximum': 558}, 'chp_island': {'type': 'boolean'}, 'note': {'type': 'string'}}, 'additionalProperties': True}"/>
    <field name="params_default" eval="{'genset': True, 'restore_delay_s': 60, 'amf_master': 'hgm', 'chp_island': False}"/>
  </record>
  <record id="scenario_filter_clogged" model="td.sim.scenario">
    <field name="code">filter_clogged</field>
    <field name="name">Забитий фільтр</field>
    <field name="group">bms</field>
    <field name="sequence">40</field>
    <field name="duration_s">0</field>
    <field name="description"><![CDATA[<p>Перепад тиску на фільтрі росте до цільового значення; заявка на заміну фільтрів.</p>]]></field>
    <field name="params_schema" eval="{'type': 'object', 'properties': {'device': {'type': 'string'}, 'value': {'type': 'number'}, 'ramp_min': {'type': 'integer', 'minimum': 0}, 'note': {'type': 'string'}}, 'additionalProperties': True, 'required': ['device']}"/>
    <field name="params_default" eval="{'ramp_min': 2}"/>
  </record>
  <record id="scenario_truck_no_booking" model="td.sim.scenario">
    <field name="code">truck_no_booking</field>
    <field name="name">Фура без бронювання</field>
    <field name="group">logistics</field>
    <field name="sequence">50</field>
    <field name="duration_s">0</field>
    <field name="description"><![CDATA[<p>Фура без бронювання: LPR порожній список, шлагбаум закритий.</p>]]></field>
    <field name="params_schema" eval="{'type': 'object', 'properties': {'plate': {'type': 'string'}, 'gate': {'type': 'string', 'enum': ['GATE-W', 'GATE-E']}, 'wait_min': {'type': 'integer', 'minimum': 0}, 'note': {'type': 'string'}}, 'additionalProperties': True}"/>
    <field name="params_default" eval="{'gate': 'GATE-W', 'wait_min': 10}"/>
  </record>
  <record id="scenario_truck_arrival" model="td.sim.scenario">
    <field name="code">truck_arrival</field>
    <field name="name">Прибуття фури</field>
    <field name="group">logistics</field>
    <field name="sequence">60</field>
    <field name="duration_s">0</field>
    <field name="description"><![CDATA[<p>Фура з бронюванням проходить повний цикл: LPR, шлагбаум, ваги, розвантаження.</p>]]></field>
    <field name="params_schema" eval="{'type': 'object', 'properties': {'booking': {'type': 'string'}, 'plate': {'type': 'string'}, 'at': {'type': 'string'}, 'unload_min': {'type': 'integer', 'minimum': 0}, 'note': {'type': 'string'}}, 'additionalProperties': True, 'required': ['booking']}"/>
    <field name="params_default" eval="{'unload_min': 40}"/>
  </record>
  <record id="scenario_fire_drill" model="td.sim.scenario">
    <field name="code">fire_drill</field>
    <field name="name">Пожежне навчання</field>
    <field name="group">safety</field>
    <field name="sequence">70</field>
    <field name="duration_s">300</field>
    <field name="description"><![CDATA[<p>Навчальна (або справжня) пожежна тривога: сирени, стоп вентиляції, двері, верстати ERROR.</p>]]></field>
    <field name="params_schema" eval="{'type': 'object', 'properties': {'zone': {'type': 'string'}, 'detector': {'type': 'string'}, 'real': {'type': 'boolean'}, 'note': {'type': 'string'}}, 'additionalProperties': True}"/>
    <field name="params_default" eval="{'zone': 'FA-CNC', 'real': False}"/>
  </record>
  <record id="scenario_spark" model="td.sim.scenario">
    <field name="code">spark</field>
    <field name="name">Іскра</field>
    <field name="group">safety</field>
    <field name="sequence">80</field>
    <field name="duration_s">0</field>
    <field name="description"><![CDATA[<p>Спрацювання іскрогасіння на лінії аспірації.</p>]]></field>
    <field name="params_schema" eval="{'type': 'object', 'properties': {'fault': {'type': 'boolean'}, 'count': {'type': 'integer', 'minimum': 1, 'maximum': 5}, 'interval_s': {'type': 'integer', 'minimum': 1}, 'note': {'type': 'string'}}, 'additionalProperties': True}"/>
    <field name="params_default" eval="{'fault': False, 'count': 1, 'interval_s': 30}"/>
  </record>
  <record id="scenario_access_event" model="td.sim.scenario">
    <field name="code">access_event</field>
    <field name="name">Подія доступу</field>
    <field name="group">access</field>
    <field name="sequence">90</field>
    <field name="duration_s">0</field>
    <field name="description"><![CDATA[<p>Подія BioStar на зчитувачі: відмітка, відкриття дверей.</p>]]></field>
    <field name="params_schema" eval="{'type': 'object', 'properties': {'device': {'type': 'string'}, 'user': {'type': 'string'}, 'code': {'type': 'integer'}, 'tna_key': {'type': 'string', 'enum': ['1', '2', '']}, 'door_open': {'type': 'boolean'}, 'note': {'type': 'string'}}, 'additionalProperties': True}"/>
    <field name="params_default" eval="{'device': 'ACR-IN', 'code': 4102, 'tna_key': '1', 'door_open': True}"/>
  </record>
  <record id="scenario_battery_low" model="td.sim.scenario">
    <field name="code">battery_low</field>
    <field name="name">Низький заряд АКБ</field>
    <field name="group">logistics</field>
    <field name="sequence">100</field>
    <field name="duration_s">0</field>
    <field name="description"><![CDATA[<p>Навантажувач їде на зарядку.</p>]]></field>
    <field name="params_schema" eval="{'type': 'object', 'properties': {'device': {'type': 'string'}, 'level_pct': {'type': 'number', 'minimum': 0, 'maximum': 100}, 'note': {'type': 'string'}}, 'additionalProperties': True, 'required': ['device']}"/>
    <field name="params_default" eval="{'level_pct': 18}"/>
  </record>
  <record id="scenario_compressor_fault" model="td.sim.scenario">
    <field name="code">compressor_fault</field>
    <field name="name">Збій компресора</field>
    <field name="group">energy</field>
    <field name="sequence">110</field>
    <field name="duration_s">900</field>
    <field name="description"><![CDATA[<p>Падіння тиску, перегрів або втрата зв'язку компресора.</p>]]></field>
    <field name="params_schema" eval="{'type': 'object', 'properties': {'kind': {'type': 'string', 'enum': ['pressure_drop', 'overtemp', 'comm']}, 'note': {'type': 'string'}}, 'additionalProperties': True}"/>
    <field name="params_default" eval="{'kind': 'pressure_drop'}"/>
  </record>
  <record id="scenario_pv_cloudy" model="td.sim.scenario">
    <field name="code">pv_cloudy</field>
    <field name="name">Хмарність СЕС</field>
    <field name="group">energy</field>
    <field name="sequence">120</field>
    <field name="duration_s">1800</field>
    <field name="description"><![CDATA[<p>Виробіток СЕС падає; BESS розряджається, імпорт з мережі росте.</p>]]></field>
    <field name="params_schema" eval="{'type': 'object', 'properties': {'cf': {'type': 'number', 'minimum': 0.05, 'maximum': 1}, 'note': {'type': 'string'}}, 'additionalProperties': True}"/>
    <field name="params_default" eval="{'cf': 0.3}"/>
  </record>
  <record id="scenario_boiler_refill" model="td.sim.scenario">
    <field name="code">boiler_refill</field>
    <field name="name">Завантаження бункера котла</field>
    <field name="group">bms</field>
    <field name="sequence">130</field>
    <field name="duration_s">0</field>
    <field name="description"><![CDATA[<p>Бункер біомаси заповнено до заданого рівня.</p>]]></field>
    <field name="params_schema" eval="{'type': 'object', 'properties': {'level_pct': {'type': 'number', 'minimum': 0, 'maximum': 100}, 'force_on': {'type': 'integer', 'minimum': -1, 'maximum': 2}, 'note': {'type': 'string'}}, 'additionalProperties': True}"/>
    <field name="params_default" eval="{'level_pct': 95, 'force_on': -1}"/>
  </record>
  <record id="scenario_genset_test" model="td.sim.scenario">
    <field name="code">genset_test</field>
    <field name="name">Тест генератора</field>
    <field name="group">energy</field>
    <field name="sequence">140</field>
    <field name="duration_s">900</field>
    <field name="description"><![CDATA[<p>Щотижневий тестовий пуск генератора.</p>]]></field>
    <field name="params_schema" eval="{'type': 'object', 'properties': {'test_on_load': {'type': 'boolean'}, 'note': {'type': 'string'}}, 'additionalProperties': True}"/>
    <field name="params_default" eval="{'test_on_load': False}"/>
  </record>
  <record id="scenario_lighting_scene" model="td.sim.scenario">
    <field name="code">lighting_scene</field>
    <field name="name">Сцена освітлення</field>
    <field name="group">bms</field>
    <field name="sequence">150</field>
    <field name="duration_s">600</field>
    <field name="description"><![CDATA[<p>Явна сцена або рівень групи DALI.</p>]]></field>
    <field name="params_schema" eval="{'type': 'object', 'properties': {'group': {'type': 'string'}, 'scene': {'type': 'integer', 'minimum': 1, 'maximum': 16}, 'level': {'type': 'integer', 'minimum': 0, 'maximum': 100}, 'fault_device': {'type': 'string'}, 'note': {'type': 'string'}}, 'additionalProperties': True}"/>
    <field name="params_default" eval="{'group': 'all'}"/>
  </record>
  <record id="scenario_pfc_step_fault" model="td.sim.scenario">
    <field name="code">pfc_step_fault</field>
    <field name="name">Збій ступеня PFC</field>
    <field name="group">energy</field>
    <field name="sequence">160</field>
    <field name="duration_s">0</field>
    <field name="description"><![CDATA[<p>Ступінь конденсаторної установки PFC секції не вмикається: контролер ГРЩ лишає step−1 ступенів і віддає fault_step=step (тримається до зупинки сценарію; після зупинки 0). Параметр qs_closed=true замикає QS. step=0 — без збою.</p>]]></field>
    <field name="params_schema" eval="{'type': 'object', 'properties': {'section': {'type': 'integer', 'enum': [1, 2]}, 'step': {'type': 'integer', 'minimum': 0, 'maximum': 10}, 'qs_closed': {'type': 'boolean'}, 'note': {'type': 'string'}}, 'additionalProperties': True}"/>
    <field name="params_default" eval="{'section': 2, 'step': 3}"/>
  </record>
</odoo>
