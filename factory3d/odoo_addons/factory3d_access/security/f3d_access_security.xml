<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="privilege_f3d_access" model="res.groups.privilege">
        <field name="name">Завод 3D: доступ (СКУД)</field>
        <field name="category_id" ref="factory3d_base.module_category_factory3d"/>
        <field name="sequence">70</field>
    </record>
    <record id="group_f3d_access_security" model="res.groups">
        <field name="name">Охорона</field>
        <field name="privilege_id" ref="privilege_f3d_access"/>
        <field name="sequence">10</field>
        <field name="implied_ids" eval="[Command.link(ref('factory3d_base.group_f3d_user'))]"/>
    </record>
    <record id="group_f3d_access_admin" model="res.groups">
        <field name="name">Адміністратор СКУД</field>
        <field name="privilege_id" ref="privilege_f3d_access"/>
        <field name="sequence">20</field>
        <field name="implied_ids" eval="[Command.link(ref('group_f3d_access_security')), Command.link(ref('factory3d_base.group_f3d_manager'))]"/>
    </record>
    <record id="factory3d_base.group_f3d_admin" model="res.groups">
        <field name="implied_ids" eval="[Command.link(ref('group_f3d_access_admin'))]"/>
    </record>
    <record id="rule_f3d_access_server_company" model="ir.rule">
        <field name="name">СКУД server: компанія</field>
        <field name="model_id" ref="model_f3d_access_server"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_f3d_access_device_company" model="ir.rule">
        <field name="name">СКУД device: компанія</field>
        <field name="model_id" ref="model_f3d_access_device"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_f3d_access_door_company" model="ir.rule">
        <field name="name">СКУД door: компанія</field>
        <field name="model_id" ref="model_f3d_access_door"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_f3d_access_user_link_company" model="ir.rule">
        <field name="name">СКУД user.link: компанія</field>
        <field name="model_id" ref="model_f3d_access_user_link"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <!-- W2/W3: rule_f3d_access_{event,card,visitor,presence}_company, rule_f3d_access_card_* (SPEC §4.3) -->
</odoo>
