<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_f3d_access_presence_kanban" model="ir.ui.view">
        <field name="name">f3d.access.presence.kanban</field>
        <field name="model">f3d.access.presence</field>
        <field name="arch" type="xml">
            <kanban string="Люди по зонах" create="0" edit="0" delete="0" default_group_by="zone_id"
                    group_create="0" group_delete="0" group_edit="0" records_draggable="0">
                <field name="person_type"/>
                <field name="zone_id"/>
                <field name="home_zone_id"/>
                <templates>
                    <t t-name="card">
                        <div>
                            <field name="name" class="fw-bold"/>
                            <span class="text-muted ms-1"><field name="code"/></span>
                            <span t-if="record.person_type.raw_value == 'visitor'" class="badge text-bg-info ms-1">Відвідувач</span>
                        </div>
                        <div class="text-muted">У зоні з: <field name="zone_since" widget="datetime"/></div>
                        <div class="text-muted">Вхід: <field name="last_in" widget="datetime"/></div>
                        <div t-if="record.home_zone_id.raw_value and record.home_zone_id.raw_value != record.zone_id.raw_value"
                             class="text-muted">Домашня зона: <field name="home_zone_id"/></div>
                        <div class="mt-2">
                            <button name="action_f3d_show" type="object" string="Показати в 3D" icon="fa-cube"
                                    class="btn btn-sm btn-secondary"/>
                            <button name="action_open_person" type="object" string="Відкрити"
                                    class="btn btn-sm btn-link"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_f3d_access_presence_list" model="ir.ui.view">
        <field name="name">f3d.access.presence.list</field>
        <field name="model">f3d.access.presence</field>
        <field name="arch" type="xml">
            <list string="Люди по зонах" create="0" edit="0" delete="0">
                <field name="name"/>
                <field name="code"/>
                <field name="person_type"/>
                <field name="zone_id"/>
                <field name="zone_since"/>
                <field name="last_in"/>
                <field name="home_zone_id"/>
                <field name="host_employee_id"/>
            </list>
        </field>
    </record>

    <record id="view_f3d_access_presence_search" model="ir.ui.view">
        <field name="name">f3d.access.presence.search</field>
        <field name="model">f3d.access.presence</field>
        <field name="arch" type="xml">
            <search string="Люди по зонах">
                <field name="name"/>
                <field name="code"/>
                <field name="zone_id"/>
                <filter name="employees" string="Працівники" domain="[('person_type', '=', 'employee')]"/>
                <filter name="visitors" string="Відвідувачі" domain="[('person_type', '=', 'visitor')]"/>
                <filter name="no_home_zone" string="Без домашньої зони"
                        domain="[('person_type', '=', 'employee'), ('home_zone_id', '=', False)]"/>
                <group>
                    <filter name="group_zone" string="Зона" context="{'group_by': 'zone_id'}"/>
                    <filter name="group_type" string="Тип" context="{'group_by': 'person_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_f3d_access_presence" model="ir.actions.act_window">
        <field name="name">Люди по зонах</field>
        <field name="res_model">f3d.access.presence</field>
        <field name="view_mode">kanban,list</field>
        <field name="context">{'search_default_group_zone': 1}</field>
    </record>
</odoo>
