<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_f3d_telemetry" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.f3d.telemetry</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="45"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Завод 3D: телеметрія" string="Завод 3D: телеметрія" name="factory3d_telemetry"
                     groups="factory3d_base.group_f3d_admin">
                    <block title="Телеметрія" name="factory3d_telemetry_settings">
                        <setting string="Приймати показання" help="Стоп-кран прийому показань">
                            <field name="f3d_telemetry_read_enabled"/>
                        </setting>
                        <setting string="Дозволяти команди на пристрої" help="Стоп-кран запису в пристрої">
                            <field name="f3d_telemetry_write_enabled"/>
                        </setting>
                        <setting string="Колектори">
                            <div class="content-group">
                                <div class="mt8"><field name="f3d_telemetry_collector_count"/> активних</div>
                                <button name="action_f3d_collector" type="object" string="Колектори" class="btn-link"/>
                            </div>
                        </setting>
                    </block>
                    <block title="Зберігання" name="factory3d_telemetry_storage">
                        <setting string="Терміни зберігання">
                            <div class="content-group">
                                <div class="row mt8"><label class="col-lg-5" for="f3d_telemetry_keep_days"/>
                                    <field name="f3d_telemetry_keep_days"/></div>
                                <div class="row mt8"><label class="col-lg-5" for="f3d_telemetry_keep_hours_days"/>
                                    <field name="f3d_telemetry_keep_hours_days"/></div>
                                <div class="row mt8"><label class="col-lg-5" for="f3d_telemetry_default_store_period_s"/>
                                    <field name="f3d_telemetry_default_store_period_s"/></div>
                            </div>
                        </setting>
                    </block>
                    <block title="Пороги й заявки" name="factory3d_telemetry_requests">
                        <setting string="Немає даних і повторні заявки">
                            <div class="content-group">
                                <div class="row mt8"><label class="col-lg-5" for="f3d_telemetry_stale_periods"/>
                                    <field name="f3d_telemetry_stale_periods"/></div>
                                <div class="row mt8"><label class="col-lg-5" for="f3d_telemetry_stale_min_s"/>
                                    <field name="f3d_telemetry_stale_min_s"/></div>
                                <div class="row mt8"><label class="col-lg-5" for="f3d_telemetry_realarm_cooldown_s"/>
                                    <field name="f3d_telemetry_realarm_cooldown_s"/></div>
                                <div class="row mt8"><label class="col-lg-5" for="f3d_telemetry_meter_lead_pct"/>
                                    <field name="f3d_telemetry_meter_lead_pct"/></div>
                                <div class="row mt8"><label class="col-lg-5" for="f3d_telemetry_default_team_id"/>
                                    <field name="f3d_telemetry_default_team_id"/></div>
                            </div>
                        </setting>
                    </block>
                    <block title="API" name="factory3d_telemetry_api">
                        <setting string="Ліміти API">
                            <div class="content-group">
                                <div class="row mt8"><label class="col-lg-5" for="f3d_telemetry_push_max_readings"/>
                                    <field name="f3d_telemetry_push_max_readings"/></div>
                                <div class="row mt8"><label class="col-lg-5" for="f3d_telemetry_push_rate_per_min"/>
                                    <field name="f3d_telemetry_push_rate_per_min"/></div>
                                <div class="row mt8"><label class="col-lg-5" for="f3d_telemetry_bus_min_interval_s"/>
                                    <field name="f3d_telemetry_bus_min_interval_s"/></div>
                            </div>
                        </setting>
                    </block>
                    <block title="Рівень 0" name="factory3d_telemetry_level0">
                        <setting string="Міграція рівня 0">
                            <div class="content-group">
                                <div class="row mt8"><label class="col-lg-5" for="f3d_telemetry_level0_state"/>
                                    <field name="f3d_telemetry_level0_state"/></div>
                                <div class="row mt8"><label class="col-lg-5" for="f3d_telemetry_drop_level0"/>
                                    <field name="f3d_telemetry_drop_level0"/></div>
                                <button name="action_f3d_run_migration" type="object"
                                        string="Повторити міграцію рівня 0" class="btn-link"
                                        groups="factory3d_base.group_f3d_admin"/>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_f3d_telemetry_settings" model="ir.actions.act_window">
        <field name="name">Налаштування телеметрії</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'factory3d_telemetry'}</field>
    </record>
</odoo>
