<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_f3d_reading_hour_pivot" model="ir.ui.view">
        <field name="name">f3d.reading.hour.pivot</field>
        <field name="model">f3d.reading.hour</field>
        <field name="arch" type="xml">
            <pivot string="Годинні агрегати">
                <field name="signal_id" type="row"/>
                <field name="hour" interval="day" type="col"/>
                <field name="v_avg" type="measure"/>
                <field name="v_min" type="measure"/>
                <field name="v_max" type="measure"/>
                <field name="delta" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_f3d_reading_hour_graph" model="ir.ui.view">
        <field name="name">f3d.reading.hour.graph</field>
        <field name="model">f3d.reading.hour</field>
        <field name="arch" type="xml">
            <graph string="Годинні агрегати" type="line">
                <field name="hour" interval="hour"/>
                <field name="signal_id"/>
                <field name="v_avg" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_f3d_reading_hour_list" model="ir.ui.view">
        <field name="name">f3d.reading.hour.list</field>
        <field name="model">f3d.reading.hour</field>
        <field name="arch" type="xml">
            <list string="Годинні агрегати" create="false" edit="false" delete="false">
                <field name="hour"/>
                <field name="equipment_id"/>
                <field name="signal_id"/>
                <field name="v_min"/>
                <field name="v_avg"/>
                <field name="v_max"/>
                <field name="v_last"/>
                <field name="delta"/>
                <field name="v_count"/>
            </list>
        </field>
    </record>

    <record id="action_f3d_reading_hour" model="ir.actions.act_window">
        <field name="name">Годинні агрегати</field>
        <field name="res_model">f3d.reading.hour</field>
        <field name="view_mode">pivot,graph,list</field>
    </record>
</odoo>
