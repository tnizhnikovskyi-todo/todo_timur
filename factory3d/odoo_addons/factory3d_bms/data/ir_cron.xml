<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- SPEC §6. Модель f3d.bms.check створює W4; у маніфест файл підключає менеджер після злиття -->
    <record id="cron_f3d_bms_check" model="ir.cron">
        <field name="name">Будівля: перевірка відхилень</field>
        <field name="model_id" ref="model_f3d_bms_check"/>
        <field name="state">code</field>
        <field name="code">model._cron_check()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
