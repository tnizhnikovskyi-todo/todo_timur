<?xml version="1.0" encoding="utf-8"?>
<!-- V-04: команди КГУ (лише читання) -->
<odoo>
    <record id="view_td_chp_command_list" model="ir.ui.view">
        <field name="name">td.chp.command.list</field>
        <field name="model">td.chp.command</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false" decoration-danger="state in ('failed', 'blocked')"
                  decoration-muted="state in ('expired', 'cancelled')" decoration-success="state == 'done'">
                <field name="name"/>
                <field name="create_date"/>
                <field name="kind_code"/>
                <field name="cls"/>
                <field name="state" widget="badge"/>
                <field name="prepared_by"/>
                <field name="confirmed_by" optional="show"/>
                <field name="second_by" optional="show"/>
                <field name="result_text" optional="hide"/>
                <field name="error" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_td_chp_command_form" model="ir.ui.view">
        <field name="name">td.chp.command.form</field>
        <field name="model">td.chp.command</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="prepared,awaiting_second,queued,sent,executing,done"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group string="Команда">
                            <field name="unit_id"/>
                            <field name="kind_code"/>
                            <field name="cls"/>
                            <field name="summary"/>
                            <field name="params_text"/>
                            <field name="command_id"/>
                        </group>
                        <group string="Підтвердження">
                            <field name="prepared_by"/>
                            <field name="prepared_at"/>
                            <field name="confirmed_by"/>
                            <field name="confirmed_at"/>
                            <field name="needs_second"/>
                            <field name="second_by"/>
                            <field name="second_at"/>
                        </group>
                    </group>
                    <group string="Перевірки">
                        <field name="checks_text" nolabel="1" colspan="2"/>
                    </group>
                    <group string="Результат">
                        <field name="started_at"/>
                        <field name="finished_at"/>
                        <field name="result_text"/>
                        <field name="error"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_td_chp_command" model="ir.actions.act_window">
        <field name="name">Команди КГУ</field>
        <field name="res_model">td.chp.command</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
