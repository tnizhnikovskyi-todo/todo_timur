<?xml version="1.0" encoding="utf-8"?>
<!-- SPEC §6: 4 крони; усі no-op при td.chp.read_enabled=False; neutralize.sql вимикає -->
<odoo noupdate="1">
    <record id="cron_td_chp_expire" model="ir.cron">
        <field name="name">КГУ: завершення прострочених команд</field>
        <field name="model_id" ref="model_td_chp_command"/>
        <field name="state">code</field>
        <field name="code">model._cron_expire()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="active" eval="True"/>
    </record>
    <record id="cron_td_chp_stale" model="ir.cron">
        <field name="name">КГУ: контроль зв'язку</field>
        <field name="model_id" ref="model_td_chp_event"/>
        <field name="state">code</field>
        <field name="code">model._cron_stale()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="active" eval="True"/>
    </record>
    <record id="cron_td_chp_maintenance" model="ir.cron">
        <field name="name">КГУ: ТО за наробітком</field>
        <field name="model_id" ref="model_td_chp_maintenance_rule"/>
        <field name="state">code</field>
        <field name="code">model._cron_check()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="active" eval="True"/>
    </record>
    <record id="cron_td_chp_gc" model="ir.cron">
        <field name="name">КГУ: очищення журналу подій</field>
        <field name="model_id" ref="model_td_chp_event"/>
        <field name="state">code</field>
        <field name="code">model._cron_gc()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="active" eval="True"/>
    </record>
</odoo>
