<?xml version="1.0" encoding="utf-8"?>
<!-- SPEC §4: групи «Когенерація» (D-07) і правила компанії для M-01…M-04 -->
<odoo>
    <record id="privilege_td_chp" model="res.groups.privilege">
        <field name="name">Когенерація</field>
        <field name="category_id" ref="td_factory3d.module_category_factory3d"/>
        <field name="sequence">55</field>
    </record>
    <record id="group_td_chp_user" model="res.groups">
        <field name="name">КГУ: перегляд</field>
        <field name="privilege_id" ref="privilege_td_chp"/>
        <field name="sequence">10</field>
        <field name="implied_ids" eval="[Command.link(ref('td_factory3d.group_td_user'))]"/>
    </record>
    <record id="group_td_chp_operator" model="res.groups">
        <field name="name">КГУ: енергетик</field>
        <field name="privilege_id" ref="privilege_td_chp"/>
        <field name="sequence">20</field>
        <field name="implied_ids" eval="[Command.link(ref('group_td_chp_user'))]"/>
    </record>
    <record id="group_td_chp_chief" model="res.groups">
        <field name="name">КГУ: головний енергетик</field>
        <field name="privilege_id" ref="privilege_td_chp"/>
        <field name="sequence">30</field>
        <field name="implied_ids" eval="[Command.link(ref('group_td_chp_operator'))]"/>
    </record>

    <record id="td_chp_unit_rule_company" model="ir.rule">
        <field name="name">КГУ: агрегати — компанія</field>
        <field name="model_id" ref="model_td_chp_unit"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="td_chp_event_rule_company" model="ir.rule">
        <field name="name">КГУ: події — компанія</field>
        <field name="model_id" ref="model_td_chp_event"/>
        <field name="domain_force">['|', ('unit_id.company_id', '=', False), ('unit_id.company_id', 'in', company_ids)]</field>
    </record>
    <record id="td_chp_command_rule_company" model="ir.rule">
        <field name="name">КГУ: команди — компанія</field>
        <field name="model_id" ref="model_td_chp_command"/>
        <field name="domain_force">['|', ('unit_id.company_id', '=', False), ('unit_id.company_id', 'in', company_ids)]</field>
    </record>
    <record id="td_chp_rule_rule_company" model="ir.rule">
        <field name="name">КГУ: правила ТО — компанія</field>
        <field name="model_id" ref="model_td_chp_maintenance_rule"/>
        <field name="domain_force">['|', ('unit_id.company_id', '=', False), ('unit_id.company_id', 'in', company_ids)]</field>
    </record>
</odoo>
