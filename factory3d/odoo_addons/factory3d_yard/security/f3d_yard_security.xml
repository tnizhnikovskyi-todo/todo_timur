<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="privilege_f3d_yard" model="res.groups.privilege">
        <field name="name">Двір</field>
        <field name="category_id" ref="factory3d_base.module_category_factory3d"/>
        <field name="sequence">60</field>
    </record>
    <record id="group_f3d_yard_security" model="res.groups">
        <field name="name">Охорона КПП</field>
        <field name="privilege_id" ref="privilege_f3d_yard"/>
        <field name="sequence">10</field>
        <field name="implied_ids" eval="[Command.link(ref('factory3d_base.group_f3d_user'))]"/>
    </record>
    <record id="group_f3d_yard_dispatcher" model="res.groups">
        <field name="name">Диспетчер двору</field>
        <field name="privilege_id" ref="privilege_f3d_yard"/>
        <field name="sequence">20</field>
        <field name="implied_ids" eval="[Command.link(ref('group_f3d_yard_security')), Command.link(ref('stock.group_stock_user'))]"/>
    </record>
    <record id="group_f3d_yard_manager" model="res.groups">
        <field name="name">Менеджер двору</field>
        <field name="privilege_id" ref="privilege_f3d_yard"/>
        <field name="sequence">30</field>
        <field name="implied_ids" eval="[Command.link(ref('group_f3d_yard_dispatcher')), Command.link(ref('factory3d_base.group_f3d_manager'))]"/>
    </record>
    <record id="factory3d_base.group_f3d_admin" model="res.groups">
        <field name="implied_ids" eval="[Command.link(ref('group_f3d_yard_manager'))]"/>
    </record>
</odoo>
