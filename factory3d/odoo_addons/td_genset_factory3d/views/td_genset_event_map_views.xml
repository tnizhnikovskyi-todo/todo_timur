<?xml version="1.0" encoding="utf-8"?>
<!-- SPEC §3 V-05 -->
<odoo>
    <record id="view_f3d_genset_event_map_list" model="ir.ui.view">
        <field name="name">f3d.genset.event.map.list</field>
        <field name="model">f3d.genset.event.map</field>
        <field name="arch" type="xml">
            <list string="Події → ТО" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="key"/>
                <field name="hgm_name"/>
                <field name="hgm_table"/>
                <field name="severity"/>
                <field name="td_code"/>
                <field name="action"/>
                <field name="priority"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_f3d_genset_event_map_form" model="ir.ui.view">
        <field name="name">f3d.genset.event.map.form</field>
        <field name="model">f3d.genset.event.map</field>
        <field name="arch" type="xml">
            <form string="Подія → ТО">
                <sheet>
                    <group>
                        <group>
                            <field name="key"/>
                            <field name="sequence"/>
                            <field name="hgm_name"/>
                            <field name="hgm_table"/>
                            <field name="severity"/>
                            <field name="td_code"/>
                        </group>
                        <group>
                            <field name="action"/>
                            <field name="priority"/>
                            <field name="active"/>
                            <field name="match_regex"/>
                        </group>
                    </group>
                    <group>
                        <field name="name_tpl"/>
                        <field name="description_tpl"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_f3d_genset_event_map_search" model="ir.ui.view">
        <field name="name">f3d.genset.event.map.search</field>
        <field name="model">f3d.genset.event.map</field>
        <field name="arch" type="xml">
            <search string="Події → ТО">
                <field name="key"/>
                <field name="hgm_name"/>
                <field name="td_code"/>
                <filter name="filter_request" string="Заявка ТО" domain="[('action', 'like', 'request_%')]"/>
                <filter name="filter_shutdown" string="Аварійні" domain="[('severity', '=', 'shutdown')]"/>
                <group>
                    <filter name="group_severity" string="Серйозність" context="{'group_by': 'severity'}"/>
                    <filter name="group_action" string="Дія" context="{'group_by': 'action'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_f3d_genset_event_map" model="ir.actions.act_window">
        <field name="name">Події → ТО</field>
        <field name="res_model">f3d.genset.event.map</field>
        <field name="view_mode">list,form</field>
        <field name="context">{"search_default_group_severity": 1}</field>
    </record>
</odoo>
