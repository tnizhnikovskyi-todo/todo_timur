<?xml version="1.0" encoding="utf-8"?>
<!-- SPEC §6. -->
<odoo noupdate="1">
    <record id="cron_td_genset_publish" model="ir.cron">
        <field name="name">Генератор: публікація показань у телеметрію</field>
        <field name="model_id" ref="model_td_genset_link"/>
        <field name="state">code</field>
        <field name="code">model._cron_publish()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="priority">5</field>
        <field name="active" eval="True"/>
    </record>
    <record id="cron_td_genset_events" model="ir.cron">
        <field name="name">Генератор: події контролера → заявки ТО</field>
        <field name="model_id" ref="model_td_genset_link"/>
        <field name="state">code</field>
        <field name="code">model._cron_events()</field>
        <field name="interval_number">2</field>
        <field name="interval_type">minutes</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="priority">5</field>
        <field name="active" eval="False"/>
    </record>
    <record id="cron_td_genset_service" model="ir.cron">
        <field name="name">Генератор: ТО за мотогодинами</field>
        <field name="model_id" ref="model_td_genset_link"/>
        <field name="state">code</field>
        <field name="code">model._cron_service()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="priority">5</field>
        <field name="active" eval="False"/>
    </record>
</odoo>
