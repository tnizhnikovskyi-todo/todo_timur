<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_td_viewer_snapshot_company" model="ir.rule">
        <field name="name">3D Завод: знімки своєї компанії</field>
        <field name="model_id" ref="model_td_viewer_snapshot"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_td_viewer_event_read_all" model="ir.rule">
        <field name="name">3D Завод: події (лише коди, без даних)</field>
        <field name="model_id" ref="model_td_viewer_event"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('base.group_user'))]"/>
    </record>
    <record id="privilege_td_viewer" model="res.groups.privilege">
        <field name="name">3D Завод: переглядач</field>
        <field name="category_id" ref="td_factory3d.module_category_factory3d"/>
        <field name="sequence">10</field>
    </record>
    <record id="group_td_kiosk" model="res.groups">
        <field name="name">3D Завод: кіоск</field>
        <field name="privilege_id" ref="privilege_td_viewer"/>
        <field name="sequence">10</field>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user')),
                                         Command.link(ref('td_factory3d.group_td_user')),
                                         Command.link(ref('stock.group_stock_user')),
                                         Command.link(ref('mrp.group_mrp_user'))]"/>
    </record>
    <!-- Читання обладнання й заявок з кодом сцени для користувачів переглядача (M-01e); лише read -->
    <record id="rule_td_viewer_equipment_read" model="ir.rule">
        <field name="name">3D Завод: обладнання з кодом сцени (читання)</field>
        <field name="model_id" ref="maintenance.model_maintenance_equipment"/>
        <field name="domain_force">[('td_code', '!=', False)]</field>
        <field name="groups" eval="[Command.link(ref('td_factory3d.group_td_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_td_viewer_request_read" model="ir.rule">
        <field name="name">3D Завод: заявки на обладнання з кодом сцени (читання)</field>
        <field name="model_id" ref="maintenance.model_maintenance_request"/>
        <field name="domain_force">[('equipment_id.td_code', '!=', False)]</field>
        <field name="groups" eval="[Command.link(ref('td_factory3d.group_td_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
