<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Без пароля: інтерактивний вхід неможливий. -->
    <record id="user_kiosk" model="res.users">
        <field name="login">f3d_kiosk</field>
        <field name="name">Екран цеху (3D)</field>
        <field name="group_ids" eval="[Command.set([ref('group_f3d_kiosk')])]"/>
        <field name="notification_type">inbox</field>
        <field name="action_id" ref="action_f3d_viewer"/>
        <field name="share" eval="False"/>
        <field name="active" eval="True"/>
    </record>
</odoo>
