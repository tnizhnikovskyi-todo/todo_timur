<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_f3d_cycle_check_form" model="ir.ui.view">
        <field name="name">f3d.viewer.cycle.check.form</field>
        <field name="model">f3d.viewer.cycle.check</field>
        <field name="arch" type="xml">
            <form string="Перевірка циклу">
                <sheet>
                    <field name="first_ref" invisible="1"/>
                    <group>
                        <group>
                            <field name="payload_user_id" groups="factory3d_base.group_f3d_admin"/>
                            <field name="ran_at"/>
                        </group>
                        <group>
                            <field name="issue_count"/>
                            <field name="state" widget="badge"
                                   decoration-success="state == 'ok'" decoration-danger="state == 'issues'"/>
                        </group>
                    </group>
                    <field name="result_html" widget="html" readonly="1" nolabel="1"/>
                </sheet>
                <footer>
                    <button name="action_run" type="object" string="Запустити" class="btn-primary"/>
                    <button name="action_show_first" type="object" string="Показати в 3D"
                            invisible="state != 'issues'"/>
                    <button string="Закрити" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_f3d_cycle_check" model="ir.actions.act_window">
        <field name="name">Перевірка циклу</field>
        <field name="res_model">f3d.viewer.cycle.check</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
