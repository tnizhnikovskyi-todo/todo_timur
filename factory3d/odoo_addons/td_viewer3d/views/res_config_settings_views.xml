<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_td_viewer" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.td.viewer</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="41"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="3D Завод" string="3D Завод" name="td_viewer3d"
                     groups="td_factory3d.group_td_admin">
                    <block title="Журнал станів" name="f3d_viewer_journal">
                        <setting string="Період знімків" help="Хвилини між плановими знімками (5…60)">
                            <field name="td_snapshot_minutes"/>
                        </setting>
                        <setting string="Вікно знімків" help="HH:MM-HH:MM за Києвом; порожньо — цілодобово">
                            <field name="td_snapshot_hours"/>
                        </setting>
                        <setting string="Зберігання знімків" help="Днів; знімок установки не видаляється">
                            <field name="td_snapshot_keep_days"/>
                        </setting>
                        <setting string="Зберігання подій" help="Годин, за які дельта обчислюється з подій">
                            <field name="td_event_keep_hours"/>
                        </setting>
                    </block>
                    <block title="Живі оновлення" name="f3d_viewer_bus">
                        <setting string="Шина оновлень" help="Повідомлення переглядачам про зміни стану">
                            <field name="td_bus_enabled"/>
                        </setting>
                        <setting string="Затримка оновлень, мс">
                            <field name="td_delta_debounce_ms"/>
                        </setting>
                    </block>
                    <block title="Кіоск" name="f3d_viewer_kiosk">
                        <setting string="Кіоск" help="Екрани цеху за токеном">
                            <field name="td_kiosk_enabled"/>
                            <div class="content-group mt8">
                                <label for="td_kiosk_refresh_s"/> <field name="td_kiosk_refresh_s"/>
                            </div>
                            <div class="content-group mt8">
                                <field name="td_kiosk_url" widget="CopyClipboardChar" readonly="1"/>
                            </div>
                            <div class="mt8">
                                <button name="action_td_new_kiosk_token" type="object" class="btn-link"
                                        string="Новий токен кіоска"
                                        confirm="Старі адреси кіосків перестануть працювати. Продовжити?"/>
                            </div>
                        </setting>
                    </block>
                    <block title="Екран планірки («стіна»)" name="f3d_viewer_wall">
                        <setting string="Слайди й тривалість" help="Екран на телевізор: адреса кіоска з ?wall=1, слайди змінюються самі">
                            <div class="content-group">
                                <label for="td_wall_slide_s"/> <field name="td_wall_slide_s"/>
                            </div>
                            <div class="content-group mt8">
                                <label for="td_wall_slides"/> <field name="td_wall_slides"/>
                            </div>
                            <div class="content-group mt8">
                                <field name="td_wall_url" widget="CopyClipboardChar" readonly="1"/>
                            </div>
                        </setting>
                    </block>
                    <block title="Планшети" name="f3d_viewer_lite">
                        <setting string="Спрощений режим" help="Для слабких пристроїв">
                            <field name="td_lite_default"/>
                        </setting>
                    </block>
                    <block title="Демо" name="f3d_viewer_demo">
                        <setting string="Демо-режим" help="Лише для тестового сервера">
                            <field name="td_demo_enabled"/>
                            <div class="content-group mt8">
                                <label for="td_demo_clock"/> <field name="td_demo_clock"/>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_td_config_settings" model="ir.actions.act_window">
        <field name="name">Налаштування переглядача</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{"module": "td_viewer3d"}</field>
    </record>
</odoo>
