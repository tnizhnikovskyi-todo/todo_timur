<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- V-20: звіт «Перевірка евакуації та розстановки» -->
    <record id="report_f3d_fire_evac_compliance" model="ir.actions.report">
        <field name="name">Перевірка евакуації та розстановки</field>
        <field name="model">f3d.fire.panel</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">factory3d_fire_safety.report_f3d_fire_evac_compliance_document</field>
        <field name="report_file">factory3d_fire_safety.report_f3d_fire_evac_compliance_document</field>
        <field name="print_report_name">'Перевірка евакуації та розстановки — %s' % object.code</field>
    </record>

    <!-- пункт меню «Звіт перевірки»: _f3d_print_evac_report() на панелі (W1) перераховує норми, якщо потрібно -->
    <record id="action_f3d_fire_evac_report" model="ir.actions.server">
        <field name="name">Звіт перевірки евакуації</field>
        <field name="model_id" ref="model_f3d_fire_panel"/>
        <field name="state">code</field>
        <field name="code">action = env['f3d.fire.panel'].search([], limit=1)._f3d_print_evac_report()</field>
    </record>
</odoo>
