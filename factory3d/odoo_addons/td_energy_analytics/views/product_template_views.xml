<?xml version="1.0" encoding="utf-8"?>
<!-- V-10: група «Енергетика» у формі продукту — площа плити для драйвера `plate_m2` (R-03). -->
<odoo>
    <record id="view_product_template_form_energy" model="ir.ui.view">
        <field name="name">product.template.form.energy</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_information']" position="inside">
                <group name="td_energy" string="Енергетика">
                    <field name="td_plate_area_m2"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
