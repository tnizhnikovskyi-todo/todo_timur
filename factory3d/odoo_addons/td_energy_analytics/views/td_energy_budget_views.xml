<?xml version="1.0" encoding="utf-8"?>
<!-- W4-B: V-07 бюджет енергії (суми — лише group_td_energy_cost), V-08 добові факти (лише читання). -->
<odoo>
    <record id="view_td_energy_budget_list" model="ir.ui.view">
        <field name="name">td.energy.budget.list</field>
        <field name="model">td.energy.budget</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'approved'">
                <field name="month"/>
                <field name="resource_id"/>
                <field name="amount_uah" sum="Разом" groups="td_energy.group_td_energy_cost"/>
                <field name="state" widget="badge" decoration-success="state == 'approved'"
                       decoration-info="state == 'draft'"/>
            </list>
        </field>
    </record>

    <record id="view_td_energy_budget_form" model="ir.ui.view">
        <field name="name">td.energy.budget.form</field>
        <field name="model">td.energy.budget</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_approve" type="object" string="Затвердити" class="btn-primary"
                            invisible="state != 'draft'" groups="td_energy.group_td_energy_chief"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,approved"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="month"/>
                            <field name="resource_id"/>
                            <field name="amount_uah" groups="td_energy.group_td_energy_cost"/>
                            <field name="amount_qty"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="approved_by"/>
                            <field name="approved_at"/>
                            <field name="note"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_td_energy_budget" model="ir.actions.act_window">
        <field name="name">Бюджет енергії</field>
        <field name="res_model">td.energy.budget</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- V-08: добові факти -->
    <record id="view_td_energy_daily_list" model="ir.ui.view">
        <field name="name">td.energy.daily.list</field>
        <field name="model">td.energy.daily</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false" decoration-warning="quality == 'partial'">
                <field name="day"/>
                <field name="scope"/>
                <field name="resource_id"/>
                <field name="node_id"/>
                <field name="area_id"/>
                <field name="qty"/>
                <field name="cost" groups="td_energy.group_td_energy_cost"/>
                <field name="co2_kg" optional="hide"/>
                <field name="quality" widget="badge" decoration-success="quality == 'ok'"
                       decoration-warning="quality == 'partial'"/>
            </list>
        </field>
    </record>

    <record id="view_td_energy_daily_pivot" model="ir.ui.view">
        <field name="name">td.energy.daily.pivot</field>
        <field name="model">td.energy.daily</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="day" type="row" interval="month"/>
                <field name="scope" type="col"/>
                <field name="qty" type="measure"/>
                <field name="cost" type="measure" groups="td_energy.group_td_energy_cost"/>
            </pivot>
        </field>
    </record>

    <record id="view_td_energy_daily_graph" model="ir.ui.view">
        <field name="name">td.energy.daily.graph</field>
        <field name="model">td.energy.daily</field>
        <field name="arch" type="xml">
            <graph type="bar" stacked="1">
                <field name="day" interval="week"/>
                <field name="scope"/>
                <field name="qty" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_td_energy_daily_search" model="ir.ui.view">
        <field name="name">td.energy.daily.search</field>
        <field name="model">td.energy.daily</field>
        <field name="arch" type="xml">
            <search>
                <field name="resource_id"/>
                <field name="node_id"/>
                <field name="area_id"/>
                <filter name="today" string="Сьогодні" domain="[('is_today', '=', True)]"/>
                <filter name="yesterday" string="Вчора" domain="[('is_yesterday', '=', True)]"/>
                <filter name="last7" string="7 днів" domain="[('is_last_7d', '=', True)]"/>
                <separator/>
                <filter name="scope_plant" string="Завод" domain="[('scope', '=', 'plant')]"/>
                <filter name="scope_node" string="Вузли" domain="[('scope', '=', 'node')]"/>
                <filter name="scope_resource" string="Ресурси" domain="[('scope', '=', 'resource')]"/>
                <separator/>
                <filter name="partial" string="Неповні" domain="[('quality', '=', 'partial')]"/>
                <group>
                    <filter name="group_scope" string="Рівень" context="{'group_by': 'scope'}"/>
                    <filter name="group_day" string="Доба" context="{'group_by': 'day'}"/>
                    <filter name="group_area" string="Ділянка" context="{'group_by': 'area_id'}"/>
                    <filter name="group_resource" string="Ресурс" context="{'group_by': 'resource_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_td_energy_daily" model="ir.actions.act_window">
        <field name="name">Добові факти</field>
        <field name="res_model">td.energy.daily</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="context">{"search_default_scope_plant": 1}</field>
    </record>
</odoo>
