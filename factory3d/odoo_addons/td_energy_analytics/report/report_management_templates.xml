<?xml version="1.0" encoding="utf-8"?>
<!-- QWeb A4 «Звіт для керівництва» (R-18). Без CSS-змінних, grid і зовнішніх ресурсів (wkhtmltopdf); SVG — атрибутами. -->
<odoo>
    <template id="report_td_energy_style">
        <style>
            .o_td_rep { font-size: 11px; line-height: 1.35; color: #111827; }
            .o_td_rep h1 { font-size: 20px; margin: 0 0 2px 0; font-weight: bold; }
            .o_td_rep h2 { font-size: 13px; margin: 14px 0 6px 0; padding-bottom: 3px; color: #714B67; font-weight: bold;
                           border-bottom: 1px solid #714B67; page-break-after: avoid; }
            .o_td_rep .rep_sub { color: #4b5563; }
            .o_td_rep .rep_meta { text-align: right; color: #4b5563; white-space: nowrap; }
            .o_td_rep table.rep { width: 100%; border-collapse: collapse; }
            .o_td_rep table.rep th { text-align: left; font-weight: bold; color: #4b5563; padding: 3px 5px;
                                     border-bottom: 1px solid #9ca3af; }
            .o_td_rep table.rep td { padding: 3px 5px; border-bottom: 1px solid #e5e7eb; vertical-align: top; }
            .o_td_rep table.rep tr { page-break-inside: avoid; }
            .o_td_rep .num { text-align: right; white-space: nowrap; }
            .o_td_rep .total td { font-weight: bold; border-top: 1px solid #9ca3af; }
            .o_td_rep .good { color: #065f46; }
            .o_td_rep .bad { color: #9a3412; font-weight: bold; }
            .o_td_rep .muted { color: #4b5563; }
            .o_td_rep .sw { display: inline-block; width: 9px; height: 9px; margin-right: 5px; }
            .o_td_rep .block { page-break-inside: avoid; margin-bottom: 4px; }
            .o_td_rep .bar { position: relative; height: 10px; background: #e5e7eb; margin: 6px 0; }
            .o_td_rep .bar_fill { position: absolute; left: 0; top: 0; bottom: 0; background: #714B67; }
            .o_td_rep .bar_mark { position: absolute; top: -3px; bottom: -3px; width: 2px; background: #111827; }
            .o_td_rep .legend span { margin-right: 12px; }
            .o_td_rep ul.notes { margin: 0; padding-left: 16px; }
        </style>
    </template>

    <template id="report_management_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="r" t-value="reports[o.id]"/>
                <div class="article o_td_rep o_td_rep_management">
                    <t t-call="td_energy_analytics.report_td_energy_style"/>

                    <!-- 1. Заголовок -->
                    <table class="rep" style="margin-bottom: 4px;">
                        <tr>
                            <td style="border: 0; padding-left: 0;">
                                <h1 t-out="r['title']"/>
                                <div class="rep_sub"><t t-out="r['company']"/> · <t t-out="r['period_text']"/></div>
                                <div class="rep_sub" t-out="r['subtitle']"/>
                            </td>
                            <td class="rep_meta" style="border: 0; padding-right: 0;">
                                <div>Сформовано: <t t-out="r['generated']"/></div>
                                <div>Автор: <t t-out="r['author']"/></div>
                            </td>
                        </tr>
                    </table>

                    <!-- 2. Підсумки періоду -->
                    <div class="block o_td_rep_kpis">
                        <h2>Підсумки періоду</h2>
                        <table class="rep">
                            <thead><tr><th>Показник</th><th class="num">Значення</th><th>Одиниця</th><th>Відхилення / примітка</th></tr></thead>
                            <tbody>
                                <tr t-foreach="r['kpis']" t-as="k" t-att-data-kpi="k['id']">
                                    <td t-out="k['label']"/>
                                    <td class="num"><b t-out="k['value']"/></td>
                                    <td class="muted" t-out="k['unit']"/>
                                    <td t-att-class="k['tone']">
                                        <t t-if="k['tone'] == 'bad'">▲ </t><t t-elif="k['tone'] == 'good'">✓ </t><t t-out="k['note']"/>
                                    </td>
                                </tr>
                                <tr t-if="not r['kpis']"><td colspan="4" class="muted">Немає даних за період.</td></tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- 3. EnPI -->
                    <div class="block o_td_rep_enpi">
                        <h2>EnPI проти бази (ISO 50001)</h2>
                        <div t-if="r['enpi']['chart']">
                            <div class="legend muted">
                                <span><svg width="22" height="8" viewBox="0 0 22 8"><line x1="0" y1="4" x2="22" y2="4" stroke="#714B67" stroke-width="2.5"/></svg> факт, МВт·год на тиждень</span>
                                <span><svg width="22" height="8" viewBox="0 0 22 8"><line x1="0" y1="4" x2="22" y2="4" stroke="#9ca3af" stroke-width="2" stroke-dasharray="5 4"/></svg> очікування за моделлю бази</span>
                            </div>
                            <svg width="520" height="236" viewBox="0 0 440 200">
                                <g t-foreach="r['enpi']['chart']['ticks']" t-as="tk">
                                    <line x1="40" x2="430" t-att-y1="tk['y']" t-att-y2="tk['y']" stroke="#e5e7eb" stroke-width="1"/>
                                    <text x="34" t-att-y="tk['y'] + 4" text-anchor="end" font-size="10.5" fill="#6b7280" t-out="tk['text']"/>
                                </g>
                                <path t-att-d="r['enpi']['chart']['expected']" fill="none" stroke="#9ca3af" stroke-width="2" stroke-dasharray="5 4"/>
                                <path t-att-d="r['enpi']['chart']['actual']" fill="none" stroke="#714B67" stroke-width="2.5"/>
                                <text x="40" y="192" font-size="10.5" fill="#6b7280">12 тижнів тому</text>
                                <text x="430" y="192" text-anchor="end" font-size="10.5" fill="#6b7280">цей тиждень</text>
                            </svg>
                        </div>
                        <div class="o_td_rep_enpi_summary"><b t-out="r['enpi']['summary']"/></div>
                        <table t-if="r['enpi']['model']" class="rep" style="margin-top: 4px;">
                            <tr><td class="muted" style="width: 26%;">Модель бази</td><td t-out="r['enpi']['model']['formula']"/></tr>
                            <tr><td class="muted">R²</td><td t-out="r['enpi']['model']['r2']"/></tr>
                            <tr><td class="muted">Період бази</td><td t-out="r['enpi']['model']['period']"/></tr>
                        </table>
                    </div>

                    <!-- 4. Бюджет енергії (лише з групою вартості) -->
                    <div t-if="r['budget']" class="block o_td_rep_budget">
                        <h2>Бюджет енергії · <t t-out="r['budget']['month']"/></h2>
                        <table class="rep">
                            <thead><tr><th class="num">План, ₴</th><th class="num">Факт, ₴</th><th class="num">Прогноз, ₴</th><th class="num">Факт, % плану</th><th class="num">Прогноз до плану</th></tr></thead>
                            <tbody><tr>
                                <td class="num" t-out="r['budget']['plan']"/>
                                <td class="num" t-out="r['budget']['fact']"/>
                                <td class="num" t-out="r['budget']['forecast']"/>
                                <td class="num"><t t-out="r['budget']['fact_pct']"/> % <span class="muted">(місяця: <t t-out="r['budget']['share_pct']"/> %)</span></td>
                                <td class="num" t-out="r['budget']['delta']"/>
                            </tr></tbody>
                        </table>
                        <div class="bar">
                            <div class="bar_fill" t-attf-style="width: {{r['budget']['bar']}}%;"/>
                            <div class="bar_mark" t-attf-style="left: {{r['budget']['marker']}}%;"/>
                        </div>
                        <div class="muted" t-out="r['budget']['text']"/>
                    </div>

                    <!-- 5. Енергія за ділянками -->
                    <div class="block o_td_rep_areas">
                        <h2>Енергія за ділянками</h2>
                        <div t-if="r['stack']">
                            <div class="legend muted">
                                <span t-foreach="r['stack']['legend']" t-as="a"><i class="sw" t-attf-style="background: {{a['color']}};"/><t t-out="a['name']"/></span>
                            </div>
                            <svg width="700" height="199" viewBox="0 0 880 250">
                                <g t-foreach="r['stack']['ticks']" t-as="tk">
                                    <line x1="56" x2="870" t-att-y1="tk['y']" t-att-y2="tk['y']" stroke="#e5e7eb" stroke-width="1"/>
                                    <text x="48" t-att-y="tk['y'] + 4" text-anchor="end" font-size="12" fill="#6b7280" t-out="tk['text']"/>
                                </g>
                                <rect t-foreach="r['stack']['rects']" t-as="b" t-att-x="b['x']" t-att-y="b['y']" t-att-width="b['w']" t-att-height="b['h']" t-att-fill="b['fill']"/>
                                <text t-foreach="r['stack']['labels']" t-as="l" t-att-x="l['x']" y="247" text-anchor="middle" font-size="12" fill="#6b7280" t-out="l['text']"/>
                            </svg>
                            <div class="muted">Електроенергія за ділянками · <t t-out="r['stack_unit']"/></div>
                        </div>
                        <table t-if="r['areas']" class="rep" style="margin-top: 4px;">
                            <thead><tr>
                                <th t-out="r['areas']['col_name']"/><th class="num">кВт·год</th>
                                <th t-if="r['cost']" class="num">₴</th>
                                <th class="num">Частка</th><th class="num" t-out="r['areas']['col_spec']"/><th class="num">До бази</th>
                            </tr></thead>
                            <tbody>
                                <tr t-foreach="r['areas']['rows']" t-as="row">
                                    <td><i t-if="row['color']" class="sw" t-attf-style="background: {{row['color']}};"/><t t-out="row['name']"/></td>
                                    <td class="num" t-out="row['kwh']"/>
                                    <td t-if="r['cost']" class="num" t-out="row['cost']"/>
                                    <td class="num" t-out="row['share']"/><td class="num" t-out="row['spec']"/><td class="num" t-out="row['delta']"/>
                                </tr>
                                <tr class="total">
                                    <td>Разом</td><td class="num" t-out="r['areas']['total_kwh']"/>
                                    <td t-if="r['cost']" class="num" t-out="r['areas']['total_cost']"/>
                                    <td/><td/><td/>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- 6. Найбільші споживачі -->
                    <div class="block o_td_rep_equipment">
                        <h2>Найбільші споживачі</h2>
                        <table class="rep">
                            <thead><tr>
                                <th>Обладнання</th><th class="num">кВт·год</th>
                                <th t-if="r['cost']" class="num">₴</th>
                                <th class="num" t-out="r['equipment']['col_spec']"/>
                            </tr></thead>
                            <tbody>
                                <tr t-foreach="r['equipment']['rows']" t-as="row">
                                    <td t-out="row['name']"/><td class="num" t-out="row['kwh']"/>
                                    <td t-if="r['cost']" class="num" t-out="row['cost']"/>
                                    <td class="num" t-out="row['spec']"/>
                                </tr>
                                <tr t-if="not r['equipment']['rows']"><td colspan="4" class="muted">Немає даних за період.</td></tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- 7. Резерви економії -->
                    <div class="block o_td_rep_opps">
                        <h2>Резерви економії</h2>
                        <t t-if="r['opps']">
                            <div t-if="r['cost'] and r['opps']['plan_sum'] is not None">
                                У плані: <b><t t-out="r['opps']['plan_sum']"/> ₴/міс</b> з <t t-out="r['opps']['all_sum']"/> ₴/міс
                            </div>
                            <t t-foreach="[('У плані', r['opps']['plan']), ('Інші', r['opps']['other'])]" t-as="grp">
                                <table t-if="grp[1]" class="rep" style="margin-top: 4px;">
                                    <thead><tr>
                                        <th style="width: 40%;"><t t-out="grp[0]"/></th><th>Дія</th>
                                        <th t-if="r['cost']" class="num">₴/міс</th>
                                    </tr></thead>
                                    <tbody>
                                        <tr t-foreach="grp[1]" t-as="item">
                                            <td><b t-out="item['title']"/><div class="muted" t-out="item['text']"/></td>
                                            <td t-out="item['actions']"/>
                                            <td t-if="r['cost']" class="num" t-out="item['save']"/>
                                        </tr>
                                    </tbody>
                                </table>
                            </t>
                            <div t-if="not r['opps']['count']" class="muted">Відкритих резервів немає.</div>
                        </t>
                        <div t-else="" class="muted">Розділ недоступний.</div>
                    </div>

                    <!-- 8. Примітки -->
                    <div t-if="r['notes']" class="block o_td_rep_notes">
                        <h2>Примітки</h2>
                        <ul class="notes"><li t-foreach="r['notes']" t-as="note" t-out="note"/></ul>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
