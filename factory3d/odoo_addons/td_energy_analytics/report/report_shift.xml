<?xml version="1.0" encoding="utf-8"?>
<!-- V-13: «Звіт за зміну» (R-19) і серверна дія для кнопки Пульту (`meta.report_action`, C-02). -->
<odoo>
    <record id="report_td_energy_shift" model="ir.actions.report">
        <field name="name">Звіт за зміну · Енергетика</field>
        <field name="model">td.energy.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">td_energy_analytics.report_shift_document</field>
        <field name="report_file">td_energy_analytics.report_shift_document</field>
        <field name="print_report_name">'Енергетика_зміна_%s' % time.strftime('%Y-%m-%d')</field>
        <field name="paperformat_id" ref="paperformat_td_energy_a4"/>
    </record>

    <record id="action_td_energy_shift_report" model="ir.actions.server">
        <field name="name">Звіт за зміну</field>
        <field name="model_id" ref="model_td_energy_report_wizard"/>
        <field name="state">code</field>
        <field name="code">action = env['td.energy.report.wizard'].create_and_print('shift')</field>
    </record>
</odoo>
