<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- V-08 -->
    <record id="view_td_publish_wizard_form" model="ir.ui.view">
        <field name="name">td.publish.wizard.form</field>
        <field name="model">td.publish.wizard</field>
        <field name="arch" type="xml">
            <form string="Публікація розкладки">
                <field name="state" invisible="1"/>
                <field name="site_id" invisible="1"/>
                <field name="can_publish" invisible="1"/>
                <sheet>
                    <div class="alert alert-danger" role="alert" invisible="n_block == 0">
                        Публікацію заборонено: є зауваження зі статусом «Заборона» (<field name="n_block" readonly="1" class="oe_inline"/>).
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="n_warn == 0 or n_block != 0">
                        Є попередження перевірок: <field name="n_warn" readonly="1" class="oe_inline"/>. Публікацію дозволено.
                    </div>
                    <div class="alert alert-info" role="alert">
                        Буде створено: <field name="n_create" readonly="1" class="oe_inline"/> ·
                        Буде оновлено: <field name="n_update" readonly="1" class="oe_inline"/> ·
                        Пропонуємо архівувати: <field name="n_archive_offer" readonly="1" class="oe_inline"/> ·
                        Без змін: <field name="n_unchanged" readonly="1" class="oe_inline"/>
                    </div>
                    <notebook>
                        <page name="changes" string="Буде створено / оновлено">
                            <field name="change_line_ids" readonly="state == 'done'">
                                <list create="0" delete="0" editable="bottom">
                                    <field name="kind" column_invisible="1"/>
                                    <field name="res_model" readonly="1"/>
                                    <field name="code" readonly="1"/>
                                    <field name="name" readonly="1"/>
                                    <field name="changes" readonly="1"/>
                                    <field name="selected"/>
                                </list>
                            </field>
                        </page>
                        <page name="archive" string="Пропонуємо архівувати (лише пропозиція, нічого не видаляється)">
                            <field name="archive_line_ids" readonly="state == 'done'">
                                <list create="0" delete="0" editable="bottom">
                                    <field name="kind" column_invisible="1"/>
                                    <field name="res_model" readonly="1"/>
                                    <field name="code" readonly="1"/>
                                    <field name="name" readonly="1"/>
                                    <field name="blocked" column_invisible="1"/>
                                    <field name="selected" readonly="blocked"/>
                                    <field name="blocked_reason" readonly="1"/>
                                </list>
                            </field>
                        </page>
                        <page name="issues" string="Зауваження перевірок">
                            <field name="issue_ids" readonly="1">
                                <list>
                                    <field name="severity" decoration-danger="severity == 'block'"
                                           decoration-warning="severity == 'warn'"/>
                                    <field name="check_key"/>
                                    <field name="layer_id"/>
                                    <field name="codes"/>
                                    <field name="message"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <group>
                        <field name="note" readonly="state == 'done'"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm" type="object" string="Підтвердити й опублікувати"
                            class="btn-primary" invisible="not can_publish"/>
                    <button string="Скасувати" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
