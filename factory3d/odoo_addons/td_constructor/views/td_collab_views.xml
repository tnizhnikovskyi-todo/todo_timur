<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- S6 (волна 2): варіанти планування, коментарі, блокування зон; скелет W0-B -->
    <record id="view_td_layout_variant_list" model="ir.ui.view">
        <field name="name">td.layout.variant.list</field>
        <field name="model">td.layout.variant</field>
        <field name="arch" type="xml">
            <list string="Варіанти планування">
                <field name="site_id"/>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="base_version_id"/>
                <field name="is_training"/>
            </list>
        </field>
    </record>
    <record id="view_td_layout_variant_form" model="ir.ui.view">
        <field name="name">td.layout.variant.form</field>
        <field name="model">td.layout.variant</field>
        <field name="arch" type="xml">
            <form string="Варіант планування">
                <sheet>
                    <group>
                        <field name="site_id"/>
                        <field name="name"/>
                        <field name="base_version_id"/>
                        <field name="snapshot_id"/>
                        <field name="is_training"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_td_layout_variant" model="ir.actions.act_window">
        <field name="name">Варіанти планування</field>
        <field name="res_model">td.layout.variant</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_td_comment_list" model="ir.ui.view">
        <field name="name">td.comment.list</field>
        <field name="model">td.comment</field>
        <field name="arch" type="xml">
            <list string="Коментарі">
                <field name="site_id"/>
                <field name="kind"/>
                <field name="state"/>
                <field name="target_kind"/>
                <field name="target_label"/>
                <field name="text"/>
                <field name="author_id"/>
            </list>
        </field>
    </record>
    <record id="view_td_comment_form" model="ir.ui.view">
        <field name="name">td.comment.form</field>
        <field name="model">td.comment</field>
        <field name="arch" type="xml">
            <form string="Коментар">
                <sheet>
                    <group>
                        <group>
                            <field name="site_id"/>
                            <field name="kind"/>
                            <field name="state"/>
                            <field name="author_id"/>
                        </group>
                        <group>
                            <field name="target_kind"/>
                            <field name="target_uid"/>
                            <field name="target_label"/>
                            <field name="resolved_by_id"/>
                            <field name="resolved_at"/>
                        </group>
                    </group>
                    <field name="text" placeholder="Текст"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_td_comment" model="ir.actions.act_window">
        <field name="name">Коментарі конструктора</field>
        <field name="res_model">td.comment</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_td_zone_lock_list" model="ir.ui.view">
        <field name="name">td.zone.lock.list</field>
        <field name="model">td.zone.lock</field>
        <field name="arch" type="xml">
            <list string="Блокування зон" create="0">
                <field name="site_id"/>
                <field name="zone_uid"/>
                <field name="user_id"/>
                <field name="expires_at"/>
            </list>
        </field>
    </record>
    <record id="action_td_zone_lock" model="ir.actions.act_window">
        <field name="name">Блокування зон</field>
        <field name="res_model">td.zone.lock</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
