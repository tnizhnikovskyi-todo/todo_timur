<?xml version="1.0" encoding="utf-8"?>
<!-- Власник: W4. Каркас W0: майстер «Надходження палива». XML id дії (зберегти!): action_td_genset_fuel_receipt_wizard. -->
<odoo>
    <record id="view_td_genset_fuel_receipt_wizard_form" model="ir.ui.view">
        <field name="name">td.genset.fuel.receipt.wizard.form</field>
        <field name="model">td.genset.fuel.receipt.wizard</field>
        <field name="arch" type="xml">
            <form string="Надходження палива">
                <group>
                    <field name="mode" widget="radio"/>
                    <field name="canister_qty" invisible="mode != 'new'"/>
                    <field name="canister_volume_l" invisible="mode != 'new'"/>
                    <field name="location_id" invisible="mode != 'new'" required="mode == 'new'"/>
                    <field name="canister_ids" widget="many2many_tags" invisible="mode != 'fill'"/>
                    <field name="price_unit"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="partner_id"/>
                    <field name="note"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Записати" class="btn-primary" data-hotkey="q"/>
                    <button string="Скасувати" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_td_genset_fuel_receipt_wizard" model="ir.actions.act_window">
        <field name="name">Надходження палива</field>
        <field name="res_model">td.genset.fuel.receipt.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
