<?xml version="1.0" encoding="utf-8"?>
<!-- Власник: W2. Майстер підтвердження команди пульта (ТР 2.3.13, SPEC 5.14, мокап: діалоги пульта).
     XML id дії (зберегти!): action_td_genset_command_wizard (відкривається td.genset.action_open_command_wizard). -->
<odoo>
    <record id="view_td_genset_command_wizard_form" model="ir.ui.view">
        <field name="name">td.genset.command.wizard.form</field>
        <field name="model">td.genset.command.wizard</field>
        <field name="arch" type="xml">
            <form string="Підтвердження команди">
                <group>
                    <field name="genset_id" readonly="1"/>
                    <field name="command" readonly="1" force_save="1"/>
                    <field name="test_mode" widget="radio" required="command == 'test'" invisible="command != 'test'"/>
                    <field name="target_breaker_closed" invisible="1"/>
                    <field name="confirm_required" invisible="1"/>
                </group>
                <div class="alert alert-danger" role="alert" invisible="not warning_text or not confirm_required">
                    <field name="warning_text" nolabel="1" class="text-break"/>
                </div>
                <div class="alert alert-info" role="status" invisible="not warning_text or confirm_required">
                    <field name="warning_text" nolabel="1" class="text-break"/>
                </div>
                <footer>
                    <button name="action_confirm" type="object" string="Підтвердити" class="btn-primary"
                            invisible="confirm_required or (command == 'test' and not test_mode)" data-hotkey="q"/>
                    <button name="action_confirm" type="object" string="Підтвердити" class="btn-danger"
                            invisible="not confirm_required or (command == 'test' and not test_mode)" data-hotkey="w"/>
                    <button string="Скасувати" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_td_genset_command_wizard" model="ir.actions.act_window">
        <field name="name">Команда пульта</field>
        <field name="res_model">td.genset.command.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
