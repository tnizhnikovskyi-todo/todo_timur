<?xml version="1.0" encoding="utf-8"?>
<!-- Власник: W3. Розклад і дні-винятки (ТР 2.7, 2.10): редагуються на формі генератора (вкладка «Розклад»). -->
<odoo>
    <record id="view_td_genset_schedule_list" model="ir.ui.view">
        <field name="name">td.genset.schedule.list</field>
        <field name="model">td.genset.schedule</field>
        <field name="arch" type="xml">
            <list string="Розклад" editable="bottom">
                <field name="genset_id"/>
                <field name="dayofweek"/>
                <field name="time_start" widget="float_time"/>
                <field name="time_end" widget="float_time"/>
                <field name="enabled" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_td_genset_schedule_form" model="ir.ui.view">
        <field name="name">td.genset.schedule.form</field>
        <field name="model">td.genset.schedule</field>
        <field name="arch" type="xml">
            <form string="Вікно розкладу">
                <sheet>
                    <group>
                        <field name="genset_id"/>
                        <field name="dayofweek"/>
                        <field name="time_start" widget="float_time"/>
                        <field name="time_end" widget="float_time"/>
                        <field name="enabled" widget="boolean_toggle"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_td_genset_schedule_search" model="ir.ui.view">
        <field name="name">td.genset.schedule.search</field>
        <field name="model">td.genset.schedule</field>
        <field name="arch" type="xml">
            <search string="Розклад">
                <field name="genset_id"/>
                <field name="dayofweek"/>
                <filter name="enabled" string="Увімкнені" domain="[('enabled', '=', True)]"/>
            </search>
        </field>
    </record>

    <record id="view_td_genset_schedule_exception_list" model="ir.ui.view">
        <field name="name">td.genset.schedule.exception.list</field>
        <field name="model">td.genset.schedule.exception</field>
        <field name="arch" type="xml">
            <list string="Дні-винятки" editable="bottom">
                <field name="genset_id"/>
                <field name="date"/>
                <field name="action"/>
                <field name="time_start" widget="float_time" required="action == 'custom'" invisible="action != 'custom'"/>
                <field name="time_end" widget="float_time" required="action == 'custom'" invisible="action != 'custom'"/>
                <field name="note"/>
            </list>
        </field>
    </record>

    <record id="view_td_genset_schedule_exception_form" model="ir.ui.view">
        <field name="name">td.genset.schedule.exception.form</field>
        <field name="model">td.genset.schedule.exception</field>
        <field name="arch" type="xml">
            <form string="День-виняток">
                <sheet>
                    <group>
                        <field name="genset_id"/>
                        <field name="date"/>
                        <field name="action"/>
                        <field name="time_start" widget="float_time" required="action == 'custom'" invisible="action != 'custom'"/>
                        <field name="time_end" widget="float_time" required="action == 'custom'" invisible="action != 'custom'"/>
                        <field name="note"/>
                        <field name="active" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_td_genset_schedule_exception_search" model="ir.ui.view">
        <field name="name">td.genset.schedule.exception.search</field>
        <field name="model">td.genset.schedule.exception</field>
        <field name="arch" type="xml">
            <search string="Дні-винятки">
                <field name="genset_id"/>
                <field name="date"/>
                <filter name="archived" string="Архів" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>
</odoo>
