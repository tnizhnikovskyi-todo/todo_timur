<?xml version="1.0" encoding="utf-8"?>
<!-- Власник: W3. Журнал команд (ТР 2.6.3, 2.10; колонки мокапа). XML id дії (контракт): action_td_genset_command. -->
<odoo>
    <record id="view_td_genset_command_list" model="ir.ui.view">
        <field name="name">td.genset.command.list</field>
        <field name="model">td.genset.command</field>
        <field name="arch" type="xml">
            <list string="Журнал команд" create="0" edit="0" delete="0">
                <field name="create_date" string="Час"/>
                <field name="name" optional="hide"/>
                <field name="genset_id" optional="hide"/>
                <field name="user_id" string="Хто"/>
                <field name="source" string="Джерело"/>
                <field name="command" string="Команда"/>
                <field name="state" string="Результат" widget="badge" decoration-success="state in ('done', 'done_late')"
                       decoration-danger="state in ('failed', 'auth_error', 'blocked', 'disabled_relay', 'disabled_odoo')"
                       decoration-warning="state in ('retry', 'waiting_link', 'awaiting', 'sent', 'to_send', 'queued_odoo')"
                       decoration-muted="state in ('not_needed', 'skipped', 'cancelled')"/>
                <field name="attempt" optional="hide"/>
                <field name="max_attempts" optional="hide"/>
                <field name="result_note"/>
            </list>
        </field>
    </record>

    <record id="view_td_genset_command_form" model="ir.ui.view">
        <field name="name">td.genset.command.form</field>
        <field name="model">td.genset.command</field>
        <field name="arch" type="xml">
            <form string="Команда" create="0" edit="0" delete="0">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="to_send,sent,awaiting,done"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="genset_id"/>
                            <field name="command"/>
                            <field name="source"/>
                            <field name="user_id"/>
                            <field name="batch_key"/>
                            <field name="sequence"/>
                            <field name="target_breaker_closed"/>
                            <field name="result_note"/>
                        </group>
                        <group>
                            <field name="relay_cmd_id"/>
                            <field name="relay_status"/>
                            <field name="relay_error"/>
                            <field name="attempt"/>
                            <field name="transport_attempt"/>
                            <field name="max_attempts"/>
                            <field name="link_lost_during"/>
                        </group>
                        <group>
                            <field name="first_sent_at"/>
                            <field name="sent_at"/>
                            <field name="done_at"/>
                            <field name="confirmed_at"/>
                            <field name="deadline_at"/>
                            <field name="next_attempt_at"/>
                            <field name="late_transition_at"/>
                        </group>
                        <group>
                            <field name="confirm_reading_id"/>
                            <field name="alarm_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_td_genset_command_search" model="ir.ui.view">
        <field name="name">td.genset.command.search</field>
        <field name="model">td.genset.command</field>
        <field name="arch" type="xml">
            <search string="Команди">
                <field name="genset_id"/>
                <field name="name"/>
                <field name="command"/>
                <filter name="open" string="Незавершені"
                        domain="[('state', 'in', ('queued_odoo', 'to_send', 'sent', 'awaiting', 'retry', 'waiting_link'))]"/>
                <filter name="failed" string="Не підтверджені" domain="[('state', 'in', ('failed', 'auth_error', 'blocked'))]"/>
                <group expand="0" string="Групувати за">
                    <filter name="group_state" string="Стан" context="{'group_by': 'state'}"/>
                    <filter name="group_source" string="Джерело" context="{'group_by': 'source'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_td_genset_command" model="ir.actions.act_window">
        <field name="name">Журнал команд</field>
        <field name="res_model">td.genset.command</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">Команд ще не було</p>
            <p>Команди з'являються після натискання плиток пульта, запуску таймера, тесту або на переходах розкладу.</p>
        </field>
    </record>
</odoo>
