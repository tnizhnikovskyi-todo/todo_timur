<?xml version="1.0" encoding="utf-8"?>
<!-- Власник: W3. «Події» (ТР 2.10, мокап «Події»): list/calendar/graph/form, фільтри за типом,
     «Останні 30 днів» за замовчуванням. XML id дії (контракт): action_td_genset_event. -->
<odoo>
    <record id="view_td_genset_event_list" model="ir.ui.view">
        <field name="name">td.genset.event.list</field>
        <field name="model">td.genset.event</field>
        <field name="arch" type="xml">
            <list string="Події" create="0" delete="0" decoration-warning="is_bad" decoration-bf="is_open">
                <field name="is_bad" column_invisible="1"/>
                <field name="is_open" column_invisible="1"/>
                <field name="event_type" string="Подія" widget="badge" width="190px"
                       decoration-success="event_type == 'run'" decoration-danger="event_type in ('outage', 'alarm')"
                       decoration-info="event_type in ('refuel', 'maintenance')"
                       decoration-warning="event_type in ('drain', 'external_control')"
                       decoration-muted="event_type in ('link', 'gap')"/>
                <field name="genset_id" optional="hide"/>
                <field name="date_start" string="Початок"/>
                <field name="date_end" string="Кінець"/>
                <field name="duration" string="Тривалість" widget="float_time"/>
                <field name="reason" string="Причина / джерело"/>
                <field name="energy_kwh" string="kWh" digits="[16, 1]" optional="show"/>
                <field name="peak_kw" string="Пік, kW" digits="[16, 1]" optional="show"/>
                <field name="fuel_delta_l" string="Паливо, L" digits="[16, 1]" optional="show"/>
                <field name="crank_attempts" optional="hide"/>
                <field name="crank_min_battery_v" optional="hide"/>
                <field name="summary" string="Підсумок"/>
            </list>
        </field>
    </record>

    <record id="view_td_genset_event_form" model="ir.ui.view">
        <field name="name">td.genset.event.form</field>
        <field name="model">td.genset.event</field>
        <field name="arch" type="xml">
            <form string="Подія" create="0" delete="0">
                <sheet>
                    <field name="is_bad" invisible="1"/>
                    <div class="oe_title">
                        <h1><field name="event_type" readonly="1"/></h1>
                        <field name="genset_id" readonly="1"/>
                    </div>
                    <div class="alert alert-warning" role="status" invisible="not is_bad">
                        <field name="summary" readonly="1"/>
                    </div>
                    <group>
                        <group string="Час">
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="duration" widget="float_time"/>
                            <field name="is_open"/>
                            <field name="reason"/>
                            <field name="summary" invisible="is_bad"/>
                        </group>
                        <group string="Показники">
                            <field name="energy_kwh" invisible="event_type != 'run'"/>
                            <field name="peak_kw" invisible="event_type != 'run'"/>
                            <field name="fuel_delta_l" invisible="event_type not in ('run', 'refuel', 'drain')"/>
                            <field name="crank_attempts" invisible="event_type != 'run'"/>
                            <field name="crank_min_battery_v" invisible="event_type != 'run'"/>
                            <field name="time_to_pickup_s" invisible="event_type != 'outage'"/>
                            <field name="outage_kind" invisible="event_type != 'outage'"/>
                            <field name="mode_from" invisible="event_type != 'external_control'"/>
                            <field name="mode_to" invisible="event_type != 'external_control'"/>
                        </group>
                        <group string="Пов'язані записи">
                            <field name="alarm_id" invisible="not alarm_id"/>
                            <field name="command_id" invisible="not command_id"/>
                            <field name="refuel_id" invisible="not refuel_id"/>
                            <field name="reading_start_id"/>
                            <field name="reading_end_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_td_genset_event_calendar" model="ir.ui.view">
        <field name="name">td.genset.event.calendar</field>
        <field name="model">td.genset.event</field>
        <field name="arch" type="xml">
            <calendar string="Події" date_start="date_start" date_stop="date_end" color="event_type" mode="week"
                      create="0" quick_create="0" event_open_popup="1">
                <field name="genset_id"/>
                <field name="reason"/>
                <field name="summary"/>
                <field name="duration" widget="float_time"/>
            </calendar>
        </field>
    </record>

    <record id="view_td_genset_event_graph" model="ir.ui.view">
        <field name="name">td.genset.event.graph</field>
        <field name="model">td.genset.event</field>
        <field name="arch" type="xml">
            <graph string="Події" type="bar" stacked="0" sample="1">
                <field name="date_start" interval="day"/>
                <field name="event_type"/>
                <field name="duration" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_td_genset_event_pivot" model="ir.ui.view">
        <field name="name">td.genset.event.pivot</field>
        <field name="model">td.genset.event</field>
        <field name="arch" type="xml">
            <pivot string="Події" sample="1">
                <field name="date_start" interval="day" type="row"/>
                <field name="event_type" type="col"/>
                <field name="duration" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_td_genset_event_search" model="ir.ui.view">
        <field name="name">td.genset.event.search</field>
        <field name="model">td.genset.event</field>
        <field name="arch" type="xml">
            <search string="Події">
                <field name="genset_id"/>
                <field name="event_type"/>
                <field name="reason"/>
                <field name="summary"/>
                <filter name="type_run" string="Роботи генератора" domain="[('event_type', '=', 'run')]"/>
                <filter name="type_outage" string="Відключення мережі" domain="[('event_type', '=', 'outage')]"/>
                <filter name="type_fuel" string="Паливо" domain="[('event_type', 'in', ('refuel', 'drain'))]"/>
                <filter name="type_alarm" string="Тривоги" domain="[('event_type', '=', 'alarm')]"/>
                <filter name="type_other" string="Зв'язок і керування"
                        domain="[('event_type', 'in', ('link', 'gap', 'external_control', 'maintenance'))]"/>
                <separator/>
                <filter name="last_30_days" string="Останні 30 днів"
                        domain="[('date_start', '&gt;=', datetime.datetime.combine(context_today() - relativedelta(days=30), datetime.time(0, 0, 0)).to_utc().strftime('%Y-%m-%d %H:%M:%S'))]"/>
                <filter name="last_7_days" string="Останні 7 днів"
                        domain="[('date_start', '&gt;=', datetime.datetime.combine(context_today() - relativedelta(days=7), datetime.time(0, 0, 0)).to_utc().strftime('%Y-%m-%d %H:%M:%S'))]"/>
                <filter name="filter_date_start" string="Початок" date="date_start"/>
                <separator/>
                <filter name="open" string="Триває" domain="[('is_open', '=', True)]"/>
                <filter name="bad" string="Увага" domain="[('is_bad', '=', True)]"/>
                <group expand="0" string="Групувати за">
                    <filter name="group_genset" string="Генератор" context="{'group_by': 'genset_id'}"/>
                    <filter name="group_type" string="Тип" context="{'group_by': 'event_type'}"/>
                    <filter name="group_day" string="День" context="{'group_by': 'date_start:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_td_genset_event" model="ir.actions.act_window">
        <field name="name">Події</field>
        <field name="res_model">td.genset.event</field>
        <field name="view_mode">list,calendar,graph,pivot,form</field>
        <field name="search_view_id" ref="view_td_genset_event_search"/>
        <field name="context">{'search_default_last_30_days': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">Подій ще немає</p>
            <p>Події формуються автоматично з показань: пуск і зупинка агрегату, зникнення і повернення мережі, зміна
                рівня палива, тривоги контролера, втрата зв'язку.</p>
        </field>
    </record>
</odoo>
