<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Цепочка прав: применение ⊃ проектирование ⊃ просмотр. Категорий нет: у Odoo 18 и 19 они устроены по-разному. -->
    <record id="group_wh_view" model="res.groups">
        <field name="name">Конструктор: перегляд</field>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
        <field name="comment">Відкривати застосунок «Конструктор складу», дивитися проєкти та версії.</field>
    </record>

    <record id="group_wh_design" model="res.groups">
        <field name="name">Конструктор: проєктування</field>
        <field name="implied_ids" eval="[(4, ref('group_wh_view'))]"/>
        <field name="comment">Створювати та змінювати проєкти, відновлювати версії, блокувати зони.</field>
    </record>

    <record id="group_wh_apply" model="res.groups">
        <field name="name">Конструктор: застосування в Odoo</field>
        <field name="implied_ids" eval="[(4, ref('group_wh_design'))]"/>
        <field name="comment">Застосовувати проєкт до локацій Odoo (саме застосування — окремий етап; зараз лише група).</field>
    </record>

    <!-- Записи проєкту та залежні — лише своєї компанії (або без компанії) -->
    <record id="rule_wh_project_company" model="ir.rule">
        <field name="name">Конструктор: проєкти своєї компанії</field>
        <field name="model_id" ref="model_wh_project"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_wh_project_version_company" model="ir.rule">
        <field name="name">Конструктор: версії проєктів своєї компанії</field>
        <field name="model_id" ref="model_wh_project_version"/>
        <field name="domain_force">['|', ('project_id.company_id', '=', False), ('project_id.company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_wh_zone_lock_company" model="ir.rule">
        <field name="name">Конструктор: блокування зон своєї компанії</field>
        <field name="model_id" ref="model_wh_zone_lock"/>
        <field name="domain_force">['|', ('project_id.company_id', '=', False), ('project_id.company_id', 'in', company_ids)]</field>
    </record>
</odoo>
